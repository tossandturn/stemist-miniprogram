<view class="page {{deviceClass}} account-page">
  <stemist-header eyebrow="STEMIST · ACCOUNT" title="{{mode === 'login' ? '登录 Stemist' : '创建账号'}}" subtitle="Same IELTSist ID · records stay separate" action-text="返回" bind:action="goBack" />
  <view class="account-layout">
    <view class="context-card account-context">
      <view class="context-card-title">一个账号，两个学习空间</view>
      <view class="context-card-text">沿用两个网页产品的 shared account 方向：身份共用，STEM 和 IELTSist 的学习记录按产品边界保存。</view>
      <view class="account-points"><text>✓ AI Coach</text><text>✓ 学习记录</text><text>✓ 短期会话</text></view>
    </view>
    <view class="panel account-form">
      <view class="field-label">用户名</view>
      <input class="input" data-field="username" value="{{username}}" maxlength="80" placeholder="输入已有 IELTSist 用户名" bindinput="onInput" />
      <view class="field-label">密码</view>
      <input class="input" data-field="password" password value="{{password}}" maxlength="128" placeholder="至少 6 个字符" bindinput="onInput" />
      <button class="primary" bindtap="submit" loading="{{loading}}">{{mode === 'login' ? '登录并使用 AI' : '注册并使用 AI'}}</button>
      <button class="secondary" bindtap="toggleMode">{{mode === 'login' ? '没有账号？注册' : '已有账号？登录'}}</button>
      <view wx:if="{{error}}" class="error">{{error}}</view>
    </view>
  </view>
  <view class="notice">登录请求只发送到配置的 Stemist 服务端；客户端不保存模型密钥。正式微信身份接入将在服务端完成 wx.login 换票。</view>
</view>
