<view class="page {{deviceClass}} {{orientation}} account-page">
  <stemist-header title="我的账号" action-text="返回" bind:action="goBack" />
  <app-nav active="account" source="account" is-tablet="{{isTablet}}" />
  <view class="panel account-form">
    <block wx:if="{{user}}"><view class="card-title">{{user.username}}</view><button class="text-button" bindtap="logout">退出登录</button></block>
    <block wx:else>
      <button class="primary wechat-login" bindtap="loginWechat" loading="{{wechatLoading}}" disabled="{{loading || wechatLoading}}">微信一键登录</button>
      <button class="text-button" bindtap="toggleCredentials">{{showCredentials ? '收起账号登录' : '使用 IELTSist 账号'}}</button>
      <block wx:if="{{showCredentials}}">
        <view class="field-label">用户名</view><input class="input" data-field="username" value="{{username}}" maxlength="24" cursor-spacing="24" placeholder="IELTSist 用户名" bindinput="onInput" />
        <view class="field-label">密码</view><input class="input" data-field="password" password value="{{password}}" maxlength="128" cursor-spacing="24" placeholder="请输入密码" bindinput="onInput" />
        <button class="primary" bindtap="submit" loading="{{loading}}" disabled="{{loading || wechatLoading}}">{{mode === 'login' ? '登录' : '注册'}}</button>
        <button class="text-button" bindtap="toggleMode">{{mode === 'login' ? '创建账号' : '返回登录'}}</button>
      </block>
    </block>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <button class="text-button" bindtap="openIeltsAccount">IELTSist 账号与会员</button>
  <button class="text-button" bindtap="openPrivacy">帮助与隐私</button>
</view>
