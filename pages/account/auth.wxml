<view class="page">
  <view class="eyebrow">STEMIST · ACCOUNT</view>
  <view class="title">{{mode === 'login' ? '登录 Stemist' : '创建账号'}}</view>
  <view class="subtitle">账号与 STEM / IELTSist 共用。客户端只保存短期访问令牌，不保存模型密钥。</view>
  <view class="field-label">用户名</view>
  <input class="input" data-field="username" value="{{username}}" maxlength="80" placeholder="输入已有 IELTSist 用户名" bindinput="onInput" />
  <view class="field-label">密码</view>
  <input class="input" data-field="password" password value="{{password}}" maxlength="128" placeholder="至少 6 个字符" bindinput="onInput" />
  <button class="primary" bindtap="submit" loading="{{loading}}">{{mode === 'login' ? '登录并使用 AI' : '注册并使用 AI'}}</button>
  <button class="secondary" bindtap="toggleMode">{{mode === 'login' ? '没有账号？注册' : '已有账号？登录'}}</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="notice">登录请求只发送到配置的 Stemist 服务端；请不要在小程序代码或截图中填写 API Key。</view>
</view>
