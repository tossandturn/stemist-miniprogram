<view class="page {{deviceClass}} {{orientation}} practice-page">
  <stemist-header title="{{activeCategory === 'ielts' ? 'IELTS' : 'A-Level 学科'}}" />
  <app-nav active="practice" source="{{activeCategory}}" route-id="{{routeId}}" stage="{{stage}}" subject-code="{{subjectCode}}" category="{{activeCategory}}" family="{{family}}" is-tablet="{{isTablet}}" />
  <block wx:if="{{activeCategory === 'alevel'}}">
    <view class="route-setup-card">
      <view class="chip-grid stage-options">
        <button wx:for="{{stages}}" wx:key="*this" class="route-chip {{item === stage ? 'active' : ''}}" data-stage="{{item}}" bindtap="chooseStage">{{item}}</button>
      </view>
      <view class="chip-grid subject-options">
        <button wx:for="{{subjects}}" wx:key="code" class="route-chip {{item.code === subjectCode ? 'active' : ''}}" data-code="{{item.code}}" bindtap="chooseSubject">{{item.short}}</button>
      </view>
      <block wx:if="{{routeOptions.length > 1}}">
        <view class="route-label">试卷组合</view>
        <view class="route-list"><button wx:for="{{routeOptions}}" wx:key="routeId" class="route-option {{item.routeId === routeId ? 'active' : ''}}" data-route="{{item.routeId}}" bindtap="chooseRoute">{{item.components}}</button></view>
      </block>
    </view>
    <view class="section-title">开始练习</view>
    <view class="feature-grid">
      <button wx:for="{{stemTools}}" wx:key="id" class="feature-card feature-{{item.tone}}" data-tool="{{item.id}}" bindtap="openStemTool" disabled="{{!routeId}}"><text class="feature-title">{{item.label}}</text><text class="feature-detail">{{item.detail}}</text></button>
    </view>
    <view wx:if="{{inventoryTopics.length}}" class="card topic-preview">
      <view class="context-card-title">当前章节</view>
      <view wx:for="{{inventoryTopics}}" wx:key="id" class="inventory-topic"><text>{{item.code}} {{item.name}}</text><text>{{item.availableQuestionCount === null ? '待更新' : item.availableQuestionCount + ' 题'}}</text></view>
      <button class="text-button" data-tool="topics" bindtap="openStemTool">查看全部章节</button>
    </view>
  </block>
  <block wx:elif="{{activeCategory === 'ielts'}}">
    <block wx:for="{{ieltsGroups}}" wx:for-item="group" wx:key="id">
      <view class="section-title ielts-group-title">{{group.label}}</view>
      <view class="ielts-feature-grid">
        <button wx:for="{{group.features}}" wx:key="id" class="ielts-feature-card tone-{{item.tone}}" data-feature="{{item.id}}" bindtap="openIeltsFeature">
          <view class="ielts-feature-mark" aria-hidden="true"><view class="ielts-feature-mark-inner"></view></view>
          <view class="ielts-feature-copy"><text class="card-title">{{item.title}}</text><text class="card-detail">{{item.detail}}</text></view>
        </button>
      </view>
    </block>
  </block>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
