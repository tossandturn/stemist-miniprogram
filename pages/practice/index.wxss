.route-setup-card{padding:0;}
.chip-grid{display:flex;flex-wrap:wrap;margin:-4px;}
.route-chip{display:flex;align-items:center;justify-content:center;min-height:44px;width:auto;margin:4px;padding:10px 16px;border:1px solid #e1e5ee;border-radius:11px;color:#59637e;background:#fff;font-size:14px;}
.route-chip.active{border-color:#6b4ed1;color:#5434b5;background:#eeebfb;}
.stage-options{margin-bottom:12px;}
.stage-options .route-chip{flex:1;font-weight:700;}
.subject-options{margin-bottom:16px;}
.route-list{display:flex;flex-wrap:wrap;margin:-4px;}
.route-option{width:auto;min-height:44px;margin:4px;padding:10px 14px;border:1px solid #e1e5ee;border-radius:11px;color:#59637e;background:#fff;font-size:14px;}
.route-option.active{border-color:#6b4ed1;color:#5434b5;background:#eeebfb;}
.feature-grid{display:flex;flex-wrap:wrap;margin:-6px;}
.feature-card{width:calc(50% - 12px);min-height:104px;margin:6px;padding:18px;border:1px solid #e4e7f0;border-radius:14px;background:#fff;text-align:left;}
.feature-title, .feature-detail{display:block;}
.feature-title{color:#18213d;font-size:16px;font-weight:700;}
.feature-detail{margin-top:8px;color:#66708a;font-size:12px;line-height:1.5;}
.inventory-topic{display:flex;justify-content:space-between;padding:14px 0;border-bottom:1px solid #edf0f4;color:#59637e;font-size:13px;}
.inventory-topic text:first-child{min-width:0;flex:1;margin-right:12px;}
.inventory-topic text:last-child{flex-shrink:0;}
.ielts-group-title{margin-top:26px;}
.ielts-feature-grid{display:flex;flex-wrap:wrap;margin:-6px;}
.ielts-feature-card{display:flex;align-items:center;width:calc(100% - 12px);min-height:94px;margin:6px;padding:18px;border:1px solid #e4e7f0;border-radius:14px;background:#fff;text-align:left;}
.ielts-feature-mark{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:40px;height:40px;margin-right:16px;border-radius:12px;color:#6b4bcb;background:#eeeafb;}
.ielts-feature-mark-inner{width:17px;height:17px;border:2px solid currentColor;border-radius:4px;}
.ielts-feature-copy{min-width:0;flex:1;}
.ielts-feature-copy text{display:block;}
.ielts-feature-copy .card-title{font-size:17px;font-weight:700;}
.ielts-feature-copy .card-detail{margin-top:6px;color:#66708a;font-size:13px;font-weight:400;}
.tone-reading .ielts-feature-mark, .tone-vocabulary .ielts-feature-mark{color:#15775e;background:#e7f6f0;}
.tone-writing .ielts-feature-mark, .tone-exam .ielts-feature-mark{color:#a65d12;background:#fff1df;}
.tone-speaking .ielts-feature-mark{color:#ad3c69;background:#fff0f5;}
.device-tablet .ielts-feature-card{width:calc(50% - 12px);min-height:116px;}
.device-tablet .feature-card{width:calc(33.333% - 12px);min-height:118px;}
.practice-page .route-chip, .practice-page .route-option{width:auto;min-width:0;margin:4px;}
.practice-page .feature-grid .feature-card{width:calc(50% - 12px);min-width:0;margin:6px;}
.practice-page .ielts-feature-grid .ielts-feature-card{width:calc(100% - 12px);min-width:0;margin:6px;}
.practice-page.device-tablet .ielts-feature-grid .ielts-feature-card{width:calc(50% - 12px);}
.practice-page.device-tablet .feature-grid .feature-card{width:calc(33.333% - 12px);}
.page.practice-page .feature-grid > button.feature-card{width:100%;margin:0;min-height:140px;padding:20px;border-radius:18px;}
.board-heading{display:flex;justify-content:space-between;align-items:center;margin:16px 0 10px;gap:10px;}.board-label{font-size:16px;font-weight:700;}.board-caption{font-size:12px;color:#66708a;}.exam-board-grid{display:flex;gap:8px;margin-bottom:22px;}.exam-board-grid button.exam-board{flex:1;width:auto;min-width:0;margin:0;padding:14px 5px;border:1px solid #e1e5ee;border-radius:14px;background:#fff;line-height:1.4;font-size:17px;font-weight:700;}.exam-board-grid button.active{background:#eeebfb;border-color:#7357e8;color:#5638c3;}.board-detail{display:block;font-size:10px;font-weight:400;margin-top:7px;color:#59637e;line-height:1.5;}.new-board-subjects{display:flex;gap:10px;margin-bottom:16px;}.new-board-subjects button{flex:1;}.practice-page .feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0;}.practice-page .feature-grid .feature-card,.practice-page.device-tablet .feature-grid .feature-card{width:100%;margin:0;min-height:140px;padding:20px;border-radius:18px;}.practice-mark{width:30px;height:30px;border:2px solid #7357e8;border-radius:8px;margin-bottom:16px;box-sizing:border-box;}.mark-papers{border-radius:3px;border-right-width:6px;}.mark-topics{box-shadow:inset 0 -8px #e8e0fc;}.mark-current{border-radius:50%;border-left-color:#b3a2ee;}.mark-exams{border-radius:50%;position:relative;}.mark-exams:after{content:'';position:absolute;left:13px;top:5px;width:7px;height:9px;border-left:2px solid #7357e8;border-bottom:2px solid #7357e8;}.practice-page .feature-detail{font-size:13px;}.device-tablet .board-detail{font-size:12px;}.device-tablet .exam-board{min-height:92px;}
