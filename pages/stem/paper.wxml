<view class="page {{deviceClass}} {{orientation}} native-paper-page"><stemist-header compact="{{true}}" title="{{title}}" action-text="返回" bind:action="back"/><ai-fab wx:if="{{mode !== 'exam-simulation' || submitted}}" source="{{category}}" route-id="{{routeId}}" stage="{{stage}}" subject-code="{{subject}}" category="{{category}}" family="{{family}}"/>
 <view wx:if="{{loading}}" class="loading-state">正在打开试卷…</view><view wx:if="{{error}}" class="error">{{error}}</view>
 <button wx:if="{{!loading && !ready}}" class="secondary" bindtap="load">重新加载</button>
 <block wx:if="{{ready}}"><view class="paper-status"><text>{{mode === 'exam-simulation' ? '计时模拟' : '真题练习'}} · {{elapsed}}</text><text>已保存 {{photoCount}} 题</text></view>
 <view class="paper-native-workspace"><view class="paper-native-source"><text class="paper-native-title">{{title}}</text><text class="paper-native-subtitle">{{stage}}{{maxMarks ? ' · ' + maxMarks + ' 分' : ''}}</text><button class="primary" data-kind="qp" bindtap="openDocument" loading="{{documentBusy}}" disabled="{{documentBusy}}">查看原卷</button><button wx:if="{{hasMarkScheme && (mode !== 'exam-simulation' || submitted)}}" class="secondary" data-kind="ms" bindtap="openDocument">查看参考答案</button><image wx:for="{{sourceImages}}" wx:key="*this" class="paper-source-image" src="{{item}}" mode="widthFix" lazy-load data-index="{{index}}" bindtap="previewQuestion"/><text class="paper-input-help">按试卷题号，逐题拍摄题目和作答。</text></view>
 <view class="paper-native-answer"><view class="paper-number"><button bindtap="previous" disabled="{{questionNumber <= 1}}">−</button><text>第</text><input type="number" value="{{questionNumber}}" bindconfirm="chooseQuestion" bindblur="chooseQuestion"/><text>题</text><button bindtap="next" disabled="{{questionCount && questionNumber >= questionCount}}">+</button></view><button wx:if="{{!submitted}}" class="primary" bindtap="capture">{{photo ? '重拍本题' : '拍摄本题'}}</button><image wx:if="{{photo}}" class="paper-answer-photo" src="{{photo}}" mode="widthFix" bindtap="previewPhoto"/><button wx:if="{{photo && (mode !== 'exam-simulation' || submitted)}}" class="secondary" bindtap="askFeedback" loading="{{busy}}" disabled="{{busy || !canAskFeedback}}">AI 讲解本题</button><text wx:if="{{photo && !canAskFeedback}}" class="paper-input-help">{{sourceStatus || '这道题的批改资料尚未就绪'}}</text><button wx:if="{{photo && !canAskFeedback}}" class="text-button" bindtap="loadSourceContext">重新连接题目资料</button><button wx:if="{{submitted && photo && canAskFeedback}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="markCurrent">AI 批改本题</button><view wx:for="{{markResults}}" wx:key="label" class="paper-mark-result"><text>AI 估分 {{item.label}} · {{item.score}} / {{item.maxScore}}</text><text selectable>{{item.summary}}</text><text>结果需复核</text></view><text wx:if="{{feedback}}" class="paper-feedback" selectable>{{feedback}}</text></view></view>
 <view class="paper-submit-panel"><view class="paper-self-score"><text>自评总分</text><input type="digit" value="{{selfScore}}" bindinput="inputSelfScore" placeholder="选填"/><text wx:if="{{maxMarks}}">/ {{maxMarks}}</text></view><button wx:if="{{!submitted}}" class="primary" bindtap="submitPaper" disabled="{{busy}}">提交试卷</button><text wx:else class="paper-submitted">{{syncStatus || '提交记录已保存'}}</text><button wx:if="{{submitted && !synced}}" class="secondary" bindtap="syncSubmission" disabled="{{busy}}" loading="{{busy}}">同步提交记录</button></view></block>
</view>
