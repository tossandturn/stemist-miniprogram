<view class="page {{deviceClass}} {{orientation}} capture-page">
  <stemist-header title="{{isWriting ? '拍摄作文' : '拍照问一题'}}" action-text="返回" bind:action="goBack" />
  <view wx:if="{{!isWriting}}" class="capture-scope">
    <text>{{subjectLabel}} · {{stage}} · {{selectedComponents}}</text>
    <button class="text-button" bindtap="toggleScope">{{scopeExpanded ? '收起' : '更换'}}</button>
  </view>
  <view wx:if="{{!isWriting && scopeExpanded}}" class="card route-setup">
    <view class="chip-grid"><button wx:for="{{stages}}" wx:key="*this" class="route-chip {{item === stage ? 'active' : ''}}" data-stage="{{item}}" bindtap="chooseStage">{{item}}</button></view>
    <view class="chip-grid"><button wx:for="{{subjects}}" wx:key="code" class="route-chip {{item.code === subjectCode ? 'active' : ''}}" data-code="{{item.code}}" bindtap="chooseSubject">{{item.short}}</button></view>
    <view wx:if="{{routeOptions.length > 1}}" class="chip-grid"><button wx:for="{{routeOptions}}" wx:key="routeId" class="route-chip {{item.routeId === routeId ? 'active' : ''}}" data-route="{{item.routeId}}" bindtap="chooseRoute">{{item.components}}</button></view>
  </view>
  <view class="card camera-card">
    <view class="camera-icon" aria-hidden="true"><view class="camera-lens"></view></view>
    <view class="card-title">{{isWriting ? '拍清手写作文' : '拍清题目和你的答案'}}</view>
    <button data-testid="{{isWriting ? 'writing-capture' : 'stem-capture'}}" class="primary" bindtap="takePhoto" loading="{{busy}}" disabled="{{busy || (!isWriting && !canCapture)}}">打开相机</button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <ai-fab source="{{isWriting ? 'writing' : 'capture'}}" category="{{isWriting ? 'ielts' : category}}" family="{{family}}" route-id="{{routeId}}" stage="{{stage}}" subject-code="{{subjectCode}}" />
</view>
