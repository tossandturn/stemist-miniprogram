.coach-page{padding-top:12px}.legacy-coach-topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.coach-page .route-pill{min-width:0;margin:0;color:#66708a;font-size:13px;line-height:1.5;overflow-wrap:anywhere}.legacy-coach-topbar button{flex-shrink:0;width:auto;min-height:44px;margin:0;padding:10px 8px;background:transparent;color:#5638c3;font-size:14px}.coach-page .evidence-card{min-width:0;margin-top:0;padding:12px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}.coach-page .photo-preview{display:block;width:100%;height:260px;margin:0;border-radius:10px}.empty-evidence{display:flex;align-items:center;justify-content:center;min-height:160px;color:#66708a;font-size:14px;background:#f5f6fb;border-radius:10px}.coach-page .workspace-grid{gap:12px}.coach-page .workspace-grid>coach-panel{min-width:0}@media(min-width:900px){.coach-page.device-tablet.landscape .photo-preview{height:380px}}
