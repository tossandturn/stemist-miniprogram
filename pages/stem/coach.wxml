<view class="page {{deviceClass}} {{orientation}} coach-page">
 <app-nav active="coach" is-tablet="{{isTablet}}" show-ai="{{false}}" category="{{context.category}}" family="{{context.family}}" route-id="{{context.routeId}}" stage="{{context.stage}}" subject-code="{{context.subjectCode}}" />
 <view class="legacy-coach-topbar"><text class="route-pill">{{contextLabel}}</text><button bindtap="retake" disabled="{{loading || syncing}}">重拍</button></view>
 <view class="workspace-grid">
  <view class="context-card evidence-card"><image wx:if="{{imagePath}}" class="photo-preview" src="{{imagePath}}" mode="aspectFit" /><view wx:else class="empty-evidence">请先拍摄题目</view></view>
  <coach-panel id="coach-panel" streamlined="{{true}}" save-task="{{saveTask}}" bind:savetask="chooseSaveTask" effort-scope="{{effortScope}}" reasoning-effort="{{reasoningEffort}}" bind:effort="chooseEffort" academic="{{true}}" message="{{message}}" answer="{{answer}}" source-action="{{sourceAction}}" bind:source="identifySource" bind:source-dismiss="dismissSource" warning="{{warning}}" error="{{error}}" can-retry="{{canRetry}}" auth-required="{{authRequired}}" status="{{coachStatus}}" loading="{{loading}}" progress="{{progress}}" bind:pauseupload="pauseCoachUpload" disabled="{{!imagePath}}" show-help-actions="{{true}}" help-intent="{{helpIntent}}" solution-disabled="{{solutionDisabled}}" submit-label="发送" placeholder="输入问题，或补充图片说明" helper="" bind:input="onMessage" bind:intent="chooseHelpIntent" bind:submit="ask" bind:retry="retry" bind:account="openAccount" />
 </view>
 <view wx:if="{{syncStatus}}" class="status-line"><text>{{syncStatus}}</text></view><button wx:if="{{syncFailed}}" class="text-button" bindtap="retrySync" disabled="{{syncing}}">{{syncing ? '同步中…' : '重新同步学习记录'}}</button>
</view>
