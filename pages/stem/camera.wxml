<view class="page {{deviceClass}} {{orientation}} camera-page">
  <stemist-header compact="{{true}}" title="拍照" action-text="取消" bind:action="cancel" />
  <privacy-consent wx:if="{{permissionAction === 'privacy'}}" contract-name="{{privacyContractName}}" purpose="相机用于拍摄题目或答案；只有点击提交后，照片才会上传分析。" button-text="同意并开启相机" bind:agreed="agreePrivacy" />
  <view wx:if="{{error && permissionAction !== 'privacy'}}" class="error camera-error" role="alert">{{error}}
    <button wx:if="{{permissionAction === 'mini' || permissionAction === 'system'}}" class="secondary camera-settings" bindtap="permissionSettings">{{permissionAction === 'system' ? '去系统设置' : '开启相机权限'}}</button>
  </view>
  <view wx:if="{{!permissionAction}}" class="camera-frame {{!cameraMounted && !initializing ? 'camera-inactive' : ''}}">
    <camera wx:if="{{cameraMounted}}" class="camera-view" data-camera-generation="{{cameraGeneration}}" device-position="back" flash="{{flash}}" bindinitdone="onCameraInitialized" binderror="onCameraError" bindstop="onCameraStopped"></camera>
    <view wx:if="{{!ready}}" class="camera-loading">{{initializing ? '正在打开相机…' : permissionAction ? '等待相机授权' : '相机未启动'}}</view>
    <view wx:if="{{ready}}" class="camera-guides" aria-hidden="true"><view class="guide-corner guide-tl"></view><view class="guide-corner guide-tr"></view><view class="guide-corner guide-bl"></view><view class="guide-corner guide-br"></view></view>
  </view>
  <view class="camera-hint">{{hint}}</view>
  <view wx:if="{{cameraMounted || initializing}}" class="camera-controls">
    <button class="secondary camera-control" bindtap="toggleFlash" disabled="{{busy || !ready}}" aria-label="闪光灯：{{flash === 'auto' ? '自动' : (flash === 'on' ? '开' : '关')}}">闪光：{{flash === 'auto' ? '自动' : (flash === 'on' ? '开' : '关')}}</button>
    <button class="primary camera-shutter" bindtap="takePhoto" loading="{{busy}}" disabled="{{busy || !ready}}">{{busy ? '处理中…' : '拍照'}}</button>
  </view>
  <button wx:if="{{!ready && !initializing && !permissionAction && !identityChanged}}" class="secondary camera-retry" bindtap="beginCamera" disabled="{{busy}}">重新启动相机</button>
  <button wx:if="{{canUseSystemCamera && !permissionAction}}" class="text-button camera-system" bindtap="useSystemCamera" disabled="{{busy}}">使用系统相机</button>
  <ai-fab source="{{coachSource}}" category="{{category}}" family="{{family}}" route-id="{{routeId}}" stage="{{stage}}" subject-code="{{subjectCode}}" />
</view>
