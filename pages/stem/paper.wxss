.paper-status { display:flex;justify-content:space-between;gap:12px;margin:12px 0 16px;color:#66708a;font-size:14px; }.paper-native-workspace { display:grid;gap:16px;grid-template-columns:minmax(0,1fr);align-items:start; }.paper-native-source,.paper-native-answer,.paper-submit-panel { min-width:0;padding:20px;border:1px solid #e4e7f0;border-radius:14px;background:#fff; }.paper-native-title { display:block;font-size:22px;font-weight:700;overflow-wrap:anywhere; }.paper-native-subtitle { display:block;margin:10px 0 20px;color:#66708a;font-size:14px; }.paper-input-help { display:block;font-size:14px;line-height:1.7;color:#66708a;margin-top:18px; }.paper-number { display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:16px; }.paper-number button { width:44px;min-width:44px;height:44px;padding:0;margin:0;font-size:24px;line-height:44px; }.paper-number input { width:52px;height:44px;text-align:center;border:1px solid #e4e7f0;border-radius:8px;font-size:20px; }.paper-answer-photo { width:100%;display:block;margin:16px 0; }.paper-feedback { display:block;white-space:pre-wrap;font-size:16px;line-height:1.7;margin-top:16px; }.paper-submit-panel { margin-top:16px; }.paper-self-score { display:flex;align-items:center;gap:12px;margin-bottom:14px;font-size:14px; }.paper-self-score input { width:80px;height:44px;border:1px solid #e4e7f0;border-radius:8px;padding:8px; }.paper-submitted { display:block;color:#0f8668;font-size:15px; }.device-tablet.landscape .paper-native-workspace { grid-template-columns:minmax(260px,1fr) minmax(0,1.4fr); }@media(max-width:700px){.device-tablet.landscape .paper-native-workspace{grid-template-columns:minmax(0,1fr);}}
.paper-source-image { display:block;width:100%;margin:12px 0; }.paper-mark-result { display:flex;flex-direction:column;gap:10px;padding:14px 0;border-top:1px solid #e4e7f0;font-size:15px;line-height:1.6; }.paper-mark-result>text:last-child { color:#865f1e;font-size:12px; }
.paper-sticky-head { position:sticky;top:0;z-index:20;min-height:78px;margin:-20px -16px 0;padding:20px 16px 0;background:#f5f6fb;border-bottom:1px solid #e4e7f0; }
.device-tablet .paper-sticky-head { margin:-28px -40px 0;padding:28px 40px 0;min-height:86px; }
.device-tablet.portrait .paper-sticky-head { margin-left:-24px;margin-right:-24px;padding-left:24px;padding-right:24px; }
