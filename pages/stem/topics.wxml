<view class="page {{deviceClass}} {{orientation}} topics-page">
  <stemist-header title="章节练习" subtitle="{{title}}" />
  <app-nav active="practice" source="practice" category="alevel" family="exam" route-id="{{routeId}}" stage="{{stage}}" subject-code="{{subjectCode}}" is-tablet="{{isTablet}}" />
  <button wx:if="{{recentId}}" class="resume-button" bindtap="resume" disabled="{{busy}}">{{recentLabel}} <text>›</text></button>
  <view wx:if="{{loading}}" class="empty-state">正在加载章节…</view>
  <view wx:elif="{{inventoryFailed && !topics.length}}" class="empty-state chapter-load-error" role="alert"><text>{{error}}</text><button wx:if="{{routeId}}" class="secondary" bindtap="refresh">重新加载章节</button></view>
  <view wx:else class="builder-layout">
    <view class="topic-section">
      <view class="builder-heading"><text>选择章节</text><text class="subtle">已选 {{selected.length}}</text></view>
      <view class="topic-list">
        <button wx:for="{{topics}}" wx:key="id" class="topic-choice {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleTopic" disabled="{{busy || (studyMode === 'chapter-study' && !item.startable)}}" aria-label="{{item.name}}，{{item.count}}题，{{studyMode === 'chapter-study' ? item.sourceLabel : ''}}，{{item.selected ? '已选' : '未选'}}">
          <view class="choice-mark">{{item.selected ? '✓' : ''}}</view>
          <view class="choice-copy"><text class="topic-name">{{item.code}} {{item.name}}</text><text class="topic-count">{{item.count}} 题</text><text wx:if="{{studyMode === 'chapter-study'}}" class="source-kind {{item.sourceLabel === '原创基础练习' ? 'original' : ''}}">{{item.sourceLabel}}</text></view>
        </button>
      </view>
      <view wx:if="{{!topics.length && !error}}" class="empty-state">这条路线的章节题目正在整理。</view>
    </view>
    <view class="set-options">
      <view class="builder-heading">设置练习</view>
      <view class="option-label">学习方式</view>
      <view class="option-row study-mode-row"><button class="option-chip {{studyMode !== 'chapter-study' ? 'selected' : ''}}" data-mode="" bindtap="chooseStudyMode" disabled="{{busy}}" aria-pressed="{{studyMode !== 'chapter-study'}}">真题章节练习</button><button wx:if="{{chapterStudyAvailable}}" class="option-chip {{studyMode === 'chapter-study' ? 'selected' : ''}}" data-mode="chapter-study" bindtap="chooseStudyMode" disabled="{{busy}}" aria-pressed="{{studyMode === 'chapter-study'}}">章节学习</button></view>
      <view class="study-mode-note">{{studyMode === 'chapter-study' ? '每次专注一个章节，真题优先；暂无合格真题时使用明确标注的原创基础练习。结果仅用于学习，不计正式进度或官方成绩。' : '使用具备完整原卷、来源和批改依据的题目；原有正式题库门槛保持不变。'}}</view>
      <view class="option-label">卷型</view>
      <view class="option-row component-shortcuts"><button class="option-chip {{allComponentsSelected ? 'selected' : ''}}" data-value="0" bindtap="onlyComponent" disabled="{{busy}}">全部卷型</button><button wx:for="{{componentOptions}}" wx:key="value" class="option-chip {{item.onlySelected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onlyComponent" disabled="{{busy}}">仅 {{item.label}}</button></view>
      <view wx:if="{{studyMode !== 'chapter-study'}}" class="subtle component-multi-label">也可组合卷型</view>
      <view wx:if="{{studyMode !== 'chapter-study'}}" class="option-row"><button wx:for="{{componentOptions}}" wx:key="value" class="option-chip {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="toggleComponent" disabled="{{busy}}">{{item.label}}</button></view>
      <view class="option-label">题量</view>
      <view class="option-row"><button wx:for="{{counts}}" wx:key="value" class="option-chip {{item.selected ? 'selected' : ''}}" disabled="{{item.disabled || busy}}" data-count="{{item.value}}" bindtap="chooseCount">{{item.value}} 题</button></view>
      <view wx:if="{{selected.length}}" class="availability">{{studyMode === 'chapter-study' ? '本章可用 ' : ''}}{{availableCount}} 道不重复题目</view>
      <view wx:if="{{hint}}" class="subtle selection-hint">{{hint}}</view>
      <button class="primary start-native-practice" loading="{{busy}}" disabled="{{!canStart || busy}}" bindtap="start">{{busy ? '正在组卷…' : (studyMode === 'chapter-study' ? '开始章节学习' : '开始练习')}}</button>
      <view wx:if="{{error}}" class="error">{{error}}</view>
      <button wx:if="{{error}}" class="text-button" bindtap="refresh" disabled="{{busy}}">重新加载章节</button>
    </view>
  </view>
</view>
