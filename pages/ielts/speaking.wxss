.speaking-context { border-left: 6rpx solid #ed6486; }
.speaking-webview { display: block; width: 100%; height: 1050rpx; margin-top: 18rpx; border: 1rpx solid #e4e7f0; border-radius: 18rpx; background: #fff; }
.speaking-state { margin-top: 12rpx; padding: 14rpx 16rpx; border-radius: 12rpx; color: #66708a; background: #eef0f8; font-size: 22rpx; }
.speaking-page .error .secondary { margin-top: 12rpx; }
.full-workspace-link { margin-top: 14rpx; }
@media (min-width: 768px) { .speaking-webview { height: 1320rpx; } }
.speaking-workspace { display:grid;grid-template-columns:minmax(0,1fr);gap:16px; }.speaking-controls,.speaking-dialogue,.speaking-feedback { min-width:0;padding:20px;border:1px solid #e4e7f0;border-radius:16px;background:#fff; }.speaking-title { display:block;font-size:20px;line-height:1.5;font-weight:700; }.speaking-time { display:block;margin:20px 0 12px;font-size:36px;font-variant-numeric:tabular-nums;color:#5638c3; }.speaking-status { display:block;font-size:15px;line-height:1.7;color:#66708a;margin:12px 0 20px; }.speaking-turn { display:flex;flex-direction:column;gap:8px;padding:14px;margin:12px 0;border-radius:12px;font-size:16px;line-height:1.7;background:#f5f6fb; }.candidate-turn { background:#f0ecff; }.turn-role { font-size:12px;font-weight:700;color:#66708a; }.speaking-feedback { margin-top:16px; }.speaking-warning { display:block;margin:12px 0;color:#865f1e;font-size:14px; }.feedback-text { white-space:pre-wrap;font-size:16px;line-height:1.7; }.device-tablet.landscape .speaking-workspace { grid-template-columns:320px minmax(0,1fr);align-items:start; }.device-tablet.landscape .speaking-controls { position:sticky;top:16px; }@media(max-width:700px){.device-tablet.landscape .speaking-workspace{grid-template-columns:minmax(0,1fr);}}
