<view class="page {{deviceClass}} {{orientation}} native-ielts-home"><stemist-header compact="{{true}}" title="{{title}}" action-text="返回" bind:action="back"/><ai-fab source="ielts" category="ielts"/>
 <view wx:if="{{view === 'dashboard'}}"><view class="native-goal"><text>目标分数</text><picker range="{{targets}}" value="{{targetIndex}}" bindchange="chooseTarget"><view class="goal-number">{{target}}<text>更改</text></view></picker><text>近 7 天提交 {{weeklyCount}} 次练习</text></view><view class="native-skill-grid"><button data-module="listening" bindtap="openSkill">Listening</button><button data-module="reading" bindtap="openSkill">Reading</button><button data-module="writing" bindtap="openSkill">Writing</button><button data-module="speaking" bindtap="openSkill">Speaking</button></view></view>
 <view wx:if="{{view !== 'subscription'}}" class="native-records"><view class="records-title">最近练习</view><button wx:for="{{records}}" wx:key="id" class="native-record-row" data-index="{{index}}" bindtap="openRecord"><text>{{item.title}}</text><text>{{item.band !== null ? 'Band ' + item.band : item.selfScore !== '' ? '自评 ' + item.selfScore : '已提交'}}</text></button><view wx:if="{{!records.length}}" class="empty-state">完成练习后，记录会显示在这里</view><button wx:if="{{records.length < total}}" class="secondary" bindtap="more">查看更多</button></view>
 <view wx:else class="native-membership"><view class="records-title">{{membership.active ? '会员已生效' : '会员状态'}}</view><text wx:if="{{membership}}">{{membership.plan}} · {{membership.expiresAt}}</text><button wx:if="{{!user}}" class="primary" bindtap="signIn" loading="{{busy}}">微信登录</button><view class="redemption"><text>激活码</text><input value="{{code}}" bindinput="inputCode" placeholder="输入激活码"/><button class="primary" bindtap="redeem" disabled="{{busy || !code}}">激活</button></view><button class="text-button" bindtap="account">账号设置</button></view>
 <view wx:if="{{status}}" class="native-home-status">{{status}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
</view>
