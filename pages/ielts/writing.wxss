.writing-identity { border-left-color: #f19a3e; }
.task-switcher { display:flex; gap:10px; margin:12px 0; }
.writing-page .task-chip { flex:1; width:auto; min-height:44px; margin:0; padding:8px 14px; border:1px solid #e4e7f0; color:#66708a; background:#fff; font-size:15px; font-weight:700; line-height:26px; }
.writing-page .task-chip[disabled]{background:#f4f5f8;color:#8a91a3;border-color:#e4e7f0}
.task-chip:last-child { margin-right: 0; }
.task-chip.active { border-color: #f19a3e; color: #a95c12; background: #fff4e6; }
.source-guard{display:flex;flex-direction:column;gap:8px;margin:12px 0;padding:14px;border:1px solid #f2c48f;border-radius:12px;background:#fff8ef;color:#67421c;font-size:14px;line-height:1.6}.source-guard-review{border-color:#d8cdfc;background:#f7f4ff;color:#35256f}.source-guard-title,.source-preview-title{display:block;font-size:16px;font-weight:700;color:#18213d}.source-guard-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}.source-guard-actions button{flex:1;min-width:132px;width:auto;min-height:44px;margin:0}.source-preview{margin:12px 0;padding:14px;border:1px solid #d8cdfc;border-radius:12px;background:#fff}.source-preview-title{margin-bottom:10px}.source-archive-note{display:block;margin:8px 0;color:#5638c3;font-size:13px;line-height:1.5}
.photo-button { margin-top: 18rpx; }
.writing-page .photo-preview { display:block;width:100%;height:260px; }
.writing-photo-input { padding:14px;border:1px solid #e4e7f0;border-radius:14px;background:#fff;margin-bottom:12px; }
.writing-editor { margin-top: 12rpx; padding: 0; border: 0; background: transparent; box-shadow: none; }
.prompt-input { min-height: 190rpx !important; }
.writing-page .text-button { display: block; margin: 18rpx auto 0; }
.writing-page .full-workspace-link { margin-top: 14rpx; }
.writing-task-image { display:block;width:100%;margin:12px 0;background:#f5f6fb; }.writing-score { padding:16px;margin-top:16px;border:1px solid #e4e7f0;border-radius:14px;background:#fff; }.writing-score>text { font-size:20px;font-weight:700; }.writing-score>view { display:flex;justify-content:space-between;gap:16px;padding:10px 0;font-size:14px; }
