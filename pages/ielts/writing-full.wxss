.pair-heading{display:flex;justify-content:space-between;gap:12px;font-size:16px;line-height:1.6;margin:16px 0}.pair-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}.pair-task,.pair-result{min-width:0;padding:18px;border:1px solid #e4e7f0;border-radius:14px;background:#fff}.pair-title{display:block;font-size:22px;font-weight:700;margin-bottom:12px}.pair-source{display:block;width:100%;margin-bottom:12px}.pair-prompt{display:block;font-size:15px;line-height:1.6;white-space:pre-wrap;margin:12px 0}.pair-essay{width:100%;height:300px;background:#f8f9fc;border:1px solid #cbd1df;border-radius:10px;padding:12px;font-size:17px;line-height:1.7;margin-bottom:14px;box-sizing:border-box}.pair-photo{display:block;width:100%;height:180px}.pair-footer{display:flex;flex-direction:column;gap:12px;margin:20px 0}.device-tablet.landscape .pair-grid{grid-template-columns:repeat(2,minmax(0,1fr))}@media(max-width:700px){.device-tablet.landscape .pair-grid{grid-template-columns:1fr}}
.writing-full-page .task-switcher{display:flex;gap:10px;margin:12px 0}.writing-full-page .task-switcher button{flex:1;width:auto;min-height:44px;margin:0;padding:8px;font-size:15px;line-height:26px}.writing-full-page .task-switcher .active{background:#fff4e6;color:#a95c12;border:1px solid #f19a3e}.writing-full-page .task-switcher button[disabled]{background:#f4f5f8;color:#8a91a3;border-color:#e4e7f0}.source-guard{display:flex;flex-direction:column;gap:8px;margin:12px 0;padding:14px;border:1px solid #f2c48f;border-radius:12px;background:#fff8ef;color:#67421c;font-size:14px;line-height:1.6}.source-guard-review{border-color:#d8cdfc;background:#f7f4ff;color:#35256f}.source-guard-title,.source-preview-title{display:block;font-size:16px;font-weight:700;color:#18213d}.source-guard-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}.source-guard-actions button{flex:1;min-width:156px;width:auto;min-height:44px;margin:0}.pair-source-preview{margin:12px 0;padding:12px;border:1px solid #d8cdfc;border-radius:12px;background:#f9f7ff}.source-preview-title{margin-bottom:10px}.source-archive-note{display:block;margin:8px 0;color:#5638c3;font-size:13px;line-height:1.5}
