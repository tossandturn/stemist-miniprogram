<view class="page {{deviceClass}} {{orientation}} speaking-page">
  <stemist-header eyebrow="IELTSIST · SPEAKING WITH AI" title="口语" action-text="返回" bind:action="openBack" />
  <app-nav active="practice" source="speaking" category="ielts" is-tablet="{{isTablet}}" />
  <web-view wx:if="{{webviewUrl}}" class="speaking-webview" src="{{webviewUrl}}" bindload="onWebViewLoad" binderror="onWebViewError"></web-view>
  <view wx:if="{{webviewState === 'loading'}}" class="speaking-state">正在打开口语练习…</view>
  <view wx:if="{{webviewState === 'error'}}" class="error">{{webviewError}}<button class="secondary" bindtap="retryWebView">重试</button></view>
</view>
