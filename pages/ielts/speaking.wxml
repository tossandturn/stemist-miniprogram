<view class="page {{deviceClass}} {{orientation}} speaking-page">
 <stemist-header compact="{{true}}" title="Speaking" action-text="返回" bind:action="openBack"/><ai-fab wx:if="{{!examMode}}" source="speaking" category="ielts"/>
 <view class="speaking-workspace"><view class="speaking-controls"><text class="speaking-title">{{taskTitle}}</text><text class="speaking-time">{{elapsed}}</text><text class="speaking-status">{{status || '找一个安静的地方，自然回答考官的问题。'}}</text><button wx:if="{{!active}}" class="primary" loading="{{connecting}}" disabled="{{connecting || scoring}}" bindtap="start">{{turnCount ? '继续口语练习' : '开始口语练习'}}</button><button wx:else class="secondary" bindtap="finish" disabled="{{scoring}}">结束并查看反馈</button><button class="text-button" bindtap="selectTask" disabled="{{active || scoring}}">更换话题</button><view wx:if="{{error}}" class="error">{{error}}</view></view>
 <view class="speaking-dialogue"><button wx:if="{{turnCount > turns.length}}" class="text-button" bindtap="showEarlier">查看更早对话</button><view wx:for="{{turns}}" wx:key="at" class="speaking-turn {{item.role === 'user' ? 'candidate-turn' : 'examiner-turn'}}"><text class="turn-role">{{item.role === 'user' ? '你' : '考官'}}</text><text selectable>{{item.text}}</text></view><view wx:if="{{!turnCount}}" class="empty-state">对话将在这里显示</view></view></view>
 <view wx:if="{{scoring}}" class="loading-state">正在生成口语反馈…</view><view wx:if="{{feedback}}" class="speaking-feedback"><text wx:if="{{band !== null}}" class="speaking-title">AI 估分 · Band {{band}}</text><text class="speaking-warning">{{warning}}</text><text selectable class="feedback-text">{{feedback}}</text></view><button wx:if="{{canRetry}}" class="secondary" bindtap="retry">重试</button><button wx:if="{{turnCount && !active}}" class="text-button" bindtap="exportTranscript">导出对话记录</button>
</view>
