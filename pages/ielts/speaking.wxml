<view class="page {{deviceClass}} {{orientation}} speaking-page">
 <stemist-header compact="{{true}}" title="Speaking" action-text="返回" bind:action="openBack"/><ai-fab wx:if="{{!examMode}}" source="speaking" category="ielts"/>
 <view class="speaking-workspace"><view class="speaking-controls"><text class="speaking-title">{{taskTitle}}</text><text class="speaking-time">{{elapsed}}</text><text class="speaking-status">{{status || '找一个安静的地方。首次开始时，请允许使用麦克风。'}}</text>
 <button wx:if="{{viewingArchive}}" class="secondary" bindtap="returnToPractice">返回练习</button>
 <button wx:elif="{{!active}}" class="primary speaking-start" loading="{{connecting || taskLoading}}" disabled="{{connecting || scoring || taskLoading}}" bindtap="start">{{feedback ? '开始新练习' : turnCount ? '继续口语练习' : '开始口语练习'}}</button><button wx:else class="secondary" bindtap="finish" disabled="{{scoring}}">结束并查看反馈</button>
 <button wx:if="{{connecting}}" class="text-button" bindtap="stopSession">取消连接</button><button wx:if="{{!viewingArchive}}" class="text-button" bindtap="selectTask" disabled="{{active || connecting || scoring}}">更换话题</button><button class="text-button" bindtap="showSaved" disabled="{{active || connecting || scoring}}">历史练习</button>
 <view wx:if="{{error}}" class="error" role="alert">{{error}}
  <button wx:if="{{permissionAction === 'mini' || permissionAction === 'system'}}" class="secondary microphone-settings" bindtap="permissionSettings">{{permissionAction === 'system' ? '去系统设置' : '开启麦克风权限'}}</button>
  <privacy-consent wx:if="{{permissionAction === 'privacy'}}" contract-name="{{privacyContractName}}" purpose="麦克风用于口语练习；开始练习后，音频才会发送给 AI 考官。" bind:agreed="agreePrivacy" />
 </view></view>
 <view class="speaking-dialogue"><button wx:if="{{hasEarlier}}" class="text-button" bindtap="showEarlier">更早对话</button><view wx:for="{{turns}}" wx:key="at" class="speaking-turn {{item.role === 'user' ? 'candidate-turn' : 'examiner-turn'}}"><text class="turn-role">{{item.role === 'user' ? '你' : '考官'}}</text><text selectable>{{item.text}}</text></view><button wx:if="{{hasLater}}" class="text-button" bindtap="showLater">较新对话</button><view wx:if="{{!turnCount}}" class="empty-state">对话将在这里显示</view></view></view>
 <view wx:if="{{showHistory}}" class="speaking-history"><view class="speaking-history-title"><text>历史练习</text><button class="text-button" bindtap="closeHistory">收起</button></view><button wx:for="{{historyRows}}" wx:key="sessionId" class="speaking-history-row" data-id="{{item.sessionId}}" bindtap="openSaved"><text>{{item.title}}</text><text>{{item.turnCount}} 条对话{{item.band !== null ? ' · Band ' + item.band : ''}}</text></button><view wx:if="{{!historyRows.length}}" class="empty-state">暂无其他已保存的练习</view><button wx:if="{{historyHasPrevious}}" class="text-button" bindtap="previousHistory">上一页</button><button wx:if="{{historyHasMore}}" class="text-button" bindtap="moreHistory">下一页</button></view>
 <view wx:if="{{scoring}}" class="loading-state">正在生成口语反馈…</view><view wx:if="{{feedback}}" class="speaking-feedback"><text wx:if="{{band !== null}}" class="speaking-title">AI 估分 · Band {{band}}</text><text class="speaking-warning">{{warning}}</text><text selectable class="feedback-text">{{feedback}}</text></view><button wx:if="{{canRetry && !permissionAction && !viewingArchive}}" class="secondary" bindtap="retry">{{retryAction === 'score' ? '重试评分' : '重试连接'}}</button><button wx:if="{{turnCount && !active}}" class="text-button" bindtap="exportTranscript">导出对话记录</button>
</view>
