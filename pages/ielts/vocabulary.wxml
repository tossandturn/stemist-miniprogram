<view class="page {{deviceClass}} {{orientation}} vocabulary-page">
<stemist-header compact="{{true}}" title="Vocabulary" action-text="返回" bind:action="back"/>
<ai-fab source="vocabulary" category="ielts"/>
 <view class="vocab-switch">
<button class="{{bank === 'ielts' ? 'selected' : ''}}" data-bank="ielts" bindtap="switchBank">IELTS</button>
<button class="{{bank === 'stem' ? 'selected' : ''}}" data-bank="stem" bindtap="switchBank">学科词汇</button>
</view>
<view class="vocab-filters">
<input placeholder="搜索词汇" value="{{query}}" bindinput="search"/>
<picker range="{{stages}}" range-key="label" value="{{stageIndex}}" bindchange="chooseStage">
<view>{{stages[stageIndex].label}}</view>
</picker>
<button class="{{reviewOnly ? 'selected' : ''}}" bindtap="toggleReview">待复习</button>
</view>
 <view class="vocab-count">{{total}} 个词条 · 已掌握 {{mastered}}</view>
<view wx:if="{{loading || detailBusy}}" class="loading-state">正在加载…</view>
<view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重试</button>
</view>
 <view wx:if="{{word}}" class="vocab-detail">
<button class="vocab-close" bindtap="closeWord" aria-label="关闭词条">×</button>
<text class="vocab-word">{{word.word}}</text>
<text class="vocab-phonetic">{{word.phonetic}}</text>
<button class="secondary" bindtap="reveal">{{revealed ? '隐藏释义' : '查看释义'}}</button>
<block wx:if="{{revealed}}">
<text class="vocab-meaning">{{word.meaning}}</text>
<text class="vocab-body">{{word.definition}}</text>
<text class="vocab-body">{{word.explanation}}</text>
<text wx:if="{{word.formula}}" class="vocab-body">{{word.formula}}</text>
<text class="vocab-example">{{word.example}}</text>
<text class="vocab-body">{{word.translation}}</text>
<text wx:if="{{word.mistake}}" class="vocab-body">易错点：{{word.mistake}}</text>
</block>
<view class="vocab-review">
<button class="secondary" data-known="no" bindtap="remember">再练一次</button>
<button class="primary" data-known="yes" bindtap="remember">记住了</button>
</view>
<button class="text-button" bindtap="saveWord">收藏词条</button>
<text class="vocab-status">{{status}}</text>
</view>
 <view wx:else class="vocab-grid">
<button wx:for="{{items}}" wx:key="id" class="vocab-row" data-id="{{item.id}}" bindtap="openWord">
<text>{{item.word}}</text>
<text>{{item.meaning}}</text>
</button>
</view>
 <view wx:if="{{!word && pageCount > 1}}" class="vocab-pager">
<button bindtap="previous" disabled="{{page <= 0}}">上一页</button>
<text>{{page+1}} / {{pageCount}}</text>
<button bindtap="next" disabled="{{page+1 >= pageCount}}">下一页</button>
</view>
</view>
