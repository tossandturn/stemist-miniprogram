.native-filters { display:flex;gap:12px;align-items:center;margin:12px 0 16px; }.native-filter { min-height:44px;padding:12px;border:1px solid #e4e7f0;border-radius:10px;background:#fff;font-size:14px;white-space:nowrap; }.native-search { flex:1;min-width:0;height:44px;padding:8px 12px;border:1px solid #e4e7f0;border-radius:10px;background:#fff; }.native-count { margin-bottom:12px;color:#66708a;font-size:13px; }.native-task-grid { display:grid;gap:12px;grid-template-columns:1fr; }.ielts-library button.native-task-card { display:flex;flex-direction:column;align-items:flex-start;gap:8px;width:100%;min-width:0;margin:0;padding:18px;border:1px solid #e4e7f0;border-radius:14px;background:#fff;text-align:left;line-height:1.4; }.task-source { color:#5638c3;font-size:13px; }.task-title { color:#18213d;font-size:19px;font-weight:700; }.task-meta { color:#66708a;font-size:13px; }.task-enter { color:#5638c3;font-size:14px; }.native-pager { display:flex;gap:12px;align-items:center;justify-content:center;margin:20px 0; }.native-pager button { width:auto;min-width:84px;min-height:44px;margin:0;font-size:14px; }.device-tablet .native-task-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }@media(max-width:600px){.device-tablet .native-task-grid{grid-template-columns:1fr;}.native-filters{flex-wrap:wrap;}.native-search{min-width:140px;}}
.native-scopes { display:flex;gap:10px;margin:12px 0; }.native-scopes button { flex:1;min-width:0;min-height:44px;margin:0;padding:8px 12px;font-size:15px;line-height:28px;background:#ede8ff;color:#5638c3; }.native-scopes button.active { background:#7357e8;color:#fff; }
.native-topic-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px; }
.ielts-library button.native-topic-card { display:flex;flex-direction:column;align-items:flex-start;width:100%;min-width:0;margin:0;padding:16px;border:1px solid #e4e7f0;border-radius:14px;background:#fff;text-align:left;line-height:1.4; }
.native-topic-icon { display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin-bottom:12px;border-radius:12px;background:#f0ecff; }
.native-topic-icon image { width:32px;height:32px; }
.native-topic-icon .topic-emoji { font-size:30px;line-height:34px; }
.topic-breadcrumb .topic-emoji { font-size:24px;line-height:28px; }
.topic-label { min-height:42px;color:#18213d;font-size:16px;font-weight:650; }
.topic-count { margin-top:8px;color:#66708a;font-size:13px; }
.topic-breadcrumb { display:flex;align-items:center;gap:10px;margin:8px 0 16px;flex-wrap:wrap;font-size:14px; }
.topic-breadcrumb button { width:auto;min-height:44px;margin:0;padding:8px 12px;color:#5638c3;background:#f0ecff;font-size:14px; }
.topic-breadcrumb image { width:26px;height:26px; }
.device-tablet .native-topic-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
@media(min-width:1000px){.device-tablet .native-topic-grid{grid-template-columns:repeat(4,minmax(0,1fr));}}
