<view class="page {{deviceClass}} {{orientation}} writing-full-page">
<stemist-header compact="{{true}}" title="完整写作" action-text="返回" bind:action="back"/><ai-fab source="writing" category="ielts"/>
<view wx:if="{{sourceReviewRequired}}" class="source-guard source-guard-review"><text class="source-guard-title">完整写作题源已更新</text><text>两篇作文、照片和旧批改记录都已保留。请先查看当前两题，再由你确认是否改用。</text><view class="source-guard-actions"><button class="secondary" bindtap="viewSourceUpdate">{{sourcePreview ? '收起新题' : '查看新题'}}</button><button wx:if="{{sourcePreview}}" class="primary" bindtap="confirmSourceUpdate">确认改用当前两题</button></view></view>
<view wx:elif="{{sourceResolved && sourceAvailability !== 'ready'}}" class="source-guard"><text class="source-guard-title">完整写作暂不可用</text><text>其中至少一道题正在核验。现有作文和照片会保留，核验完成前不会批改或计入模拟。</text></view>
<view wx:elif="{{!sourceResolved}}" class="source-guard"><text class="source-guard-title">题目来源尚未确认</text><text>请检查网络后重试。现有作文、照片和批改记录没有被修改。</text></view>
<text wx:if="{{sourceArchiveNotice}}" class="source-archive-note">{{sourceArchiveNotice}}</text>
<view class="pair-heading"><text>{{title}}</text><text>剩余 {{remaining}}</text></view>
<view wx:if="{{loading}}" class="loading-state">正在打开题组…</view><view wx:if="{{error}}" class="error">{{error}}</view>
<button wx:if="{{authRequired}}" class="secondary" bindtap="openAccount">登录后继续批改</button>
<view class="pair-grid">
<view wx:for="{{items}}" wx:for-index="taskIndex" wx:key="id" class="pair-task">
<text class="pair-title">Task {{item.number}}</text>
<image wx:for="{{item.images}}" wx:for-item="source" wx:key="id" class="pair-source" src="{{source.url}}" mode="widthFix" lazy-load data-index="{{taskIndex}}" bindtap="preview"/>
<text wx:if="{{!item.images.length}}" class="pair-prompt">{{item.prompt}}</text>
<view wx:if="{{sourceReviewRequired && sourcePreview}}" class="pair-source-preview"><text class="source-preview-title">当前 Task {{item.number}}</text><image wx:for="{{item.latestImages}}" wx:for-item="latestSource" wx:key="id" class="pair-source" src="{{latestSource.url}}" mode="widthFix" lazy-load/><text wx:if="{{!item.latestImages.length}}" class="pair-prompt">{{item.latestPrompt}}</text></view>
<view class="task-switcher"><button class="{{item.inputMode === 'typed' ? 'active' : ''}}" data-index="{{taskIndex}}" data-mode="typed" bindtap="chooseInputMode" disabled="{{busy || phase !== 'draft' || timeExpired || !sourceResolved || sourceAvailability !== 'ready' || sourceReviewRequired}}">打字</button><button class="{{item.inputMode === 'photo' ? 'active' : ''}}" data-index="{{taskIndex}}" data-mode="photo" bindtap="chooseInputMode" disabled="{{busy || phase !== 'draft' || timeExpired || !sourceResolved || sourceAvailability !== 'ready' || sourceReviewRequired}}">拍照</button></view>
<textarea wx:if="{{item.inputMode !== 'photo'}}" class="pair-essay" value="{{item.text}}" maxlength="20000" disabled="{{busy || timeExpired || phase !== 'draft' || !sourceResolved || sourceAvailability !== 'ready' || sourceReviewRequired}}" placeholder="输入你的作文" data-index="{{taskIndex}}" bindinput="input" cursor-spacing="24"/>
<block wx:if="{{item.inputMode === 'photo'}}"><button class="secondary" data-index="{{taskIndex}}" bindtap="takePhoto" disabled="{{busy || timeExpired || phase !== 'draft' || !sourceResolved || sourceAvailability !== 'ready' || sourceReviewRequired}}">{{item.photo ? '重新拍照' : '拍摄作文'}}</button>
<image wx:if="{{item.photo}}" class="pair-photo" src="{{item.photo}}" mode="aspectFit"/></block>
</view>
</view>
<view class="pair-footer"><text>{{status}}</text><text wx:if="{{timeExpired}}">时间已到，作文已保留。</text><button wx:if="{{phase !== 'done'}}" class="primary" loading="{{busy}}" disabled="{{busy || loading || !sourceResolved || sourceAvailability !== 'ready' || sourceReviewRequired}}" bindtap="submit">{{canRetry ? '继续查看批改' : '提交两篇作文'}}</button><button wx:elif="{{!sourceReviewRequired && sourceAvailability === 'ready'}}" class="secondary" bindtap="startNew">再练一次</button></view>
<view wx:if="{{feedback}}" class="pair-result"><text wx:if="{{!sourceResolved || sourceAvailability !== 'ready' || sourceReviewRequired}}" class="source-archive-note">以下是已保存的旧题批改记录，不会用于当前题目。</text><text wx:if="{{band !== null}}" class="pair-title">AI 练习估分 · {{band}}</text><text wx:if="{{band !== null}}">Task 1 : Task 2 = 1 : 2</text><text class="warning">{{warning}}</text><answer-content text="{{feedback}}"/><button wx:if="{{reportUrl}}" class="secondary" bindtap="downloadReport" loading="{{downloading}}" disabled="{{downloading}}">下载批改报告</button></view>
</view>
