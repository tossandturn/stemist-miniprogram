.objective-page { padding-bottom:calc(24px + env(safe-area-inset-bottom)); }.objective-top { margin:8px 0 14px; }.objective-name { display:block;font-size:17px;font-weight:700;line-height:1.5; }.objective-top>view { display:flex;justify-content:space-between;font-size:13px;color:#66708a;margin-top:8px; }.native-player { display:flex;align-items:center;gap:8px;padding:8px;border:1px solid #e4e7f0;border-radius:12px;background:#fff; }.native-player button { width:auto;min-width:60px;min-height:44px;margin:0;padding:8px;font-size:14px; }.native-player slider { flex:1;min-width:20px;margin:0; }.native-player>text { font-size:11px;white-space:nowrap; }.player-track { padding:10px 4px;font-size:13px; }.question-nav { white-space:nowrap;margin:14px 0;height:50px; }.question-nav-row { display:inline-flex;gap:8px;padding:2px; }.objective-page button.question-nav-key { width:44px;min-width:44px;height:44px;margin:0;padding:0;font-size:15px;line-height:44px;border:1px solid #e4e7f0;border-radius:9px;background:#fff; }.objective-page button.question-nav-key.answered { border-color:#3a9d85;color:#23705e; }.objective-page button.question-nav-key.current { background:#7357e8;border-color:#7357e8;color:#fff; }.objective-workspace { display:grid;gap:16px;grid-template-columns:minmax(0,1fr);align-items:start; }.objective-source,.objective-answer,.objective-result { min-width:0;padding:14px;border:1px solid #e4e7f0;border-radius:14px;background:#fff; }.source-toolbar { display:flex;align-items:center;gap:8px;margin-bottom:10px; }.source-toolbar>text { flex:1;font-size:14px;color:#66708a; }.source-toolbar button,.source-pages button { width:auto;min-width:58px;min-height:44px;padding:7px 10px;margin:0;font-size:13px; }.native-question-image { display:block;width:100%;background:#f5f6fb; }.source-pages { display:flex;align-items:center;justify-content:space-between;margin-top:8px; }.passage-scroll { height:60vh; }.passage-text { white-space:pre-wrap;font-size:16px;line-height:1.8; }.answer-heading { font-size:20px;font-weight:700;margin-bottom:12px; }.answer-question { display:block;font-size:15px;line-height:1.5;margin-bottom:14px; }.question-options text { display:block;margin:6px 0;font-size:14px; }.answer-label { display:block;font-size:14px;color:#66708a;margin:12px 0 6px; }.objective-input { width:100%;height:48px;border:1px solid #cbd1df;border-radius:10px;padding:10px 12px;background:#f9fafc;font-size:18px; }.answer-navigation { display:flex;gap:12px;margin:12px 0; }.answer-navigation button { flex:1;min-width:0;margin:0; }.answer-progress { display:block;font-size:13px;color:#66708a;margin:12px 0; }.objective-result { margin-top:16px; }.review-row { display:flex;flex-direction:column;gap:6px;padding:14px 0;border-bottom:1px solid #e4e7f0;font-size:14px; }.device-tablet.landscape .objective-workspace { grid-template-columns:minmax(0,1.4fr) minmax(280px,1fr); }.device-tablet.landscape .objective-answer { position:sticky;top:16px; }@media(max-width:700px){.device-tablet.landscape .objective-workspace{grid-template-columns:minmax(0,1fr);}.device-tablet.landscape .objective-answer{position:static;}}
.objective-jumps { display:flex;gap:10px;position:sticky;top:0;z-index:3;background:#f5f6fb;padding:8px 0;margin-bottom:8px; }.objective-jumps button { flex:1;width:auto;min-height:44px;margin:0;padding:8px;font-size:14px;line-height:28px;background:#ede8ff;color:#513bc7; }
.caption-controls { display:flex;justify-content:flex-end;margin:8px 0; }.caption-controls button { width:auto;min-height:44px;margin:0;padding:8px 16px;line-height:28px;font-size:14px; }.native-captions { display:flex;flex-direction:column;gap:8px;margin:10px 0;font-size:15px;line-height:1.6; }.caption-bubble { padding:10px 14px;border-radius:12px;background:#f0ecff; }.caption-speaker { display:block;font-size:12px;font-weight:700;margin-bottom:3px; }.caption-tone-1{background:#e7f8f0;}.caption-tone-2{background:#fff6e8;}.caption-tone-3{background:#fff0f2;}
.audio-load-status { min-height:24px;margin:6px 4px;color:#66708a;font-size:13px;line-height:1.6; }
.audio-load-status progress { margin-top:6px; }
.audio-load-error { color:#a22e48; }
