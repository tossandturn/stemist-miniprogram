<view class="page">
  <view class="eyebrow">IELTS · Listening</view>
  <view class="title">听力练习</view>
  <view class="subtitle">听完题目后，用文本框记录答案和复盘。</view>
  <view class="field-label">你的答案 / 复盘</view>
  <textarea placeholder="输入题号、答案、听不清的片段和关键词…" bindinput="onInput" />
  <button class="primary" bindtap="submit" loading="{{loading}}">提交给 AI Coach</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{answer}}" class="result">{{answer}}</view>
</view>
