<view class="page {{deviceClass}} {{orientation}} ielts-library">
 <stemist-header compact="{{true}}" title="{{title}}" action-text="返回" bind:action="back"/><ai-fab source="ielts" category="ielts"/>
 <view class="native-scopes"><button wx:for="{{scopes}}" wx:key="id" class="{{scope === item.id ? 'active' : ''}}" data-scope="{{item.id}}" bindtap="chooseScope">{{item.label}}</button></view>
 <view class="native-filters"><picker range="{{books}}" range-key="label" value="{{bookIndex}}" bindchange="chooseBook"><view class="native-filter">{{books[bookIndex].label || '全部书册'}} · 更换</view></picker><input class="native-search" placeholder="搜索试题" value="{{query}}" bindinput="search"/></view>
 <view wx:if="{{scope === 'topic' && topic}}" class="topic-breadcrumb"><button bindtap="clearTopic">‹ 全部主题</button><image src="{{topicIcon}}" mode="aspectFit" aria-hidden="true"/><text>{{topicLabel}}</text></view>
 <view wx:if="{{loading}}" class="loading-state">正在加载试题…</view>
 <view wx:elif="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重试</button></view>
 <view wx:elif="{{scope === 'topic' && !topic}}" class="native-topic-grid"><button wx:for="{{topics}}" wx:key="key" class="native-topic-card" data-key="{{item.key}}" bindtap="chooseTopic"><view class="native-topic-icon"><image class="topic-icon-image" src="{{item.icon}}" mode="aspectFit" aria-hidden="true"/></view><text class="topic-label">{{item.label}}</text><text class="topic-count">{{item.count}} {{module === 'reading' ? '篇阅读' : module === 'listening' ? '段听力' : module === 'writing' ? '道 Task 2' : '套口语'}}</text></button><view wx:if="{{!topics.length}}" class="empty-state">没有匹配的主题</view></view>
 <block wx:else><view class="native-count">{{total}} 份试题</view><view class="native-task-grid"><button wx:for="{{items}}" wx:key="id" class="native-task-card" data-id="{{item.id}}" bindtap="open"><text class="task-source">{{item.book ? 'Cambridge ' + item.book : 'IELTS 练习'}}</text><text class="task-title">{{item.title}}</text><text class="task-meta">{{item.minutes}} 分钟{{item.questionCount ? ' · ' + item.questionCount + ' 题' : ''}}</text><text class="task-enter">开始练习 →</text></button></view>
 <view wx:if="{{!items.length}}" class="empty-state">没有匹配的试题</view><view wx:if="{{pageCount > 1}}" class="native-pager"><button disabled="{{page <= 0}}" bindtap="previous">上一页</button><text>{{page + 1}} / {{pageCount}}</text><button disabled="{{page + 1 >= pageCount}}" bindtap="next">下一页</button></view></block>
</view>
