<view class="page {{deviceClass}} {{orientation}} ielts-library">
 <stemist-header compact="{{true}}" title="{{title}}" action-text="返回" bind:action="back"/><ai-fab source="ielts" category="ielts"/>
 <view wx:if="{{module === 'listening' || module === 'reading'}}" class="native-scopes"><button wx:for="{{scopes}}" wx:key="id" class="{{scope === item.id ? 'active' : ''}}" data-scope="{{item.id}}" bindtap="chooseScope">{{item.label}}</button></view>
 <view class="native-filters"><picker range="{{books}}" range-key="label" value="{{bookIndex}}" bindchange="chooseBook"><view class="native-filter">{{books[bookIndex].label || '全部书册'}} · 更换</view></picker><input class="native-search" placeholder="搜索试题" value="{{query}}" bindinput="search"/></view>
 <picker wx:if="{{scope === 'topic'}}" range="{{topics}}" range-key="label" value="{{topicIndex}}" bindchange="chooseTopic"><view class="native-filter">{{topics[topicIndex].label || '全部主题'}}</view></picker>
 <view wx:if="{{loading}}" class="loading-state">正在加载试题…</view>
 <view wx:elif="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重试</button></view>
 <block wx:else><view class="native-count">{{total}} 份试题</view><view class="native-task-grid"><button wx:for="{{items}}" wx:key="id" class="native-task-card" data-id="{{item.id}}" bindtap="open"><text class="task-source">Cambridge {{item.book}}</text><text class="task-title">{{item.title}}</text><text class="task-meta">{{item.minutes}} 分钟{{item.questionCount ? ' · ' + item.questionCount + ' 题' : ''}}</text><text class="task-enter">开始练习 →</text></button></view>
 <view wx:if="{{!items.length}}" class="empty-state">没有匹配的试题</view><view wx:if="{{pageCount > 1}}" class="native-pager"><button disabled="{{page <= 0}}" bindtap="previous">上一页</button><text>{{page + 1}} / {{pageCount}}</text><button disabled="{{page + 1 >= pageCount}}" bindtap="next">下一页</button></view></block>
</view>
