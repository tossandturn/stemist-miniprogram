<view class="page {{deviceClass}} {{orientation}} ielts-skill-page writing-page">
  <stemist-header eyebrow="IELTSIST · 写作 AI 反馈" title="Writing with AI" subtitle="题目、作文和四项标准反馈" action-text="返回" bind:action="openBack" />
  <app-nav active="practice" source="writing" category="ielts" is-tablet="{{isTablet}}" />
  <view class="workspace-grid">
    <view class="context-card skill-identity writing-identity">
      <view class="context-card-title">Writing · 选择输入方式</view>
      <view class="context-card-text">沿用 IELTSist 的独立 Task 练习：先选 Task 1 / Task 2，再打字或拍一张手写作文；照片只在提交时读取。</view>
      <view class="task-switcher">
        <button class="task-chip {{taskType === 'Task 1' ? 'active' : ''}}" data-task="Task 1" bindtap="chooseTask">Task 1</button>
        <button class="task-chip {{taskType === 'Task 2' ? 'active' : ''}}" data-task="Task 2" bindtap="chooseTask">Task 2</button>
      </view>
      <button class="secondary photo-button" bindtap="takePhoto">{{photoPath ? '重新拍照' : '拍照上传手写作文'}}</button>
      <image wx:if="{{photoPath}}" class="photo-preview" src="{{photoPath}}" mode="aspectFit" />
    </view>
    <view class="writing-editor panel">
      <view class="field-label">题目（建议填写）</view>
      <textarea class="prompt-input" value="{{prompt}}" maxlength="2000" cursor-spacing="24" adjust-position="true" show-confirm-bar="true" placeholder="粘贴 IELTS Task 1 / Task 2 题目；照片中也应尽量拍到题目。" bindinput="onPromptInput" />
      <coach-panel message="{{text}}" answer="{{answer}}" warning="{{warning}}" error="{{error}}" can-retry="{{canRetry}}" auth-required="{{authRequired}}" status="{{coachStatus}}" loading="{{loading}}" submit-label="提交并获取评分" placeholder="直接输入你的 Task 1 / Task 2 作文…" helper="AI Coach 会按四项标准反馈；没有题目时只做语言层面分析，不宣称完整 Task 评分。" bind:input="onInput" bind:submit="submit" bind:retry="retry" bind:account="openAccount" />
    </view>
  </view>
  <button class="text-button" bindtap="clear" disabled="{{loading}}">清空当前作文和照片</button>
  <button class="secondary full-workspace-link" bindtap="openFullWorkspace">打开完整 IELTSist Writing</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="notice">{{isTablet ? 'iPad：左侧任务与照片证据，右侧编辑和 Coach 结果。' : '手机：输入、拍照和提交按单列顺序完成，键盘不会覆盖提交按钮。'}}</view>
</view>
