.vocabulary-page{padding-bottom:calc(28px + env(safe-area-inset-bottom));max-width:1180px;margin:auto;box-sizing:border-box;}.vocab-library button,.vocab-toolbar button,.vocab-modes button,.vocab-workspace button,.vocab-filters button,.vocab-grid button,.vocab-nav button{min-height:44px;margin:0;line-height:1.45;font-size:15px;box-sizing:border-box;}.vocab-toolbar,.vocab-modes,.vocab-review,.vocab-nav,.vocab-utility{display:flex;gap:10px;align-items:center;margin:14px 0;}.vocab-toolbar .vocab-current-pack{flex:1;min-width:0;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px;text-align:left;background:#fff;border:1px solid #e4e7f0;border-radius:12px;font-weight:700;}.vocab-current-pack text:last-child{font-size:12px;color:#6546d7;flex-shrink:0;}.vocabulary-page .vocab-small{width:auto;min-width:56px;padding:10px;font-size:13px;background:#efebfb;color:#5139ab;}.vocab-modes{gap:8px;padding:4px;background:#ebeaf3;border-radius:13px;}.vocab-modes button{flex:1;width:0;min-width:0;padding:10px 0;font-size:13px;background:transparent;color:#58617a;border-radius:10px;}.vocab-modes button.selected{background:#fff;color:#5139ab;font-weight:700;box-shadow:0 2px 5px #18213d0d;}.vocab-heading{display:block;margin:20px 0 10px;font-size:23px;font-weight:750;}.vocab-muted{display:block;color:#66708a;font-size:13px;line-height:1.65;}.vocab-filters{display:flex;flex-wrap:wrap;gap:10px;margin:14px 0;}.vocab-filters input{flex-basis:100%;box-sizing:border-box;width:100%;height:46px;border:1px solid #dfe3ef;background:#fff;border-radius:10px;padding:10px 12px;}.vocab-filters picker{flex:1;min-width:0;}.vocab-filters picker view{padding:12px;border:1px solid #dfe3ef;border-radius:10px;font-size:13px;background:#fff;}.vocab-progress{display:flex;justify-content:space-between;gap:12px;margin:18px 0 10px;font-size:13px;color:#66708a;}.vocab-card{background:#fff;border:1px solid #e4e7f0;border-radius:20px;padding:22px 20px;margin:16px 0;box-shadow:0 5px 20px #18213d06;}.vocab-card-context{display:flex;flex-wrap:wrap;gap:5px 12px;color:#66708a;font-size:12px;margin-bottom:18px;}.vocab-word{display:block;font-size:34px;font-weight:750;line-height:1.3;overflow-wrap:anywhere;margin-bottom:10px;}.vocab-meaning{display:block;margin:18px 0 10px;font-size:22px;line-height:1.5;font-weight:700;}.vocab-definition{display:block;font-size:16px;line-height:1.65;}.vocab-example{padding:14px;margin-top:18px;border-radius:12px;background:#f5f4fc;}.vocab-example text{display:block;font-size:15px;line-height:1.65;}.vocab-example text+text{margin-top:8px;color:#66708a;font-size:14px;}.vocab-review{margin-top:22px;}.vocab-review button,.vocab-nav button{flex:1;min-width:0;width:0;padding:13px 8px;}.vocab-utility{justify-content:space-between;margin-bottom:0;}.vocab-utility button{width:auto;padding:10px 0;color:#6546d7;background:transparent;font-size:14px;}.vocab-reveal{margin-top:24px!important;width:100%;padding:18px;}.vocab-section{margin-top:20px;border-top:1px solid #e4e7f0;padding-top:16px;}.vocab-section-title{display:block;font-weight:700;margin:0 0 12px;font-size:16px;}.vocab-step{display:flex;gap:8px;margin:9px 0;}.vocab-step answer-content{flex:1;min-width:0;}.vocab-collocation{display:inline-block;padding:7px 9px;margin:0 8px 8px 0;background:#f0ecfa;border-radius:8px;font-size:14px;}.vocab-status{display:block;min-height:20px;font-size:13px;line-height:1.6;color:#5139ab;}.vocab-empty{display:flex;flex-direction:column;gap:18px;align-items:center;justify-content:center;text-align:center;background:#fff;border:1px solid #e4e7f0;border-radius:18px;min-height:200px;margin-top:16px;padding:24px;color:#66708a;font-size:15px;}.vocab-empty button{width:auto;padding:12px 20px;}.vocab-packs,.vocab-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:18px 0;}.vocabulary-page .vocab-pack,.vocabulary-page .vocab-row{display:flex;flex-direction:column;align-items:flex-start;gap:8px;text-align:left;width:100%;padding:16px 12px;background:#fff;border:1px solid #e4e7f0;border-radius:14px;}.vocab-pack text:first-child,.vocab-row text:first-child{font-weight:700;overflow-wrap:anywhere;}.vocab-pack text:last-child,.vocab-row text:last-child{font-size:12px;color:#66708a;}.vocab-pack.selected{border-color:#6546d7;background:#f3efff;}.vocab-subjects{display:grid;grid-template-columns:minmax(0,1fr);gap:10px;}.vocab-subjects button{display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;padding:16px;text-align:left;background:#fff;border:1px solid #e4e7f0;border-radius:12px;}.vocab-subjects text:last-child{color:#66708a;font-size:13px;flex-shrink:0;}.vocab-nav{justify-content:center;}.device-tablet.landscape .vocab-workspace{display:grid;grid-template-columns:minmax(0,2fr) minmax(220px,1fr);gap:24px;}.device-tablet.landscape .vocab-side{padding-top:50px;}.device-tablet .vocab-subjects{grid-template-columns:repeat(2,minmax(0,1fr));}.device-tablet .vocab-packs{grid-template-columns:repeat(3,minmax(0,1fr));}.device-tablet .vocab-card{padding:28px;}.device-tablet .vocab-word{font-size:40px;}@media(max-width:600px){.device-tablet .vocab-subjects{grid-template-columns:minmax(0,1fr);}.device-tablet .vocab-packs{grid-template-columns:repeat(2,minmax(0,1fr));}}
