.vocab-switch,.vocab-filters,.vocab-review,.vocab-pager { display:flex;gap:10px;align-items:center;margin:14px 0; }.vocab-switch button,.vocab-filters button,.vocab-pager button { min-height:44px;width:auto;min-width:74px;margin:0;padding:8px 12px;font-size:14px; }.vocab-switch button.selected,.vocab-filters button.selected { background:#7357e8;color:#fff; }.vocab-filters input { width:100%;min-width:0;flex:1;height:44px;padding:8px 12px;border:1px solid #e4e7f0;border-radius:10px;background:#fff; }.vocab-filters picker view { padding:10px;font-size:13px; }.vocab-count { color:#66708a;font-size:13px;margin:12px 0; }.vocab-grid { display:grid;gap:10px;grid-template-columns:minmax(0,1fr); }.vocabulary-page button.vocab-row { display:flex;flex-direction:column;gap:7px;align-items:flex-start;width:100%;min-width:0;margin:0;padding:16px;border:1px solid #e4e7f0;border-radius:12px;background:#fff;line-height:1.5;text-align:left; }.vocab-row>text:first-child { font-size:20px;font-weight:700; }.vocab-row>text:last-child { font-size:14px;color:#66708a; }.vocab-detail { position:relative;padding:24px 20px;border:1px solid #e4e7f0;border-radius:16px;background:#fff; }.vocabulary-page button.vocab-close { position:absolute;right:10px;top:10px;width:44px;min-width:44px;height:44px;margin:0;padding:0;font-size:28px;line-height:44px; }.vocab-word { display:block;margin-right:38px;font-size:30px;font-weight:700;overflow-wrap:anywhere; }.vocab-phonetic,.vocab-meaning,.vocab-body,.vocab-example,.vocab-status { display:block;margin:12px 0;font-size:16px;line-height:1.7; }.vocab-phonetic,.vocab-status { color:#66708a;font-size:13px; }.vocab-meaning { font-size:20px;font-weight:700; }.vocab-example { padding:12px;background:#f5f6fb;border-radius:10px; }.vocab-review button { flex:1;min-width:0;margin:0; }.vocab-pager { justify-content:center; }.device-tablet .vocab-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }.device-tablet .vocab-detail { max-width:760px;margin:0 auto; }@media(max-width:600px){.vocab-filters{flex-wrap:wrap;}.vocab-filters input{flex-basis:100%;}.device-tablet .vocab-grid{grid-template-columns:1fr;}}
