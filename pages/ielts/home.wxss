.native-goal,.native-records,.native-membership { padding:20px;margin:16px 0;border:1px solid #e4e7f0;border-radius:16px;background:#fff; }.native-goal>text { display:block;font-size:14px;color:#66708a; }.goal-number { display:flex;align-items:baseline;gap:14px;font-size:42px;font-weight:700;color:#5638c3;padding:10px 0; }.goal-number>text { font-size:13px;font-weight:400; }.native-skill-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:16px 0; }.native-skill-grid button { width:100%;min-width:0;min-height:60px;margin:0;background:#f0ecff;color:#5638c3;font-size:17px; }.records-title { font-size:20px;font-weight:700;margin-bottom:14px; }.native-ielts-home button.native-record-row { display:flex;justify-content:space-between;gap:14px;width:100%;min-width:0;min-height:60px;margin:0;padding:14px 0;background:#fff;border-bottom:1px solid #e4e7f0;border-radius:0;font-size:14px;text-align:left; }.native-record-row>text:first-child { flex:1;overflow:hidden; }.native-record-row>text:last-child { white-space:nowrap;color:#66708a; }.redemption { margin:24px 0 12px; }.redemption>text { display:block;margin-bottom:8px;font-size:14px; }.redemption input { height:48px;width:100%;padding:10px 12px;border:1px solid #e4e7f0;border-radius:10px;margin-bottom:12px;font-size:16px; }.native-home-status { color:#66708a;font-size:13px; }.device-tablet .native-goal,.device-tablet .native-membership,.device-tablet .native-records { max-width:800px;margin-left:auto;margin-right:auto; }
