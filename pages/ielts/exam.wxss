.exam-setup,.exam-report { display:block;padding:20px;margin:16px 0;border:1px solid #e4e7f0;border-radius:16px;background:#fff; }.exam-picker { min-height:48px;padding:12px;border:1px solid #e4e7f0;border-radius:10px;margin-bottom:16px; }.exam-setup>text { display:block;color:#66708a;font-size:15px;margin:16px 0; }.exam-modules { display:grid;grid-template-columns:1fr;gap:12px;margin:18px 0; }.native-exam-page button.exam-module { width:100%;min-width:0;display:flex;justify-content:space-between;gap:14px;margin:0;padding:20px;border:1px solid #e4e7f0;border-radius:14px;background:#fff;line-height:1.5;text-align:left; }.exam-module>text:first-child { font-size:19px;font-weight:700; }.exam-module>text:last-child { font-size:14px;color:#66708a; }.exam-report { white-space:pre-wrap;font-size:16px;line-height:1.8; }.device-tablet .exam-modules { grid-template-columns:repeat(2,minmax(0,1fr)); }
