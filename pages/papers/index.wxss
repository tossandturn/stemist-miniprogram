.filter-panel { display: flex; flex-wrap: wrap; margin: -4px; }
.filter-panel picker { flex: 1; min-width: 136px; margin: 4px; }
.filter-select { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 12px; border: 1px solid #dde2ef; border-radius: 12px; color: #18213d; background: #fff; font-size: 14px; font-weight: 650; }
.filter-select text:first-child { flex: 1; min-width: 0; }
.filter-chevron { margin-left: 12px; color: #675187; font-size: 12px; }
.search-box { position: relative; width: calc(100% - 8px); margin: 8px 4px 4px; }
.search-box input { width: 100%; height: 48px; padding: 0 70px 0 14px; border: 1px solid #dde2ef; border-radius: 12px; background: #fff; color: #18213d; font-size: 15px; }
.search-clear { position: absolute; top: 2px; right: 2px; min-height: 44px; color: #6142c3; background: transparent; font-size: 13px; }
.loading-state, .catalog-caption { margin: 20px 0 12px; color: #66708a; font-size: 13px; }
.paper-list { display: flex; flex-wrap: wrap; margin: -6px; }
.paper-row { width: calc(100% - 12px); margin: 6px; padding: 20px; border: 1px solid #e4e7f0; border-radius: 16px; background: #fff; }
.paper-copy { min-width: 0; }
.paper-year { display: block; margin-bottom: 6px; color: #66708a; font-size: 12px; }
.paper-title { display: block; overflow-wrap: anywhere; color: #18213d; font-size: 16px; font-weight: 700; }
.paper-detail { display: block; margin-top: 8px; color: #15745b; font-size: 12px; }
.paper-actions { display: flex; flex-wrap: wrap; margin: 16px -4px -4px; }
.paper-actions button { min-height: 44px; margin: 4px; padding: 10px 12px; font-size: 14px; }
.paper-open { color: #fff; background: #6848d7; }
.paper-pdf { color: #5638b8; background: #f2effb; }
.more-papers { margin-top: 20px; }
.device-tablet .paper-row { width: calc(50% - 12px); }
.device-tablet .search-box { flex: 2; width: auto; min-width: 180px; margin-top: 4px; }
.paper-row .paper-actions button { width: auto; min-width: 0; margin: 4px; }
