.progress-metrics { margin-top: 20rpx; }
.next-card { border-top: 6rpx solid #7357e8; }
.next-card .secondary { margin-top: 12rpx; }
.record-list { display: grid; gap: 10rpx; }
.record-row { display: flex; align-items: center; gap: 12rpx; min-height: 86rpx; padding: 14rpx 16rpx; border: 1rpx solid #e4e7f0; border-radius: 14rpx; background: #fff; }
.record-mark { width: 12rpx; height: 44rpx; border-radius: 8rpx; background: #7357e8; }
.record-copy { min-width: 0; flex: 1; }
.record-title, .record-detail { display: block; }
.record-title { color: #18213d; font-size: 25rpx; font-weight: 800; }
.record-detail, .record-time { color: #66708a; font-size: 20rpx; }
.record-detail { margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.record-time { flex: 0 0 auto; }
.empty-state { margin-top: 18rpx; padding: 30rpx; border: 1rpx dashed #cdd3e2; border-radius: 16rpx; text-align: center; background: rgba(255,255,255,.7); }
.empty-title { color: #18213d; font-size: 28rpx; font-weight: 800; }
.empty-detail { margin-top: 8rpx; color: #66708a; font-size: 23rpx; }
@media (min-width: 768px) { .progress-metrics, .next-card, .record-list, .progress-page > .section-title, .empty-state { max-width: 1120px; margin-left: auto; margin-right: auto; } .progress-metrics { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
