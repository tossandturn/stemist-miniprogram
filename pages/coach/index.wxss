.coach-home-page{padding-top:12px}
.coach-topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 12px}
.coach-topbar picker{min-width:0;flex:1}
.coach-scope-select{display:flex;align-items:center;gap:10px;min-height:44px;color:#18213d;font-size:15px;font-weight:600}
.coach-scope-select text{color:#66708a;font-size:16px}
.coach-home-page button.coach-history-link{width:auto;flex-shrink:0;min-height:44px;margin:0;padding:10px 8px;background:transparent;color:#5638c3;font-size:14px}
.coach-home-page .route-pill{display:block;margin:0 0 12px;color:#66708a;font-size:12px;line-height:1.5;overflow-wrap:anywhere}
.coach-workspace,.coach-workspace>coach-panel{min-width:0}
.coach-media-card{box-sizing:border-box;margin:0 0 12px;padding:12px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}
.coach-media-head{display:flex;align-items:center;justify-content:space-between;gap:8px;color:#66708a;font-size:13px}
.coach-photo-tools{display:flex;align-items:center;gap:8px;flex-shrink:0}
.coach-photo-tools button{width:auto;min-height:44px;min-width:44px;margin:0;padding:8px;background:transparent;color:#5638c3;font-size:13px}
.coach-photo-tools button.coach-media-remove{color:#a22e48}
.coach-photo-shell{position:relative;margin:4px 0 12px;overflow:hidden;border:1px solid #e4e7f0;border-radius:10px;background:#f0f2f7}
.coach-photo-preview{display:block;width:100%;height:220px}
.coach-photo-status{position:absolute;right:8px;top:8px;padding:4px 8px;border-radius:8px;color:#fff;background:rgba(16,26,56,.82);font-size:12px}
.coach-media-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.coach-home-page button.coach-media-button{box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-width:0;max-width:100%;min-height:48px;margin:0;padding:10px 8px;border:1px solid #e4def5;border-radius:10px;color:#5638c3;background:#faf8ff;font-size:14px;line-height:1.5}
.coach-media-button:active{background:#eee8ff}
.coach-media-icon{position:relative;flex:0 0 auto;width:22px;height:22px}
.camera-lens-small{position:absolute;left:1px;top:5px;width:20px;height:15px;border:1.7px solid currentColor;border-radius:5px}
.camera-lens-small::before{position:absolute;left:6px;top:3px;width:6px;height:6px;border:1.7px solid currentColor;border-radius:50%;content:''}
.camera-lens-small::after{position:absolute;left:3px;top:-5px;width:8px;height:3px;border:1.7px solid currentColor;border-bottom:0;border-radius:3px 3px 0 0;content:''}
.album-icon-small{border:1.7px solid currentColor;border-radius:5px;overflow:hidden}.album-sun{position:absolute;right:3px;top:3px;width:4px;height:4px;border:1.5px solid currentColor;border-radius:50%}.album-mountain{position:absolute;left:3px;bottom:-4px;width:13px;height:13px;border-left:1.7px solid currentColor;border-top:1.7px solid currentColor;transform:rotate(45deg)}
.coach-actions{display:flex;flex-direction:column;align-items:center;gap:8px;margin-top:12px}.coach-actions .text-button{min-height:44px;font-size:13px;color:#66708a}
.coach-home-page.device-tablet .coach-topbar,.coach-home-page.device-tablet .route-pill,.coach-home-page.device-tablet .coach-workspace,.coach-home-page.device-tablet .coach-actions{max-width:1040px;margin-left:auto;margin-right:auto}
@media(min-width:900px){.coach-home-page.device-tablet.landscape .coach-workspace{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(0,1.15fr);gap:16px;align-items:start}.coach-photo-preview{height:300px}}
@media(prefers-reduced-motion:reduce){.coach-media-button{transition:none}}
