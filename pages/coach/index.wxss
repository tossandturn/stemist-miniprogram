.coach-intro { border-top: 6rpx solid #7357e8; }
.coach-home-page .route-label { display: block; margin: 24rpx 0 10rpx; color: #4e5a76; font-size: 23rpx; font-weight: 800; }
.context-grid { display: grid; gap: 10rpx; }
.context-choice { display: block; min-height: 96rpx; padding: 18rpx; border: 1rpx solid #e4e7f0; border-radius: 16rpx; color: #18213d; background: #fff; text-align: left; }
.context-choice.active { border-color: #7357e8; background: #f7f5ff; box-shadow: 0 0 0 3rpx rgba(115, 87, 232, .1); }
.context-choice-title, .context-choice-detail { display: block; }
.context-choice-title { font-size: 26rpx; font-weight: 800; }
.context-choice-detail { margin-top: 6rpx; color: #66708a; font-size: 21rpx; }
.coach-actions { display: grid; gap: 8rpx; margin-top: 14rpx; }
@media (min-width: 768px) {
  .coach-home-page .coach-intro, .coach-home-page .context-grid, .coach-home-page .coach-panel, .coach-home-page .coach-actions { max-width: 1120px; margin-left: auto; margin-right: auto; }
  .context-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .coach-home-page .coach-panel { margin-top: 20px; }
  .coach-actions { display: flex; align-items: center; }
  .coach-actions .secondary { width: auto; min-width: 260px; }
}
