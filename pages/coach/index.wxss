.coach-home-page .workspace-header-compact{padding-right:0;margin-bottom:8px}
.coach-home-page .route-pill{display:block;margin:0 0 10px;color:#66708a;font-size:12px;line-height:1.5;overflow-wrap:anywhere}
.coach-scope-select{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:46px;padding:11px 14px;border:1px solid #e1e5ed;border-radius:12px;color:#18213d;background:#fff;font-size:14px}
.coach-scope-select text{flex:0 0 auto;color:#66708a;font-size:12px}
.coach-workspace,.coach-workspace>coach-panel{min-width:0}
.coach-media-card{padding:16px;border-radius:18px}
.coach-media-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.coach-media-title{color:#18213d;font-size:17px;font-weight:700}
.coach-media-detail{margin-top:3px;color:#66708a;font-size:13px}
.coach-media-remove{flex:0 0 auto;margin-top:0;color:#a22e48}
.coach-photo-shell{position:relative;margin-top:14px;overflow:hidden;border:1px solid #e1e5ed;border-radius:12px;background:#f0f2f7}
.coach-photo-preview{display:block;width:100%;height:250px}
.coach-photo-status{position:absolute;right:10px;top:10px;padding:5px 9px;border-radius:999px;color:#fff;background:rgba(16,26,56,.82);font-size:12px}
.coach-media-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}
button.coach-media-button{box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:9px;width:100%;min-width:0;max-width:100%;min-height:50px;padding:11px 10px;border:1px solid #ded7f8;color:#5638b8;background:#f2effd;font-size:14px}
button.coach-media-primary{border-color:#6848d7;color:#fff;background:#6848d7}
button.coach-media-primary:active{background:#5536c3}
.coach-media-icon{position:relative;flex:0 0 auto;width:24px;height:24px}
.camera-lens-small{position:absolute;left:2px;top:5px;width:20px;height:15px;border:2px solid currentColor;border-radius:5px}
.camera-lens-small::before{position:absolute;left:6px;top:3px;width:6px;height:6px;border:2px solid currentColor;border-radius:50%;content:''}
.camera-lens-small::after{position:absolute;left:3px;top:-6px;width:8px;height:4px;border:2px solid currentColor;border-bottom:0;border-radius:3px 3px 0 0;content:''}
.album-icon-small{border:2px solid currentColor;border-radius:5px;overflow:hidden}
.album-sun{position:absolute;right:3px;top:3px;width:5px;height:5px;border:1.5px solid currentColor;border-radius:50%}
.album-mountain{position:absolute;left:3px;bottom:-4px;width:13px;height:13px;border-left:2px solid currentColor;border-top:2px solid currentColor;transform:rotate(45deg)}
.coach-actions{display:flex;justify-content:center;margin-top:8px}
.coach-actions .text-button{min-height:44px}
.coach-home-page.device-tablet .coach-scope-select,.coach-home-page.device-tablet .route-pill,.coach-home-page.device-tablet .coach-workspace,.coach-home-page.device-tablet .coach-actions{max-width:1120px;margin-left:auto;margin-right:auto}
@media(min-width:900px){.coach-home-page.device-tablet.landscape .coach-workspace{display:grid;grid-template-columns:minmax(300px,.8fr) minmax(0,1.2fr);gap:20px;align-items:start}.coach-photo-preview{height:300px}}
@media(max-width:340px){.coach-media-actions{grid-template-columns:1fr}}
