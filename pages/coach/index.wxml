<view class="page {{deviceClass}} {{orientation}} coach-home-page">
  <stemist-header title="AI Coach" />
  <app-nav active="coach" is-tablet="{{isTablet}}" show-ai="{{false}}" category="{{routeContext.category}}" family="{{routeContext.family}}" />
  <picker mode="selector" range="{{contexts}}" range-key="label" value="{{contextIndex}}" bindchange="chooseContextPicker"><view class="coach-scope-select">{{contexts[contextIndex].label}}<text>更换</text></view></picker>
  <view wx:if="{{routeContextLabel}}" class="route-pill">{{routeContextLabel}}</view>
  <coach-panel message="{{message}}" answer="{{answer}}" warning="{{warning}}" error="{{error}}" can-retry="{{canRetry}}" auth-required="{{authRequired}}" status="{{coachStatus}}" loading="{{loading}}" submit-label="发送" placeholder="想问什么？" helper="" bind:input="onMessage" bind:submit="submit" bind:retry="retry" bind:account="openAccount" />
  <view class="coach-actions"><button class="secondary" data-context="{{contextId}}" bindtap="openContext">{{contextId === 'stem-photo' ? '拍照提问' : '去练习'}}</button><button class="text-button" bindtap="clear" disabled="{{loading}}">清空</button></view>
</view>
