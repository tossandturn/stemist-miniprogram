.privacy-panel { margin-top: 20rpx; }
.privacy-panel .section-title { margin-top: 28rpx; font-size: 28rpx; }
.privacy-panel .section-title:first-child { margin-top: 0; }
.privacy-item { margin-top: 10rpx; color: #5d6781; font-size: 24rpx; line-height: 1.65; }
.privacy-status,.privacy-permissions{margin-top:16px}.permission-row{display:block;padding:12px 0}.permission-row+.permission-row{border-top:1px solid #e4e7f0}.permission-row>view{width:100%;min-width:0}.permission-name,.permission-status{display:block}.permission-name{font-size:16px;font-weight:700}.permission-status{margin-top:4px;font-size:14px;line-height:1.5;color:#66708a}.privacy-page .permission-row button{width:100%;min-height:48px;margin:12px 0 0;padding:10px 12px;font-size:14px}.privacy-page .privacy-item{display:block;font-size:14px;line-height:1.65}.privacy-page .section-title{font-size:16px}.device-tablet.privacy-page{max-width:860px;margin:0 auto}.device-tablet.landscape.privacy-page .privacy-permissions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}.device-tablet.landscape.privacy-page .privacy-permissions>.privacy-item{grid-column:1/-1}.device-tablet.landscape.privacy-page .permission-row+.permission-row{border-top:0}
