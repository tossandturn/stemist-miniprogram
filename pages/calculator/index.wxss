.cw-glyph { position: relative; display: block; width: 14px; height: 14px; color: #f2f3ee; }
.glyph-up, .glyph-right, .glyph-down, .glyph-left, .glyph-page-up, .glyph-page-down { width: 9px; height: 9px; border-top: 2px solid currentColor; border-right: 2px solid currentColor; }
