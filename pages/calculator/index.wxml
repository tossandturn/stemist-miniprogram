<template name="cw-key">
  <button class="calc-key cw-key cw-id-{{key.id}} {{control ? 'cw-control' : ''}} {{numeric ? 'cw-number' : ''}} {{key.tone === 'shift' ? 'cw-shift' : ''}} {{key.action === 'equals' ? 'calc-equals' : ''}} {{key.action === 'format' ? 'cw-format-key' : ''}} {{shiftActive && key.action === 'shift' ? 'shift-on' : ''}}" style="{{control ? 'grid-column:' + key.col + ';grid-row:' + key.row : ''}}" data-key="{{key.id}}" data-action="{{key.action || ''}}" data-value="{{key.value || ''}}" data-shift-action="{{key.shiftAction || ''}}" data-shift-value="{{key.shiftValue || ''}}" bindtap="press" hover-class="cw-key-pressed" hover-stay-time="80" aria-label="{{key.label || key.action}} {{key.shiftLabel ? 'SHIFT ' + key.shiftLabel : ''}}">
    <text class="cw-legend {{control && key.action !== 'shift' ? 'cw-control-legend' : ''}}">{{control ? key.label : key.shiftLabel || ' '}}</text>
    <view class="cw-key-face"><view wx:if="{{key.face}}" class="cw-glyph glyph-{{key.face}}"></view><text wx:else class="cw-key-text">{{control ? key.text : key.label}}</text></view>
  </button>
</template>

<view class="page {{deviceClass}} {{orientation}} calculator-page">
  <stemist-header compact="{{true}}" title="fx-991CW" action-text="返回" bind:action="goBack" />
  <ai-fab source="calculator" />
  <view class="cw-workspace">
    <view class="calculator-shell cw-instrument">
      <view class="cw-brand-row"><view><text class="cw-brand">STEMist</text><text class="cw-model">fx-991CW 键位</text></view><view class="cw-solar" aria-hidden="true"><view></view><view></view><view></view><view></view></view></view>
      <view class="cw-display-bezel">
        <view class="calculator-display {{powerOff ? 'is-off' : ''}}">
          <block wx:if="{{!powerOff}}">
            <view class="display-status"><text>{{shiftActive ? 'S  ' : ''}}{{angleMode === 'DEG' ? 'D' : angleMode === 'RAD' ? 'R' : 'G'}}  {{argumentMode ? 'INS' : ''}}</text><text>{{menu ? menuTitle : solverPhase === 'target' ? 'Solve Target' : solverPhase === 'initial' ? 'Enter Initial Value' : solverPhase === 'parameter' ? 'Variable Value' : solverPhase ? 'Solver' : 'Calculate'}}</text><text>{{memory ? 'M' : ''}}</text></view>
            <scroll-view wx:if="{{menu}}" class="cw-menu-scroll" scroll-y scroll-into-view="cw-menu-{{menuIndex}}">
              <view wx:if="{{menu === 'home'}}" class="cw-home-grid"><button wx:for="{{menuItems}}" wx:key="id" id="cw-menu-{{index}}" class="cw-app {{menuIndex === index ? 'menu-active' : ''}}" data-id="{{item.id}}" bindtap="chooseMenu"><text class="cw-app-symbol">{{item.icon}}</text><text>{{item.label}}</text></button></view>
              <block wx:else><button wx:for="{{menuItems}}" wx:key="id" id="cw-menu-{{index}}" class="cw-menu-item {{menuIndex === index ? 'menu-active' : ''}}" data-id="{{item.id}}" bindtap="chooseMenu"><text class="menu-label">{{item.label}}</text><text wx:if="{{item.detail}}" class="menu-detail">{{item.detail}}</text><text wx:else>›</text></button><view wx:if="{{!menuItems.length}}" class="cw-empty-history">No history</view></block>
            </scroll-view>
            <view wx:elif="{{solverPhase && error && solverPhase !== 'equation' && solverPhase !== 'continue'}}" class="cw-solver-panel cw-solver-error" role="alert"><text>{{error}}</text><button class="cw-solver-key" bindtap="solverDismissError">← 修改数值</button></view>
            <scroll-view wx:elif="{{solverPhase === 'target'}}" class="cw-solver-panel" scroll-y scroll-into-view="solver-target-{{solverTargetIndex}}"><button wx:for="{{solverTargets}}" wx:key="*this" id="solver-target-{{index}}" class="cw-solver-key {{solverTargetIndex === index ? 'solver-selected' : ''}}" data-name="{{item}}" bindtap="chooseSolverTarget"><text>{{solverTargetIndex === index ? '▶ ' : ''}}{{item}}</text></button></scroll-view>
            <view wx:elif="{{solverPhase === 'initial' || solverPhase === 'parameter'}}" class="cw-solver-panel"><button class="cw-solver-key solver-initial-field {{solverInitialIndex === 0 ? 'solver-selected' : ''}}" bindtap="selectSolverInitial"><text>{{solverInitialIndex === 0 ? '▶ ' : ''}}{{solverPhase === 'parameter' ? solverParameter : solverTarget}} = {{solverInitialIndex === 0 ? solverInitialDisplay || '□' : solverInitialText}}</text></button><button wx:if="{{solverPhase === 'initial'}}" class="cw-solver-key solver-execute {{solverInitialIndex === 1 ? 'solver-selected' : ''}}" bindtap="solverExecute">{{solverInitialIndex === 1 ? '▶ ' : ''}}Execute</button></view>
            <view wx:elif="{{solverPhase === 'running'}}" class="cw-solver-panel"><text class="cw-solver-progress">Solving… {{solverIterations}}</text><button class="cw-solver-key" bindtap="cancelSolver">Cancel</button></view>
            <view wx:elif="{{solverPhase === 'continue'}}" class="cw-solver-panel"><button class="cw-solver-key {{solverContinueIndex === 0 ? 'solver-selected' : ''}}" bindtap="continueSolver">{{solverContinueIndex === 0 ? '▶ ' : ''}}Continue</button><button class="cw-solver-key {{solverContinueIndex === 1 ? 'solver-selected' : ''}}" bindtap="solverChangeInitial">{{solverContinueIndex === 1 ? '▶ ' : ''}}Exit</button></view>
            <view wx:elif="{{solverPhase === 'result'}}" class="cw-solver-panel"><view class="cw-solver-output"><text>{{solverTarget}} =</text><text selectable>{{solverValueText}}</text></view><view class="cw-solver-residual"><text>L−R</text><text selectable>{{solverResidualText}}</text></view><button class="cw-solver-key solver-change-initial" bindtap="solverChangeInitial">← Initial Value</button></view>
            <block wx:else>
              <input wx:if="{{typing}}" class="expression-input" data-editor-generation="{{editorGeneration}}" value="{{expression}}" cursor="{{cursor}}" focus="{{typing}}" maxlength="500" confirm-type="done" cursor-spacing="24" aria-label="算式" bindinput="onInput" bindfocus="onEditorFocus" bindblur="onEditorBlur" bindconfirm="onConfirm" />
              <scroll-view wx:else class="cw-expression-scroll {{hasResult ? 'cw-expression-result' : error ? 'cw-expression-error' : ''}}" scroll-x scroll-y scroll-into-view="{{!hasResult ? 'cw-cursor-' + cursor : ''}}" aria-label="算式，使用计算器方向键编辑">
                <view class="cw-expression" style="width:{{expressionLayout.width}}px;height:{{expressionLayout.height}}px">
                  <block wx:for="{{expressionLayout.items}}" wx:key="id">
                    <text wx:if="{{item.kind === 'text'}}" class="cw-math-glyph" style="{{item.style}}">{{item.text}}</text>
                    <view wx:else id="{{item.kind === 'caret' ? 'cw-cursor-' + cursor : 'cw-math-' + item.id}}" class="cw-math-{{item.kind}} {{item.active ? 'cw-slot-active' : ''}}" style="{{item.style}}"></view>
                  </block>
                </view>
              </scroll-view>
              <view wx:if="{{error}}" class="calculator-error" role="alert">{{error}}</view>
              <view wx:elif="{{hasResult}}" class="cw-result-row"><view wx:if="{{formatted.kind === 'fraction'}}" class="cw-fraction-result"><text wx:if="{{formatted.whole}}">{{formatted.whole}}</text><view class="lcd-fraction"><text>{{formatted.numerator}}</text><text>{{formatted.denominator}}</text></view></view><scroll-view wx:else class="result-scroll" scroll-x><text class="display-result">{{display}}</text></scroll-view></view>
            </block>
          </block>
        </view>
        <text class="cw-series">CW · LEARNING</text>
      </view>
      <view class="cw-control-grid"><block wx:for="{{controlKeys}}" wx:key="id"><template is="cw-key" data="{{key:item,control:true,numeric:false,shiftActive}}" /></block></view>
      <view class="cw-scientific"><view wx:for="{{scientificRows}}" wx:for-item="row" wx:key="id" class="cw-six-grid"><block wx:for="{{row.keys}}" wx:key="id"><template is="cw-key" data="{{key:item,control:false,numeric:false,shiftActive}}" /></block></view></view>
      <view class="calculator-keypad cw-numbers"><view wx:for="{{numberRows}}" wx:for-item="row" wx:key="id" class="cw-number-grid"><block wx:for="{{row.keys}}" wx:key="id"><template is="cw-key" data="{{key:item,control:false,numeric:true,shiftActive}}" /></block></view></view>
    </view>
    <view wx:if="{{showHistory || (isTablet && orientation === 'landscape')}}" class="history-list"><view class="history-head"><text>计算历史</text><button wx:if="{{history.length}}" class="text-button" bindtap="clearHistory">清空</button></view><button wx:for="{{history}}" wx:key="at" class="history-row" data-index="{{index}}" bindtap="restoreHistory"><view class="history-expression">{{item.expression}}</view><view class="history-result"><text>{{item.angleMode}}</text><text>= {{item.result}}</text></view></button><view wx:if="{{!history.length}}" class="empty-state">还没有计算记录</view></view>
  </view>
  <view wx:if="{{workbench}}" class="cw-sheet-backdrop" bindtap="closeWorkbench">
    <view class="cw-sheet {{workCompact ? 'cw-sheet-compact' : ''}}" style="bottom:{{keyboardHeight || 0}}px;padding-bottom:{{workCompact ? 8 : safeBottom + 12}}px" catchtap="keepDrawer">
      <view class="cw-sheet-header"><text>{{workTitle}}</text><button class="cw-sheet-close" bindtap="closeWorkbench" aria-label="关闭">×</button></view>
      <scroll-view class="cw-sheet-scroll" scroll-y scroll-into-view="{{workFieldTarget}}" style="height:{{workScrollHeight}}px">
        <view wx:if="{{workbench === 'about'}}" class="cw-about">STEMist 按 fx-991CW 键位设计的本地学习计算器，非 Casio 官方模拟器。支持科学计算、变量、函数、统计、数表、实数二次方程、二元联立方程、Solver 数值求解、比例和进制转换。Solver 每次查找一个实数解，初值会影响结果；L−R 显示残差。未实现完整 Casio 固件、复数/矩阵/分布或 QR 联网功能。数学输入与结果都在本机处理。</view>
        <view wx:for="{{workFields}}" wx:key="id" id="cw-field-{{item.id}}" class="cw-field"><text>{{item.label}}</text><input class="cw-field-input" value="{{item.value}}" data-id="{{item.id}}" data-work-generation="{{workGeneration}}" maxlength="500" adjust-position="{{false}}" confirm-type="done" bindfocus="onWorkbenchFocus" bindconfirm="onWorkbenchConfirm" bindkeyboardheightchange="onWorkbenchKeyboard" bindinput="onFieldInput" aria-label="{{item.label}}" /></view>
        <view wx:if="{{workError}}" id="cw-work-error" class="error">{{workError}}</view>
        <view wx:if="{{workResults.length}}" id="cw-results" class="cw-work-results"><view wx:for="{{workResults}}" wx:key="index"><text>{{item.label}}</text><text selectable>{{item.value}}</text></view></view>
      </scroll-view>
      <button wx:if="{{workbench !== 'about' && !workCompact}}" class="primary cw-work-submit" bindtap="submitWorkbench">{{workSubmitLabel}}</button>
    </view>
  </view>
</view>
