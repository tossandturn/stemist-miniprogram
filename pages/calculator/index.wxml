<template name="cw-key">
  <button class="calc-key cw-key cw-id-{{key.id}} {{control ? 'cw-control' : ''}} {{numeric ? 'cw-number' : ''}} {{key.tone === 'shift' ? 'cw-shift' : ''}} {{key.tone === 'alpha' ? 'cnx-alpha' : ''}} {{key.action === 'equals' ? 'calc-equals' : ''}} {{key.action === 'format' ? 'cw-format-key' : ''}} {{shiftActive && key.action === 'shift' ? 'shift-on' : ''}} {{alphaActive && key.action === 'alpha' ? 'alpha-on' : ''}} {{shiftActive && key.shiftLabel ? 'cw-alt-ready' : ''}} {{alphaActive && key.alphaLabel ? 'cnx-alpha-ready' : ''}} {{key.unavailable ? 'cw-key-limited' : ''}}" style="{{control ? 'grid-column:' + key.col + ';grid-row:' + key.row : ''}}" data-key="{{key.id}}" data-action="{{key.action || ''}}" data-value="{{key.value || ''}}" data-shift-action="{{key.shiftAction || ''}}" data-shift-value="{{key.shiftValue || ''}}" data-alpha-action="{{key.alphaAction || ''}}" data-alpha-value="{{key.alphaValue || ''}}" bindtap="press" hover-class="cw-key-pressed" hover-stay-time="80" aria-pressed="{{key.action === 'shift' ? shiftActive : key.action === 'alpha' ? alphaActive : false}}" aria-label="{{alphaActive && key.alphaLabel ? 'ALPHA ' + key.alphaLabel : shiftActive && key.shiftLabel ? 'SHIFT ' + key.shiftLabel : key.label || key.action}}">
    <text class="cw-legend cw-shift-legend {{control && !key.shiftLabel && !key.alphaLabel && key.action !== 'shift' && key.action !== 'alpha' ? 'cw-control-legend' : ''}} {{!control && key.shiftLabel ? 'cw-second-legend' : ''}}">{{control && !key.shiftLabel && !key.alphaLabel ? key.label : key.shiftLabel || ' '}}</text>
    <text wx:if="{{key.alphaLabel}}" class="cw-legend cnx-alpha-legend">{{key.alphaLabel}}</text>
    <view class="cw-key-face"><view wx:if="{{key.face}}" class="cw-glyph glyph-{{key.face}}"></view><text wx:else class="cw-key-text">{{control ? key.text : key.label}}</text></view>
  </button>
</template>

<view class="page {{deviceClass}} {{orientation}} calculator-page">
  <stemist-header compact="{{true}}" title="{{modelTitle}}" action-text="返回" bind:action="goBack" />
  <ai-fab source="calculator" />
  <view class="calculator-model-switch" role="group" aria-label="选择计算器型号">
    <button wx:for="{{calculatorModels}}" wx:key="id" class="calculator-model-option {{calculatorModel === item.id ? 'is-selected' : ''}}" data-model="{{item.id}}" bindtap="selectCalculatorModel" hover-class="calculator-model-option-pressed" hover-stay-time="80" aria-pressed="{{calculatorModel === item.id}}">{{item.selectorLabel}}</button>
  </view>
  <view class="cw-workspace">
    <view class="calculator-shell cw-instrument model-{{calculatorModel}}">
      <view class="cw-brand-row"><view><text class="cw-brand">STEMist</text><text class="cw-model">{{modelLabel}}</text></view><view class="cw-solar" aria-hidden="true"><view></view><view></view><view></view><view></view></view></view>
      <view class="cw-display-bezel">
        <view class="calculator-display {{powerOff ? 'is-off' : ''}}">
          <block wx:if="{{!powerOff}}">
            <view class="display-status"><view class="cw-indicators"><text class="cw-shift-indicator {{shiftActive ? 'cw-shift-indicator-on' : ''}}" aria-label="{{shiftActive ? 'SHIFT 已开启，下一键执行副功能' : 'SHIFT 未开启'}}">S</text><text class="cw-alpha-indicator {{alphaActive ? 'cw-alpha-indicator-on' : ''}}" aria-label="{{alphaActive ? 'ALPHA 已开启，下一键输入红色标记' : 'ALPHA 未开启'}}">A</text><text>{{angleMode === 'DEG' ? 'D' : angleMode === 'RAD' ? 'R' : 'G'}}  {{argumentMode ? 'INS' : ''}}</text></view><text>{{menu ? menuTitle : calcPhase === 'input' ? 'CALC · ' + calcVariable : calcPhase ? 'CALC' : solverPhase === 'target' ? 'Solve Target' : solverPhase === 'initial' ? 'Enter Initial Value' : solverPhase === 'parameter' ? 'Variable Value' : solverPhase ? 'Solver' : calculatorApp === 'complex' ? 'Complex' : 'Calculate'}}</text><text>{{calculatorApp === 'complex' ? (hasResult ? formatMode : complexResult) === 'polar' ? 'r∠θ' : 'a+bi' : memory ? 'M' : ''}}</text></view>
            <scroll-view wx:if="{{menu}}" class="cw-menu-scroll" scroll-y scroll-into-view="cw-menu-{{menuIndex}}">
              <view wx:if="{{menu === 'home'}}" class="cw-home-grid"><button wx:for="{{menuItems}}" wx:key="id" id="cw-menu-{{index}}" class="cw-app {{menuIndex === index ? 'menu-active' : ''}} {{item.available === false ? 'menu-unavailable' : ''}}" data-id="{{item.id}}" disabled="{{item.available === false}}" bindtap="chooseMenu"><text class="cw-app-symbol">{{item.icon}}</text><text>{{item.label}}</text><text wx:if="{{item.detail}}" class="cw-app-detail">{{item.detail}}</text></button></view>
              <block wx:else><button wx:for="{{menuItems}}" wx:key="id" id="cw-menu-{{index}}" class="cw-menu-item {{menuIndex === index ? 'menu-active' : ''}}" data-id="{{item.id}}" bindtap="chooseMenu"><text class="menu-label">{{item.label}}</text><text wx:if="{{item.detail}}" class="menu-detail">{{item.detail}}</text><text wx:else>›</text></button><view wx:if="{{!menuItems.length}}" class="cw-empty-history">No history</view></block>
            </scroll-view>
            <view wx:elif="{{calcPhase === 'input'}}" class="cw-calc-panel"><text class="cw-calc-expression">{{calcExpression}}</text><button class="cw-calc-key" bindtap="commitCalcValue"><text>{{calcVariable}} = {{calcInputDisplay || '□'}}</text><text>按 = 确认</text></button><text wx:if="{{error}}" class="cw-calc-error" role="alert">{{error}}</text></view>
            <view wx:elif="{{calcPhase === 'ready'}}" class="cw-calc-panel"><text class="cw-calc-expression">{{calcExpression}}</text><button class="cw-calc-key cw-calc-execute" bindtap="executeCalc">= Execute</button></view>
            <view wx:elif="{{solverPhase && error && solverPhase !== 'equation' && solverPhase !== 'continue'}}" class="cw-solver-panel cw-solver-error" role="alert"><text>{{error}}</text><button class="cw-solver-key" bindtap="solverDismissError">← 修改数值</button></view>
            <scroll-view wx:elif="{{solverPhase === 'target'}}" class="cw-solver-panel" scroll-y scroll-into-view="solver-target-{{solverTargetIndex}}"><button wx:for="{{solverTargets}}" wx:key="*this" id="solver-target-{{index}}" class="cw-solver-key {{solverTargetIndex === index ? 'solver-selected' : ''}}" data-name="{{item}}" bindtap="chooseSolverTarget"><text>{{solverTargetIndex === index ? '▶ ' : ''}}{{item}}</text></button></scroll-view>
            <view wx:elif="{{solverPhase === 'initial' || solverPhase === 'parameter'}}" class="cw-solver-panel"><button class="cw-solver-key solver-initial-field {{solverInitialIndex === 0 ? 'solver-selected' : ''}}" bindtap="selectSolverInitial"><text>{{solverInitialIndex === 0 ? '▶ ' : ''}}{{solverPhase === 'parameter' ? solverParameter : solverTarget}} = {{solverInitialIndex === 0 ? solverInitialDisplay || '□' : solverInitialText}}</text></button><button wx:if="{{solverPhase === 'initial'}}" class="cw-solver-key solver-execute {{solverInitialIndex === 1 ? 'solver-selected' : ''}}" bindtap="solverExecute">{{solverInitialIndex === 1 ? '▶ ' : ''}}Execute</button></view>
            <view wx:elif="{{solverPhase === 'running'}}" class="cw-solver-panel"><text class="cw-solver-progress">Solving… {{solverIterations}}</text><button class="cw-solver-key" bindtap="cancelSolver">Cancel</button></view>
            <view wx:elif="{{solverPhase === 'continue'}}" class="cw-solver-panel"><button class="cw-solver-key {{solverContinueIndex === 0 ? 'solver-selected' : ''}}" bindtap="continueSolver">{{solverContinueIndex === 0 ? '▶ ' : ''}}Continue</button><button class="cw-solver-key {{solverContinueIndex === 1 ? 'solver-selected' : ''}}" bindtap="solverChangeInitial">{{solverContinueIndex === 1 ? '▶ ' : ''}}Exit</button></view>
            <view wx:elif="{{solverPhase === 'result'}}" class="cw-solver-panel"><view class="cw-solver-output"><text>{{solverTarget}} =</text><text selectable>{{solverValueText}}</text></view><view class="cw-solver-residual"><text>L−R</text><text selectable>{{solverResidualText}}</text></view><button class="cw-solver-key solver-change-initial" bindtap="solverChangeInitial">← Initial Value</button></view>
            <block wx:else>
              <input wx:if="{{typing}}" class="expression-input" data-editor-generation="{{editorGeneration}}" value="{{expression}}" cursor="{{cursor}}" focus="{{typing}}" maxlength="500" confirm-type="done" cursor-spacing="24" aria-label="算式" bindinput="onInput" bindfocus="onEditorFocus" bindblur="onEditorBlur" bindconfirm="onConfirm" />
              <scroll-view wx:else class="cw-expression-scroll {{hasResult ? 'cw-expression-result' : error ? 'cw-expression-error' : ''}}" scroll-x scroll-y scroll-into-view="{{!hasResult ? 'cw-cursor-' + cursor : ''}}" data-expression-revision="{{expressionRevision}}" bindtap="onExpressionTap" bindtouchstart="onExpressionTouchStart" bindtouchmove="onExpressionTouchMove" bindtouchend="onExpressionTouchEnd" bindtouchcancel="cancelExpressionTouch" bindlongpress="cancelExpressionTouch" bindscroll="onExpressionScroll" aria-label="算式，轻点定位光标，也可使用方向键编辑">
                <view class="cw-expression" style="width:{{expressionLayout.width}}px;height:{{expressionLayout.height}}px">
                  <block wx:for="{{expressionLayout.items}}" wx:key="id">
                    <text wx:if="{{item.kind === 'text'}}" id="cw-math-{{item.id}}" class="cw-math-glyph" style="{{item.style}}">{{item.text}}</text>
                    <view wx:else id="{{item.kind === 'caret' ? 'cw-cursor-' + cursor : 'cw-math-' + item.id}}" class="cw-math-{{item.kind}} {{item.active ? 'cw-slot-active' : ''}}" style="{{item.style}}"></view>
                  </block>
                </view>
              </scroll-view>
              <view wx:if="{{error}}" class="calculator-error" role="alert">{{error}}</view>
              <view wx:elif="{{hasResult}}" class="cw-result-row"><view wx:if="{{formatted.kind === 'fraction'}}" class="cw-fraction-result"><text wx:if="{{formatted.whole}}">{{formatted.whole}}</text><view class="lcd-fraction"><text>{{formatted.numerator}}</text><text>{{formatted.denominator}}</text></view></view><scroll-view wx:else class="result-scroll" scroll-x><text class="display-result">{{display}}</text></scroll-view></view>
            </block>
          </block>
        </view>
        <text class="cw-series">{{modelSeries}}</text>
      </view>
      <view class="cw-control-grid"><view class="cw-direction-pad" aria-hidden="true"></view><view class="cw-page-rocker" aria-hidden="true"></view><block wx:for="{{controlKeys}}" wx:key="id"><template is="cw-key" data="{{key:item,control:true,numeric:false,shiftActive,alphaActive}}" /></block></view>
      <view class="cw-scientific"><view wx:for="{{scientificRows}}" wx:for-item="row" wx:key="id" class="cw-six-grid"><block wx:for="{{row.keys}}" wx:key="id"><template is="cw-key" data="{{key:item,control:false,numeric:false,shiftActive,alphaActive}}" /></block></view></view>
      <view class="calculator-keypad cw-numbers"><view wx:for="{{numberRows}}" wx:for-item="row" wx:key="id" class="cw-number-grid"><block wx:for="{{row.keys}}" wx:key="id"><template is="cw-key" data="{{key:item,control:false,numeric:true,shiftActive,alphaActive}}" /></block></view></view>
    </view>
    <view wx:if="{{showHistory || (isTablet && orientation === 'landscape')}}" class="history-list"><view class="history-head"><text>计算历史</text><button wx:if="{{history.length}}" class="text-button" bindtap="clearHistory">清空</button></view><button wx:for="{{history}}" wx:key="at" class="history-row" data-index="{{index}}" bindtap="restoreHistory"><view class="history-expression">{{item.expression}}</view><view class="history-result"><text>{{item.angleMode}}</text><text>= {{item.result}}</text></view></button><view wx:if="{{!history.length}}" class="empty-state">还没有计算记录</view></view>
  </view>
  <view wx:if="{{workbench}}" class="cw-sheet-backdrop" bindtap="closeWorkbench">
    <view class="cw-sheet {{workCompact ? 'cw-sheet-compact' : ''}}" style="bottom:{{keyboardHeight || 0}}px;padding-bottom:{{workCompact ? 8 : safeBottom + 12}}px" catchtap="keepDrawer">
      <view class="cw-sheet-header"><text>{{workTitle}}</text><button class="cw-sheet-close" bindtap="closeWorkbench" aria-label="关闭">×</button></view>
      <scroll-view class="cw-sheet-scroll" scroll-y scroll-into-view="{{workFieldTarget}}" style="height:{{workScrollHeight}}px">
        <view wx:if="{{workbench === 'about' && calculatorModel === 'cw'}}" class="cw-about">STEMist 按 fx-991CW 键位设计的本地学习计算器，非 Casio 官方模拟器。支持科学计算、Complex 复数、变量、函数、统计、数表、实数二次方程、二元联立方程、Solver、比例和进制转换。Complex 支持 a+bi / r∠θ、整数幂、平方根、共轭、模、幅角与实虚部；数值使用双精度近似，不宣称原厂符号或精度引擎。Solver 每次查找一个实数解，初值会影响结果；L−R 显示残差。未实现完整 Casio 固件、矩阵或分布。数学输入与结果都在本机处理。</view>
        <view wx:elif="{{workbench === 'about'}}" class="cw-about">STEMist 依据 fx-991CN X 中文版按键与菜单习惯制作的本地学习实现，非 Casio 官方模拟器。支持自然公式、SHIFT / ALPHA、实数变量 CALC、牛顿近似 SOLVE、Complex、统计、表格、方程、比例和进制转换。矩阵、向量、不等式、积分/微分、单位换算、随机数及完整原厂固件未实现，并在菜单或按键上明确标记，不会伪造结果。输入、变量、Ans、记忆和历史均只在本机处理。</view>
        <view wx:for="{{workFields}}" wx:key="id" id="cw-field-{{item.id}}" class="cw-field"><text>{{item.label}}</text><input class="cw-field-input" value="{{item.value}}" data-id="{{item.id}}" data-work-generation="{{workGeneration}}" maxlength="500" adjust-position="{{false}}" confirm-type="done" bindfocus="onWorkbenchFocus" bindconfirm="onWorkbenchConfirm" bindkeyboardheightchange="onWorkbenchKeyboard" bindinput="onFieldInput" aria-label="{{item.label}}" /></view>
        <view wx:if="{{workError}}" id="cw-work-error" class="error">{{workError}}</view>
        <view wx:if="{{workResults.length}}" id="cw-results" class="cw-work-results"><view wx:for="{{workResults}}" wx:key="index"><text>{{item.label}}</text><text selectable>{{item.value}}</text></view></view>
      </scroll-view>
      <button wx:if="{{workbench !== 'about' && !workCompact}}" class="primary cw-work-submit" bindtap="submitWorkbench">{{workSubmitLabel}}</button>
    </view>
  </view>
</view>
