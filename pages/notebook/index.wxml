<view class="page {{deviceClass}} {{orientation}} notebook-page">
  <stemist-header eyebrow="STEMIST · NOTEBOOK" title="笔记本" />
  <app-nav active="progress" source="notebook" category="{{category}}" family="{{family}}" route-id="{{routeId}}" stage="{{stage}}" subject-code="{{subjectCode}}" is-tablet="{{isTablet}}" />
  <view class="context-card notebook-context">
    <view class="context-card-title">{{categoryLabel}} · 选择路线</view>
    <picker mode="selector" range="{{routes}}" range-key="pickerLabel" value="{{routeIndex}}" bindchange="chooseRoutePicker"><view class="route-picker">{{routes[routeIndex].pickerLabel || '请选择一条路线'}}<text class="route-picker-chevron">切换</text></view></picker>
  </view>
  <view class="panel notebook-editor">
    <view class="field-label">笔记</view>
    <textarea value="{{note}}" maxlength="20000" cursor-spacing="24" adjust-position="true" show-confirm-bar="true" placeholder="写下笔记或错题思路…" bindinput="onInput" />
    <view class="editor-status">{{status}}<text>{{note.length}} 字符</text></view>
    <button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{saving ? '同步中…' : '保存'}}</button>
    <button class="secondary" bindtap="clear" disabled="{{saving}}">清空当前笔记</button>
  </view>
  <view wx:if="{{error}}" class="warning">{{error}}</view>
</view>
