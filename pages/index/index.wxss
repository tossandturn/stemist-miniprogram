.home-page { max-width: 1080px; }
.home-brand { display: flex; align-items: center; min-height: 44px; padding-right: 124px; }
.home-heading { margin: 36px 0 24px; font-size: 26px; line-height: 1.3; font-weight: 750; color: #18213d; }
.entry-grid { display: flex; flex-wrap: wrap; margin: -6px; }
.entry-card { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; width: calc(50% - 12px); min-height: 184px; margin: 6px; padding: 22px 16px; border: 1px solid #e4e7f0; border-radius: 18px; background: #fff; text-align: left; box-shadow: 0 3px 14px rgba(28, 36, 70, .03); }
.entry-card:active { background: #f5f2ff; }
.entry-mark { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; margin-bottom: 26px; border-radius: 12px; color: #6a4ce4; background: #efebff; }
.entry-mark-inner { width: 19px; height: 19px; border: 2px solid currentColor; border-radius: 50%; }
.entry-ielts .entry-mark { color: #ad3c69; background: #fff0f5; }
.entry-ielts .entry-mark-inner { border-radius: 3px; border-bottom-width: 5px; }
.entry-competition .entry-mark { color: #15775e; background: #e7f6f0; }
.entry-competition .entry-mark-inner { border-radius: 2px 2px 9px 9px; }
.entry-calculator .entry-mark { color: #a65d12; background: #fff1df; }
.entry-calculator .entry-mark-inner { border-radius: 4px; border-top-width: 6px; }
.entry-title { display: block; color: #18213d; font-size: 17px; font-weight: 750; line-height: 1.4; }
.entry-detail { display: block; margin-top: 9px; color: #66708a; font-size: 12px; line-height: 1.6; white-space: normal; }
.home-account { display: flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 28px; color: #66708a; font-size: 13px; }
.device-tablet .entry-card { min-height: 216px; padding: 26px; }
.device-tablet .home-heading { margin-top: 44px; font-size: 32px; }
.device-tablet .entry-title { font-size: 21px; }
.device-tablet .entry-detail { font-size: 14px; }
.home-page .entry-grid .entry-card { width: calc(50% - 12px); min-width: 0; margin: 6px; }
