<view class="page {{deviceClass}} {{orientation}} home-page">
  <view class="home-brand"><view class="brand-mark">S</view><text class="brand-title">STEMist</text></view>
  <ai-fab source="home" />
  <view class="home-announcement" bindtap="openAnnouncements" hover-class="home-announcement-pressed" hover-stay-time="100" role="button" aria-label="打开公告中心">
    <view class="home-announcement-head"><view><text class="home-announcement-label">公告中心</text><text wx:if="{{announcementUnread}}" class="home-announcement-unread">新公告</text></view><text class="home-announcement-link">查看全部</text></view>
    <view wx:if="{{announcementLoading}}" class="home-announcement-loading" role="status">正在读取最新公告…</view>
    <block wx:elif="{{announcement}}"><text class="home-announcement-title">{{announcement.title}}</text><text class="home-announcement-summary">{{announcement.summary}}</text><text class="home-announcement-date">{{announcement.categoryLabel}} · {{announcement.publishedLabel}}</text></block>
    <text wx:elif="{{announcementError}}" class="home-announcement-summary">公告暂未加载，点击重试。</text>
    <text wx:else class="home-announcement-summary">暂无公告</text>
  </view>
  <view class="home-heading">今天想学什么？</view>
  <view class="entry-grid">
    <button wx:for="{{entryPoints}}" wx:key="id" class="entry-card entry-{{item.tone}}" data-entry="{{item.id}}" bindtap="openEntry" loading="{{entryLoading === item.id}}" disabled="{{!!entryLoading}}">
      <view class="entry-mark" aria-hidden="true"><view class="entry-mark-inner"></view></view>
      <text class="entry-title">{{item.title}}</text>
      <text class="entry-detail">{{item.detail}}</text>
    </button>
  </view>
  <view wx:if="{{entryError}}" class="error">{{entryError}}</view>
  <navigator class="home-account" url="/pages/account/auth">我的学习记录与账号</navigator>
  <button class="home-share secondary" open-type="share">分享给好友</button>
</view>
