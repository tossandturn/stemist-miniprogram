.configured-page{max-width:900px}.configured-status{margin-top:20px;padding:28px 20px;border:1px solid #e4e7f0;border-radius:18px;background:#fff;text-align:center;box-shadow:0 8px 24px rgba(42,31,89,.05)}.configured-status-title,.configured-status-detail,.configured-section-title,.configured-section-text,.configured-link-label,.configured-link-detail{display:block}.configured-status-title{color:#18213d;font-size:18px;font-weight:750}.configured-status-detail{margin-top:9px;color:#66708a;font-size:14px;line-height:1.65}.configured-sections{display:grid;grid-template-columns:minmax(0,1fr);gap:14px}.configured-section{min-width:0;padding:20px;border:1px solid #e4e7f0;border-radius:18px;background:#fff;box-shadow:0 8px 24px rgba(42,31,89,.04)}.configured-notice{border-color:#ddd7f5;background:#f7f4ff}.configured-notice.notice-warning{border-color:#efd9b9;background:#fff7e9}.configured-section-title{margin-bottom:10px;color:#18213d;font-size:18px;font-weight:750;line-height:1.4}.configured-section-text{color:#485370;font-size:16px;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere}.configured-links{display:grid;grid-template-columns:minmax(0,1fr);gap:10px}.configured-link{display:flex;flex-direction:column;align-items:flex-start;width:100%;min-width:0;min-height:56px;margin:0;padding:13px 15px;border:1px solid #ddd7f5;border-radius:14px;color:#18213d;background:#faf9ff;text-align:left}.configured-link:active{border-color:#7357e8;background:#f0ecff}.configured-link-label{color:#5638c3;font-size:15px;font-weight:750;line-height:1.45}.configured-link-detail{margin-top:4px;color:#66708a;font-size:13px;line-height:1.55;white-space:normal}.configured-page button.configured-share,.configured-page button.configured-retry{min-height:46px}.configured-home{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:12px;color:#5638c3;font-size:14px;font-weight:700}.device-tablet .configured-sections{gap:18px}.device-tablet .configured-section{padding:26px}.device-tablet .configured-links{grid-template-columns:repeat(2,minmax(0,1fr))}@media(max-width:375px){.configured-section{padding:17px}.configured-section-text{font-size:15px}}
.configured-page .configured-links button.configured-link{width:100%;max-width:none;margin:0;justify-self:stretch;align-self:stretch}.configured-link-detail{font-weight:400}
