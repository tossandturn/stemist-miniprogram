.marking-intro{margin-top:12px;color:#66708a}.marking-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}.marking-inputs,.marking-output{min-width:0}.file-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:12px 0}.file-actions button{flex:1;min-width:120px;margin:0}.subtle{display:block;color:#66708a;font-size:13px;line-height:1.6;margin:8px 0}.file-row{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:12px 0;border-bottom:1px solid #e4e7f0}.page-thumb{width:72px;height:96px;background:#f5f6fb;flex-shrink:0}.file-copy{flex:1;min-width:100px}.file-copy text{display:block}.file-name{overflow-wrap:anywhere;word-break:break-all;font-size:14px}.file-buttons{display:flex;gap:8px;flex-wrap:wrap;width:100%}.file-buttons button{min-height:44px;padding:8px 14px;font-size:14px;background:#f0ecff;color:#5638c3}.reference-title{margin-top:24px}.history-item{display:flex;justify-content:space-between;gap:12px;width:100%;margin-top:12px;text-align:left;background:#f5f6fb}.report-score{font-size:32px;color:#5638c3;margin:16px 0}.report-score text{font-size:14px}.question-result{margin-top:18px;padding-top:16px;border-top:1px solid #e4e7f0}.device-tablet.landscape .marking-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.marking-page textarea{min-height:110px}
