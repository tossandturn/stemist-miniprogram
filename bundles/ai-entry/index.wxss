.ai-entry-page{max-width:900px}.ai-entry-intro,.ai-entry-ready,.ai-entry-error{margin-top:16px;padding:20px;border:1px solid #e4e7f0;border-radius:18px;background:#fff;box-shadow:0 8px 24px rgba(42,31,89,.05)}.ai-entry-title,.ai-entry-detail,.ai-entry-choice-title,.ai-entry-choice-detail,.ai-entry-choice-meta,.ai-entry-ready-label,.ai-entry-ready-title,.ai-entry-ready-detail,.ai-entry-note,.ai-entry-error-title{display:block}.ai-entry-title{color:#18213d;font-size:20px;font-weight:750}.ai-entry-detail{margin-top:7px;color:#66708a;font-size:14px;line-height:1.6}.ai-entry-list{display:grid;grid-template-columns:minmax(0,1fr);gap:12px;margin-top:16px}.ai-entry-choice{display:flex;flex-direction:column;align-items:flex-start;width:100%;min-height:72px;margin:0;padding:15px 16px;border:1px solid #ddd7f5;border-radius:16px;background:#fff;text-align:left}.ai-entry-choice:active{border-color:#7357e8;background:#f4f1ff}.ai-entry-choice-title{color:#18213d;font-size:16px;font-weight:750;line-height:1.4}.ai-entry-choice-detail{margin-top:4px;color:#66708a;font-size:14px;line-height:1.5}.ai-entry-choice-meta{margin-top:7px;color:#5638c3;font-size:12px;line-height:1.4}.ai-entry-ready{text-align:center}.ai-entry-ready-label{color:#66708a;font-size:13px}.ai-entry-ready-title{margin-top:7px;color:#18213d;font-size:22px;font-weight:800}.ai-entry-ready-detail{margin-top:7px;color:#66708a;font-size:15px;line-height:1.6}.ai-entry-page button.ai-entry-open{width:100%;min-height:48px;margin-top:18px}.ai-entry-note{margin-top:12px;color:#66708a;font-size:12px;line-height:1.6}.ai-entry-error{text-align:center}.ai-entry-error-title{color:#9b2c2c;font-size:15px;line-height:1.6}.ai-entry-home{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:12px;color:#5638c3;font-size:14px;font-weight:700}.device-tablet .ai-entry-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.device-tablet .ai-entry-intro,.device-tablet .ai-entry-ready,.device-tablet .ai-entry-error{padding:26px}@media(max-width:375px){.ai-entry-intro,.ai-entry-ready,.ai-entry-error{padding:17px}.ai-entry-choice{padding:14px}}
