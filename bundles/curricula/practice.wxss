.loading-state{margin:24px 0;padding:20px;border:1px solid #e4e7f0;border-radius:14px;background:#fff;color:#66708a;text-align:center}.setup-layout{display:grid;gap:16px}.practice-intro,.setup-card,.history-card,.answer-card,.result-card{padding:18px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}.practice-title,.section-title{display:block;color:#18213d;font-size:20px;font-weight:750}.practice-copy{display:block;margin-top:8px;color:#66708a;font-size:14px;line-height:1.65}.authority-badge,.quality-badge{display:inline-block;margin-top:10px;padding:5px 9px;border-radius:999px;background:#fff6e8;color:#865f1e;font-size:12px;font-weight:700}.resume-card{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:52px;margin:0;padding:12px 16px;border:1px solid #d9d2f5;background:#f0ecff;color:#5638c3;text-align:left}.resume-card text:last-child{color:#66708a;font-size:12px;font-weight:500}.field-label{display:block;margin:16px 0 7px;color:#485370;font-size:13px;font-weight:650}.field-label:first-child{margin-top:0}.field-control{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px;padding:11px 13px;border:1px solid #dde2ef;border-radius:12px;color:#18213d;background:#fff;font-size:14px}.field-control text:first-child{min-width:0;overflow-wrap:anywhere}.field-control text:last-child{flex:0 0 auto;color:#66708a;font-size:12px}.count-options,.answer-options{display:flex;flex-wrap:wrap;gap:8px}.count-option{width:auto;min-width:64px;min-height:44px;margin:0;border:1px solid #e4e7f0;background:#f5f6fb;color:#485370}.count-option.selected,.answer-option.selected{border-color:#7357e8;background:#f0ecff;color:#5638c3}.start-practice{margin-top:18px}.history-row{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:48px;margin:10px 0 0;padding:10px 12px;border:1px solid #e4e7f0;background:#fff;color:#18213d;text-align:left}.history-row text:last-child{color:#5638c3;font-weight:700}.practice-progress{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:20px 0 14px;color:#18213d;font-size:14px;font-weight:700}.practice-progress text:last-child{color:#66708a;font-size:13px}.practice-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,1fr);gap:20px;align-items:start}.question-pane,.answer-pane{min-width:0}.question-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}.question-title{display:block;color:#18213d;font-size:19px;font-weight:750}.question-source{display:block;margin-top:4px;color:#66708a;font-size:12px;overflow-wrap:anywhere}.quality-badge{flex:0 0 auto;margin-top:0}.source-region{position:relative;min-height:96px;margin-bottom:12px;overflow:hidden;border:1px solid #e4e7f0;border-radius:12px;background:#fff}.question-image{display:block;width:100%}.image-state{padding:28px 16px;color:#66708a;text-align:center;font-size:13px}.image-state .text-button{display:block;margin:8px auto 0}.answer-card{margin:0}.answer-help{display:block;margin-top:6px;color:#66708a;font-size:13px}.answer-options{margin-top:14px}.answer-option{flex:1 1 56px;width:auto;min-width:56px;min-height:48px;margin:0;border:1px solid #dfe3ee;background:#fff;color:#18213d;font-size:17px;font-weight:750}.saved-state{display:block;margin-top:12px;color:#0f8668;font-size:12px}.result-card{margin-top:14px;background:#f5f6fb}.result-scope,.question-result{display:block;margin-top:7px;color:#66708a;font-size:13px;line-height:1.55}.question-result{color:#18213d;font-weight:650}.question-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}.question-actions button{width:100%;min-width:0;margin:0}.question-actions .submit-practice,.question-actions button:last-child:nth-child(3){grid-column:1/-1}.device-tablet.landscape .practice-layout{grid-template-columns:minmax(0,1.55fr) minmax(300px,1fr)}.device-tablet.portrait .practice-layout,.device-phone .practice-layout{display:block}.device-tablet.portrait .answer-pane,.device-phone .answer-pane{margin-top:16px}@media(max-width:480px){.question-head{display:block}.quality-badge{margin-top:8px}.resume-card{display:block}.resume-card text{display:block}.resume-card text:last-child{margin-top:4px}.question-actions{grid-template-columns:1fr 1fr}}
.retry-question{width:auto;min-height:44px;margin:12px 0}
