.curriculum-intro{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:18px;padding:18px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}.curriculum-title{display:block;color:#18213d;font-size:22px;font-weight:750}.curriculum-copy{display:block;max-width:720px;margin-top:6px;color:#66708a;font-size:14px;line-height:1.65}.curriculum-page button.curriculum-share{flex:0 0 auto;width:auto;min-width:112px;margin:0}.filter-panel{display:flex;flex-wrap:wrap;margin:-4px}.filter-panel picker{flex:1;min-width:136px;margin:4px}.filter-select{display:flex;align-items:center;justify-content:space-between;min-height:48px;padding:12px;border:1px solid #dde2ef;border-radius:12px;color:#18213d;background:#fff;font-size:14px;font-weight:650}.filter-select text:first-child{flex:1;min-width:0;overflow-wrap:anywhere}.filter-chevron{margin-left:10px;color:#675187;font-size:12px}.search-box{display:flex;width:calc(100% - 8px);margin:8px 4px 4px}.search-box input{flex:1;min-width:0;height:48px;padding:0 14px;border:1px solid #dde2ef;border-radius:12px 0 0 12px;background:#fff;color:#18213d;font-size:15px}.search-action{width:auto;min-width:72px;min-height:48px;margin:0;border-radius:0 12px 12px 0;color:#fff;background:#6848d7;font-size:14px}.filter-reset{margin-top:10px}.loading-state,.catalog-summary{margin:20px 0 12px;color:#66708a;font-size:13px}.catalog-summary{display:flex;flex-wrap:wrap;gap:8px}.catalog-summary text{padding:6px 10px;border-radius:999px;background:#eeebfa;color:#5638c3;font-weight:650}.paper-list{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}.paper-card{min-width:0;padding:18px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}.paper-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.paper-heading{min-width:0}.paper-course{display:block;color:#5638c3;font-size:13px;font-weight:700}.paper-title{display:block;margin-top:5px;color:#18213d;font-size:17px;font-weight:750;line-height:1.45;overflow-wrap:anywhere}.pair-badge{flex:0 0 auto;padding:5px 8px;border-radius:999px;background:#edf7f3;color:#15745b;font-size:11px;font-weight:700}.pair-candidate{background:#fff5e8;color:#8b5316}.pair-missing{background:#f1f2f6;color:#66708a}.paper-meta,.paper-detail,.paper-notice{display:block;margin-top:8px;color:#66708a;font-size:13px;line-height:1.55}.document-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;padding-top:14px;border-top:1px solid #edf0f5}.document-copy{min-width:0}.document-title{display:block;color:#18213d;font-size:14px;font-weight:700}.document-meta{display:block;margin-top:3px;color:#66708a;font-size:12px}.document-action{width:auto;min-width:104px;min-height:44px;margin:0;padding:9px 12px;color:#5638c3;background:#f0ecff;font-size:13px}.source-action{color:#315f84;background:#edf6fc}.source-only{margin-top:14px;padding:12px;border-radius:12px;background:#f5f6fb;color:#66708a;font-size:13px;line-height:1.55}.source-only-title{display:block;color:#44506a;font-weight:700}.paper-card pdf-download-progress{display:block;width:100%;margin-top:12px}.paper-pagination{display:flex;align-items:center;justify-content:center;gap:12px;margin:20px 0}.paper-pagination button.secondary{width:auto;min-width:92px;min-height:44px;margin:0}.empty-state button{margin-top:12px}.device-tablet.landscape .paper-list{grid-template-columns:repeat(2,minmax(0,1fr))}.device-tablet .search-box{flex:2;width:auto;min-width:260px;margin-top:4px}@media(max-width:480px){.curriculum-intro{display:block}.curriculum-page button.curriculum-share{margin-top:12px}.paper-head{display:block}.pair-badge{display:inline-block;margin-top:8px}.document-row{align-items:flex-start}.document-action{min-width:96px}.curriculum-title{font-size:20px}}
.variant-note{display:block;margin-top:4px;color:#754785;font-size:12px}
.document-status{flex:0 0 auto;color:#66708a;font-size:12px}
