.university-actions{display:flex;flex-wrap:wrap;gap:8px;min-width:0;max-width:100%}.university-page button.requirements-toggle{width:auto;max-width:100%;min-width:92px;min-height:44px;flex:0 1 auto;margin:0;padding:10px 12px;color:#fff;background:#6848d7;font-size:13px;line-height:1.5}
