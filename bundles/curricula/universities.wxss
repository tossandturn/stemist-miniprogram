.university-page{max-width:1040px}
.directory-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:8px;margin:8px 0 16px}
.directory-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));min-width:0;gap:8px}
.university-page button.directory-tab{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;max-width:100%;min-width:0;min-height:48px;margin:0;padding:10px 4px;line-height:1.4;border:1px solid #e4e7f0;color:#66708a;background:#fff}
.university-page button.directory-tab.active{border-color:#7357e8;color:#5638c3;background:#f0ecff}
.university-page button.directory-share{width:auto;max-width:100%;min-width:60px;min-height:48px;margin:0;padding:8px 4px;white-space:nowrap}
.directory-loading{margin:36px 0;color:#66708a;text-align:center}
.retry-action{margin-top:12px}.cache-notice{margin:12px 0}
.ranking-toolbar{margin-top:8px}
.ranking-select{display:flex;align-items:center;justify-content:space-between;min-height:48px;padding:12px 14px;border:1px solid #dde2ef;border-radius:12px;color:#18213d;background:#fff;font-size:15px}
.ranking-select text:first-child{flex:1;min-width:0;overflow-wrap:anywhere}
.select-hint{flex:0 0 auto;margin-left:12px;color:#5638c3;font-size:12px}
.ranking-meta{margin:12px 0}
.ranking-meta-summary{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.ranking-edition{display:block;color:#66708a;font-size:12px}
.verified-badge{padding:4px 8px;border-radius:999px;color:#16735f;background:#e7f8f0;font-size:11px;font-weight:700}
.source-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
.university-page .source-actions button.source-copy{width:100%;max-width:100%;min-width:0;min-height:44px;margin:0;padding:8px;color:#5638c3;background:#f0ecff;font-size:13px}
.ranking-search{margin-top:12px}
.search-row{display:flex;min-width:0}
.search-row input{flex:1;min-width:0;min-height:48px;height:auto;padding:0 14px;border:1px solid #dde2ef;border-radius:12px 0 0 12px;color:#18213d;background:#fff;font-size:15px}
.university-page .search-row button{flex:0 0 auto;width:auto;min-width:72px;min-height:48px;margin:0;padding:10px 12px;border-radius:0 12px 12px 0;color:#fff;background:#6848d7;font-size:14px;white-space:nowrap}
.search-clear{margin-left:auto}
.result-summary{display:flex;justify-content:space-between;gap:12px;margin:16px 2px 8px;color:#66708a;font-size:12px}
.university-list{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}
.university-card{min-width:0;padding:16px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}
.university-main{display:grid;grid-template-columns:max-content minmax(0,1fr);align-items:start;gap:12px}
.rank-mark{display:flex;align-items:center;justify-content:center;min-width:48px;min-height:48px;padding:8px;border-radius:12px;color:#5638c3;background:#f0ecff;font-size:17px;font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}
.university-copy{min-width:0}
.university-name-zh{display:block;color:#18213d;font-size:16px;font-weight:750;line-height:1.5;overflow-wrap:anywhere}
.university-name-en{display:block;margin-top:4px;color:#485370;font-size:13px;line-height:1.5;overflow-wrap:anywhere}
.university-country{display:block;margin-top:6px;color:#66708a;font-size:12px;line-height:1.5;overflow-wrap:anywhere}
.university-footer{display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px;margin-top:12px;padding-top:12px;border-top:1px solid #e4e7f0}
.university-host{flex:1 1 120px;min-width:0;color:#5638c3;font-size:12px;line-height:1.5;overflow-wrap:anywhere}
.university-page button.website-copy{width:auto;max-width:100%;min-width:92px;min-height:44px;flex:0 0 auto;margin:0;padding:10px 12px;color:#5638c3;background:#f0ecff;font-size:13px;line-height:1.5}
.directory-pagination{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:12px;margin:20px 0}
.university-page .directory-pagination button.secondary{width:100%;max-width:100%;min-width:0;min-height:44px;margin:0;padding:10px 8px}
.board-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:16px 0}
.university-page button.board-tab{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;max-width:100%;min-width:0;min-height:48px;margin:0;padding:10px 4px;border:1px solid #e4e7f0;color:#66708a;background:#fff;line-height:1.4}
.university-page button.board-tab.active{border-color:#7357e8;color:#5638c3;background:#f0ecff}
.official-card{max-width:680px;margin:16px auto 0;padding:22px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}
.official-label{display:block;color:#5638c3;font-size:13px;font-weight:700}
.official-organization{display:block;margin-top:8px;color:#18213d;font-size:21px;font-weight:750;line-height:1.4;overflow-wrap:anywhere}
.official-host{display:block;margin-top:12px;color:#66708a;font-size:14px;overflow-wrap:anywhere}
.university-page button.official-copy{width:100%;max-width:320px;min-width:0;min-height:48px;margin:20px 0 0}
.official-note{display:block;margin-top:10px;color:#66708a;font-size:12px}
.device-tablet.landscape .university-list{grid-template-columns:repeat(2,minmax(0,1fr))}
