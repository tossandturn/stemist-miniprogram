.university-page{max-width:1040px}.directory-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;margin:8px 0 12px}.directory-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.directory-tab{width:100%;min-height:48px;margin:0;border:1px solid #e4e7f0;color:#66708a;background:#fff}.directory-tab.active{border-color:#7357e8;color:#5638c3;background:#f0ecff}.university-page button.directory-share{width:auto;min-width:60px;min-height:48px;margin:0;padding:8px}.directory-loading{margin:36px 0;color:#66708a;text-align:center}.retry-action{margin-top:12px}.cache-notice{margin:12px 0}.ranking-toolbar,.ranking-search,.ranking-meta,.official-card{margin-top:12px;padding:14px 16px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}.control-label{display:block;margin-bottom:8px;color:#485370;font-size:14px;font-weight:700}.ranking-select{display:flex;align-items:center;justify-content:space-between;min-height:48px;padding:12px 14px;border:1px solid #dde2ef;border-radius:12px;color:#18213d;background:#fff;font-size:15px}.ranking-select text:first-child{min-width:0;overflow-wrap:anywhere}.select-hint{flex:0 0 auto;margin-left:12px;color:#5638c3;font-size:12px}.ranking-meta-summary{display:flex;align-items:center;justify-content:space-between;gap:10px}.ranking-edition{display:block;color:#66708a;font-size:12px}.verified-badge{flex:0 0 auto;padding:5px 8px;border-radius:999px;color:#16735f;background:#e7f8f0;font-size:11px;font-weight:700}.source-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}.source-actions button.source-copy{width:100%;min-width:0;min-height:44px;margin:0;padding:8px;color:#5638c3;background:#f0ecff;font-size:13px}.website-copy{flex:0 0 auto;width:auto;min-width:92px;min-height:44px;margin:0;padding:9px 12px;color:#5638c3;background:#f0ecff;font-size:13px}.search-row{display:flex}.search-row input{flex:1;min-width:0;height:48px;padding:0 14px;border:1px solid #dde2ef;border-radius:12px 0 0 12px;color:#18213d;background:#fff;font-size:15px}.search-row button{width:auto;min-width:72px;min-height:48px;margin:0;border-radius:0 12px 12px 0;color:#fff;background:#6848d7;font-size:14px}.search-clear{margin-left:auto}.result-summary{display:flex;justify-content:space-between;gap:12px;margin:14px 2px 8px;color:#66708a;font-size:12px}.university-list{display:grid;grid-template-columns:minmax(0,1fr);gap:10px}.university-card{display:grid;grid-template-columns:52px minmax(0,1fr) auto;align-items:center;gap:12px;min-width:0;padding:14px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}.rank-mark{display:flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;color:#5638c3;background:#f0ecff;font-size:17px;font-weight:800}.university-copy{min-width:0}.university-name-zh{display:block;color:#18213d;font-size:16px;font-weight:750;line-height:1.4}.university-name-en{display:block;margin-top:3px;color:#485370;font-size:13px;line-height:1.45;overflow-wrap:anywhere}.university-country,.university-host{display:block;margin-top:4px;color:#66708a;font-size:12px;line-height:1.4;overflow-wrap:anywhere}.university-host{color:#5638c3}.directory-pagination{display:flex;align-items:center;justify-content:center;gap:12px;margin:20px 0}.directory-pagination button.secondary{width:auto;min-width:92px;min-height:44px;margin:0}.board-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:16px 0}.board-tab{width:100%;min-height:48px;margin:0;border:1px solid #e4e7f0;color:#66708a;background:#fff}.board-tab.active{border-color:#7357e8;color:#5638c3;background:#f0ecff}.official-card{padding:22px}.official-label{display:block;color:#5638c3;font-size:13px;font-weight:700}.official-organization{display:block;margin-top:8px;color:#18213d;font-size:21px;font-weight:750;line-height:1.4}.official-host{display:block;margin-top:10px;color:#66708a;font-size:14px;overflow-wrap:anywhere}.university-page button.official-copy{max-width:320px;min-height:48px}.official-note{display:block;margin-top:10px;color:#66708a;font-size:12px}.device-tablet.landscape .university-list{grid-template-columns:repeat(2,minmax(0,1fr))}@media(max-width:520px){.ranking-meta-summary{display:block}.verified-badge{display:inline-block;margin-top:8px}.university-card{grid-template-columns:46px minmax(0,1fr)}.rank-mark{width:46px;height:46px}.website-copy{grid-column:2;width:100%;margin-top:4px}.board-tabs{grid-template-columns:minmax(0,1fr)}}
