<view class="page {{deviceClass}} {{orientation}} ielts-downloads">
 <stemist-header compact="{{true}}" title="剑雅真题下载" action-text="返回" bind:action="back"/>
 <view class="quota-note">免费账号每天 2 份，题目与答案合计；会员不限份数。打开本地缓存不扣次数。</view>
 <picker range="{{books}}" range-key="label" value="{{bookIndex}}" bindchange="chooseBook"><view class="book-picker">{{books[bookIndex].label || '选择书册'}}<text>更换书册</text></view></picker>
 <view class="modules"><button wx:for="{{modules}}" wx:key="id" class="{{module === item.id ? 'selected' : ''}}" data-module="{{item.id}}" bindtap="chooseModule">{{item.label}}</button></view>
 <view wx:if="{{loading}}" class="loading-state">正在加载下载目录…</view>
 <view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">刷新目录</button></view>
 <text wx:if="{{!loading}}" class="count">{{total}} 份题目</text>
 <view class="papers"><view wx:for="{{items}}" wx:key="id" class="paper">
  <text class="paper-title">{{item.meta}}</text><text class="paper-source">{{item.title}}</text>
  <view class="file-row"><view><text>题目 PDF</text><text class="file-meta">{{item.qpMeta}}</text></view><button data-id="{{item.id}}" data-kind="qp" bindtap="openPdf" disabled="{{pdfDownload.active}}">下载题目</button></view>
  <view wx:if="{{item.ak}}" class="file-row"><view><text>参考答案</text><text class="file-meta">{{item.akMeta}}</text></view><button data-id="{{item.id}}" data-kind="ak" bindtap="openPdf" disabled="{{pdfDownload.active}}">下载答案</button></view>
  <text wx:if="{{item.answerNote}}" class="answer-note">{{item.answerNote}}</text>
  <pdf-download-progress wx:if="{{pdfDownload.visible && pdfDownload.itemId === item.id}}" state="{{pdfDownload}}" bind:cancel="cancel" bind:retry="retry" bind:toggle="toggle" bind:login="account"/>
 </view></view>
 <view wx:if="{{!loading && !items.length && !error}}" class="empty-state">暂无这一分类的资料。</view>
 <view wx:if="{{pages > 1}}" class="pager"><button disabled="{{page <= 0}}" bindtap="previous">上一页</button><text>{{page + 1}} / {{pages}}</text><button disabled="{{page + 1 >= pages}}" bindtap="next">下一页</button></view>
</view>
