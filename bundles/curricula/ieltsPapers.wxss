.ielts-downloads{max-width:1180px;margin:0 auto;padding-bottom:38px}.quota-note{font-size:13px;line-height:1.7;color:#66708a;margin:16px 0}.book-picker{display:flex;justify-content:space-between;padding:16px;background:#fff;border:1px solid #e4e7f0;border-radius:14px;font-size:16px}.book-picker text{color:#5638c3;font-size:14px}.modules{display:flex;gap:8px;margin:16px 0}.modules button{flex:1;min-width:0;margin:0;padding:0 4px;min-height:44px;line-height:44px;font-size:14px;background:#fff;color:#66708a}.modules .selected{background:#eee9fc;color:#5638c3}.count{display:block;color:#66708a;font-size:13px;margin:16px 0}.papers{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}.paper{min-width:0;background:#fff;border:1px solid #e4e7f0;border-radius:18px;padding:18px}.paper-title{display:block;font-size:18px;font-weight:600;color:#18213d}.paper-source{display:block;font-size:12px;line-height:1.6;color:#66708a;overflow-wrap:anywhere;margin:5px 0 14px}.file-row{display:flex;align-items:center;gap:12px;padding:14px 0;border-top:1px solid #edf0f6}.file-row>view{flex:1;min-width:0;font-size:15px}.file-meta{display:block;font-size:12px;color:#66708a;margin-top:5px}.file-row button{flex:none;margin:0;width:108px;min-height:44px;line-height:44px;padding:0;font-size:14px;color:#5638c3;background:#eee9fc}.answer-note{display:block;color:#66708a;font-size:12px;line-height:1.6;margin-top:8px}.pager{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:22px}.pager button{margin:0;min-height:44px;font-size:14px}.device-tablet .papers{grid-template-columns:repeat(2,minmax(0,1fr))}@media (max-width:420px){.file-row button{width:100px}.paper{padding:16px}}
