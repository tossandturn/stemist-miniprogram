<view class="page {{deviceClass}} {{orientation}} university-page">
 <stemist-header compact="{{true}}" title="大学排名与官网" />
 <app-nav active="practice" source="university-directory" is-tablet="{{isTablet}}" show-ai="{{false}}" />
 <view class="directory-toolbar"><view class="directory-tabs" role="tablist" aria-label="切换大学排名与课程官网">
   <button class="directory-tab {{activeTab === 'rankings' ? 'active' : ''}}" data-tab="rankings" bindtap="chooseTab" role="tab" aria-selected="{{activeTab === 'rankings'}}">大学排名</button>
   <button class="directory-tab {{activeTab === 'official' ? 'active' : ''}}" data-tab="official" bindtap="chooseTab" role="tab" aria-selected="{{activeTab === 'official'}}">课程官网</button>
  </view>
  <button class="text-button directory-share" open-type="share">分享</button>
 </view>
 <view wx:if="{{coachEntryError}}" class="error directory-entry-error" role="alert">{{coachEntryError}}</view>
 <view wx:if="{{loading}}" class="directory-loading" role="status">正在加载大学目录…</view>
 <view wx:elif="{{error && !loaded}}" class="error" role="alert"><text>{{error}}</text><button class="secondary retry-action" bindtap="retry">重新加载</button></view>
 <block wx:else>
  <view wx:if="{{cacheNotice}}" class="warning cache-notice" role="status">{{cacheNotice}}</view>
  <block wx:if="{{activeTab === 'rankings'}}">
   <view class="ranking-toolbar ranking-tabs" role="tablist" aria-label="大学榜单">
    <button wx:for="{{rankingOptions}}" wx:key="id" class="ranking-tab {{currentRankingId === item.id ? 'active' : ''}}" data-ranking="{{item.id}}" bindtap="chooseRanking" role="tab" aria-selected="{{currentRankingId === item.id}}">{{item.shortLabel}}</button>
   </view>
   <view wx:if="{{currentRanking}}" class="ranking-meta">
    <view class="ranking-meta-summary"><text class="ranking-edition">{{currentRanking.scopeLabel}} · {{currentRanking.editionYear}} 版 · 前 100 名（含并列）</text><text class="verified-badge">核验于 {{currentRanking.verifiedAt}}</text></view>
    <view class="source-actions"><button class="source-copy" data-kind="source" bindtap="copyRankingLink">复制榜单来源</button><button class="source-copy" data-kind="methodology" bindtap="copyRankingLink">复制排名方法</button></view>
   </view>
   <view class="ranking-search">
    <view class="search-row"><input value="{{queryDraft}}" placeholder="输入中文或英文校名" aria-label="输入中文或英文校名" maxlength="120" confirm-type="search" bindinput="onSearchInput" bindconfirm="applySearch" /><button bindtap="applySearch" disabled="{{loading}}">搜索</button></view>
    <button wx:if="{{query}}" class="text-button search-clear" bindtap="clearSearch">清除搜索</button>
   </view>
   <view class="result-summary"><text>{{filteredCount}} 所大学</text><text wx:if="{{pageCount}}">第 {{pageNumber}} / {{pageCount}} 页</text></view>
   <view class="university-list">
    <view wx:for="{{visibleItems}}" wx:key="id" class="university-card">
     <view class="university-main">
      <view class="university-identity"><view class="university-logo {{item.logoSrc && item.logoTone === 'dark' ? 'logo-dark' : ''}}"><image wx:if="{{item.logoSrc}}" src="{{item.logoSrc}}" mode="aspectFit" lazy-load="{{true}}" data-id="{{item.id}}" data-logo-path="{{item.logoPath}}" binderror="onUniversityLogoError" aria-label="{{item.nameZh}} Logo" /><text wx:else class="logo-initial" aria-label="{{item.nameZh}} 校名缩写">{{item.logoInitial}}</text></view><view class="rank-mark {{item.rank <= 3 ? 'rank-top' : ''}}" aria-label="排名 {{item.rankLabel}}">{{item.rankLabel}}</view></view>
      <view class="university-copy"><text class="university-name-zh">{{item.nameZh}}</text><text class="university-name-en">{{item.nameEn}}</text><text class="university-country">{{item.country}}</text></view>
     </view>
     <text wx:if="{{item.profileSummary}}" class="admission-summary">{{item.profileSummary}}</text>
     <view class="university-footer"><text class="university-host">{{item.hostname}}</text><view class="university-actions"><button class="requirements-toggle" data-id="{{item.id}}" bindtap="showRequirements" aria-expanded="{{expandedId === item.id}}" aria-label="{{expandedId === item.id ? '收起' : '查看'}} {{item.nameZh}} 申请参考">{{expandedId === item.id ? '收起' : item.profileButtonLabel}}</button><button class="website-copy" data-id="{{item.id}}" bindtap="copyUniversity" aria-label="复制 {{item.nameZh}} 官网">复制官网</button></view></view>
     <button class="university-coach" data-id="{{item.id}}" bindtap="openUniversityCoach" disabled="{{!!coachOpening}}" loading="{{coachOpening === item.id}}" aria-label="和 AI Coach 聊聊 {{item.nameZh}} 的申请"><view class="coach-button-copy"><text>和 AI Coach 聊聊</text><text class="coach-button-hint">带入这所学校，咨询申请与准备</text></view><text class="coach-button-arrow" aria-hidden="true">›</text></button>
     <view wx:if="{{expandedId === item.id}}" class="requirements-panel">
      <view wx:if="{{profileLoading}}" class="profile-loading" role="status">正在加载申请参考…</view>
      <view wx:elif="{{profileError}}" class="profile-error" role="alert"><text>{{profileError}}</text><button class="secondary requirements-retry" bindtap="retryRequirements">重试</button></view>
      <block wx:elif="{{activeProfile}}">
       <view class="profile-heading"><text class="profile-kind">{{activeProfile.analysis ? '申请条件 · AI 分析' : activeProfile.kind === 'verified-overview' ? '官方要求摘要' : '申请准备清单'}}</text><text class="profile-date">{{activeProfile.analysis ? '整理' : activeProfile.kind === 'verified-overview' ? '核验' : '更新'}} {{activeProfile.analysis ? activeProfile.analysis.updatedOn : activeProfile.updatedOn}}</text></view>
       <text class="profile-scope">{{activeProfile.analysis ? activeProfile.analysis.summary : activeProfile.scope}}</text>
       <view wx:if="{{activeProfile.analysis}}" class="admission-analysis">
        <view wx:for="{{activeProfile.analysis.modules}}" wx:for-item="module" wx:key="id" class="admission-module">
         <view class="admission-module-heading"><text class="requirement-label">{{module.label}}</text><text class="admission-status status-{{module.status}}">{{module.statusLabel}}</text></view>
         <text class="admission-headline">{{module.headline}}</text><text class="requirement-text">{{module.detail}}</text>
         <view class="admission-advice"><text class="advice-label">AI 准备建议</text><text>{{module.advice}}</text></view>
        </view>
       </view>
       <block wx:else><view wx:for="{{activeProfile.sections}}" wx:for-item="section" wx:key="label" class="requirement-section"><text class="requirement-label">{{section.label}}</text><text class="requirement-text">{{section.text}}</text></view></block>
       <text class="profile-notice">{{activeProfile.notice}}</text>
       <view class="admission-sources"><button wx:for="{{activeProfile.sources}}" wx:for-item="source" wx:key="id" class="admission-source" data-source="{{source.id}}" bindtap="copyAdmissionSource" aria-label="复制 {{source.title}} 链接">{{source.title}} · 复制链接</button></view>
      </block>
     </view>
    </view>
   </view>
   <view wx:if="{{loaded && !visibleItems.length}}" class="empty-state"><text class="empty-title">没有匹配的大学</text><text class="empty-detail">试试中文或英文校名。</text><button class="secondary" bindtap="clearSearch">清除搜索</button></view>
   <view wx:if="{{pageCount > 1}}" class="directory-pagination"><button class="secondary" disabled="{{pageNumber <= 1}}" bindtap="previousPage">上一页</button><text>{{pageNumber}} / {{pageCount}}</text><button class="secondary" disabled="{{pageNumber >= pageCount}}" bindtap="nextPage">下一页</button></view>
  </block>
  <block wx:else>
   <view class="official-intro"><text class="official-heading">找到适合你的课程路线</text><text class="official-note">先了解课程，再结合目标地区与专业规划选课。</text></view>
   <view class="official-grid">
    <view wx:for="{{examBoards}}" wx:key="id" class="official-card board-{{item.id}}" id="course-{{item.id}}">
     <view class="official-card-head"><view class="course-mark" aria-hidden="true">{{item.label}}</view><text class="official-label">官方课程入口</text></view>
     <text class="official-organization">{{item.organization}}</text><text class="official-host">{{item.hostname}}</text>
     <button class="course-coach" data-board="{{item.id}}" bindtap="openCourseCoach" disabled="{{!!coachOpening}}" loading="{{coachOpening === item.id}}" aria-label="和 AI Coach 聊聊 {{item.label}} 课程">和 AI Coach 聊 {{item.label}}</button>
     <button class="official-copy" data-board="{{item.id}}" bindtap="copyOfficial" aria-label="复制 {{item.label}} 官网链接">复制官网链接 <text aria-hidden="true">↗</text></button>
    </view>
   </view>
   <text class="official-note official-browser-note">官网链接复制后可在浏览器打开；AI 建议不替代官方说明。</text>
  </block>
  <view wx:if="{{error && loaded}}" class="error" role="alert">{{error}}</view>
 </block>
</view>
