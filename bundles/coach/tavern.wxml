<view class="page {{deviceClass}} {{orientation}} tavern-page {{presetChosen && !selectorOpen ? 'chat-active' : ''}} {{keyboardOpen ? 'keyboard-open' : ''}} {{keyboardOpen && chatViewportHeight < 260 ? 'compact-chat' : ''}}" style="{{presetChosen && !selectorOpen ? 'height:' + chatViewportHeight + 'px' : ''}}">
  <stemist-header wx:if="{{selectorOpen || !presetChosen}}" compact="{{true}}" eyebrow="AI 休闲酒馆" title="星光酒馆" />
  <app-nav wx:if="{{selectorOpen || !presetChosen}}" id="tavern-nav" active="coach" is-tablet="{{isTablet}}" show-ai="{{false}}" />
  <view wx:if="{{selectorOpen || !presetChosen}}" class="preset-discovery">
    <image class="tavern-illustration" src="/bundles/coach/art/tavern-lounge.jpg" mode="aspectFit" aria-label="月光窗边的猫咪与热茶" />
    <view class="tavern-note">AI 虚构角色，不读取学术内容。</view>
    <view class="preset-head"><text class="preset-title">今晚，想和谁聊聊？</text></view>
    <view class="category-filter" role="group" aria-label="筛选休闲预设"><button wx:for="{{categories}}" wx:key="id" class="{{category === item.id ? 'active' : ''}}" data-category="{{item.id}}" bindtap="chooseCategory" disabled="{{loading || examBlocked}}">{{item.label}}</button></view>
    <view class="persona-list" role="group" aria-label="选择休闲聊天预设">
      <button wx:for="{{visiblePersonas}}" wx:key="id" class="persona role-{{item.id}} {{persona === item.id && presetChosen ? 'active' : ''}}" data-persona="{{item.id}}" bindtap="choosePersona" disabled="{{loading || examBlocked}}" aria-label="{{item.name}}，{{item.tag}}：{{item.detail}}">
        <view class="persona-top"><view class="persona-avatar tone-{{item.category}}" aria-hidden="true"><image class="persona-icon" src="/bundles/coach/icons/{{item.icon}}" mode="aspectFit" /></view><text class="persona-tag">{{item.tag}}</text></view>
        <text class="persona-name">{{item.name}}</text><text class="persona-detail">{{item.detail}}</text>
      </button>
    </view>
  </view>
  <view wx:else class="selected-workspace">
    <view class="selected-preset role-{{selected.id}}">
      <view class="persona-avatar" aria-hidden="true"><image class="persona-icon" src="/bundles/coach/icons/{{selected.icon}}" mode="aspectFit" /></view>
      <view class="selected-copy"><text class="selected-name">{{selected.name}}</text><text class="selected-detail">AI 虚构角色 · {{selected.tag}}</text></view>
      <button class="preset-change" bindtap="openSelector" disabled="{{loading || examBlocked}}">换角色</button>
    </view>
    <coach-effort effort="{{pendingEffort}}" locked="{{effortLocked}}" disabled="{{loading || historyLoading || examBlocked}}" compact="{{true}}" />
    <scroll-view id="tavern-chat" class="chat-list" scroll-y="true" scroll-top="{{chatScrollTop}}" enhanced="true" show-scrollbar="false" bindtap="dismissComposerKeyboard" aria-label="当前角色聊天记录">
      <view class="chat-inner">
        <view class="chat-history-head"><text class="chat-history-label">{{historySource === 'legacy' ? '本机旧对话 · 待同步' : historyBrowsing ? '较早的对话' : '仅供休闲交流'}}</text><view class="chat-history-actions"><button wx:if="{{historyBrowsing}}" class="history-action" bindtap="returnLatestHistory" disabled="{{historyLoading || loading}}">最新</button><button wx:if="{{hasOlderHistory}}" class="history-action" bindtap="loadOlderHistory" loading="{{historyLoading}}" disabled="{{historyLoading || loading}}">更早</button><button class="history-action tavern-clear" bindtap="requestClear" disabled="{{loading || historyLoading}}">{{clearPending ? '重试清空' : '清空'}}</button></view></view>
        <image wx:if="{{!turns.length && !keyboardOpen && !draw}}" class="chat-illustration" src="/bundles/coach/art/tavern-lounge.jpg" mode="aspectFit" aria-hidden="true" />
        <view wx:if="{{!turns.length && !draw}}" class="chat-row assistant opening-row">
          <image class="message-avatar" src="/bundles/coach/icons/{{selected.icon}}" mode="aspectFit" aria-hidden="true" />
          <view class="chat-turn assistant"><text class="message-name">{{selected.name}}</text><text class="preset-opening-text">{{greeting}}</text></view>
        </view>
        <view wx:if="{{!turns.length && !keyboardOpen && !draw}}" class="starter-list" aria-label="推荐开场话题"><button wx:for="{{starters}}" wx:key="*this" class="starter-chip" data-text="{{item}}" bindtap="useStarter" disabled="{{loading || examBlocked}}">{{item}}</button></view>
        <view wx:if="{{selected.divinationKind}}" class="fortune-panel">
          <view class="fortune-note">可以直接聊天，也可以带着问题抽取。仅供娱乐，不是科学预测，也不替你做决定。</view>
        </view>
        <tavern-draw-art wx:if="{{selected.divinationKind}}" id="tavern-draw-art" draw="{{draw}}" />
        <view wx:if="{{selected.divinationKind && draw && canRetry && retryKind === 'interpret' && !drawNeedsRedraw}}" class="fortune-result-priority">
          <button class="secondary fortune-primary" bindtap="retryInterpretation" disabled="{{loading || examBlocked || authRequired}}">重试本次解读</button>
        </view>
        <view wx:for="{{turns}}" wx:key="id" class="chat-row {{item.role}}">
          <image wx:if="{{item.role !== 'user'}}" class="message-avatar" src="/bundles/coach/icons/{{selected.icon}}" mode="aspectFit" aria-hidden="true" />
          <view wx:else class="message-avatar user-avatar" aria-hidden="true">你</view>
          <view class="message-content">
            <view class="chat-turn {{item.role}}"><text wx:if="{{item.role === 'user'}}" selectable="{{true}}">{{item.content}}</text><answer-content wx:else compact="{{true}}" text="{{item.content}}" /></view>
            <view wx:for="{{item.media}}" wx:for-item="mediaItem" wx:key="id" class="reply-media {{mediaItem.kind}}" aria-label="{{mediaItem.alt}}">
              <view class="reply-media-frame" style="width:{{mediaItem.viewWidth}}px;height:{{mediaItem.viewHeight}}px;">
                <view wx:if="{{mediaFailures[mediaItem.key]}}" class="reply-media-error"><text>图片暂未加载</text><button class="media-retry" data-media-key="{{mediaItem.key}}" bindtap="retryReplyMedia">重试图片</button></view>
                <block wx:else>
                  <image wx:if="{{mediaItem.kind === 'sticker'}}" class="sticker-sheet" style="{{mediaItem.atlasStyle}}" src="{{mediaItem.renderUrl}}" mode="scaleToFill" lazy-load="{{true}}" data-media-key="{{mediaItem.key}}" bindload="onReplyMediaLoad" binderror="onReplyMediaError" aria-hidden="true" />
                  <button wx:else class="reply-picture" data-media-key="{{mediaItem.key}}" bindtap="previewReplyMedia" aria-label="{{'查看图片：' + mediaItem.alt}}"><image class="reply-image" src="{{mediaItem.renderUrl}}" mode="aspectFit" lazy-load="{{true}}" data-media-key="{{mediaItem.key}}" bindload="onReplyMediaLoad" binderror="onReplyMediaError" /></button>
                  <view wx:if="{{!mediaLoaded[mediaItem.key]}}" class="reply-media-loading" role="status">图片加载中…</view>
                </block>
              </view>
              <text wx:if="{{mediaItem.caption}}" class="reply-media-caption">{{mediaItem.caption}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{loading && message && !drawLoading && !interpretLoading}}" class="chat-row user"><view class="message-avatar user-avatar" aria-hidden="true">你</view><view class="chat-turn user"><text>{{message}}</text><text class="message-name">发送中</text></view></view>
        <view wx:if="{{loading}}" class="chat-row assistant"><image class="message-avatar" src="/bundles/coach/icons/{{selected.icon}}" mode="aspectFit" aria-hidden="true" /><view class="chat-turn assistant typing-status" role="status">{{drawLoading ? '正在抽取…' : interpretLoading ? '正在解读…' : '正在回复…'}}</view></view>
        <view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{warning}}" class="warning">{{warning}}</view>
        <view wx:if="{{status && !loading && (error || clearPending)}}" class="status-line" role="status">{{status}}</view>
        <button wx:if="{{authRequired}}" class="secondary" bindtap="openAccount">登录 / 注册后重试</button>
      </view>
      <view wx:if="{{historyAnchor}}" id="{{historyAnchor}}" class="chat-tail" aria-hidden="true"></view>
    </scroll-view>
    <view class="chat-composer">
      <view wx:if="{{selected.divinationKind}}" class="fortune-tools">
        <view wx:if="{{selected.divinationKind === 'tarot'}}" class="fortune-spreads" role="group" aria-label="下次抽牌方式"><button class="spread-option {{spread === 'single' ? 'active' : ''}}" data-spread="single" bindtap="chooseSpread" disabled="{{loading || examBlocked}}" aria-pressed="{{spread === 'single'}}">单张</button><button class="spread-option {{spread === 'three' ? 'active' : ''}}" data-spread="three" bindtap="chooseSpread" disabled="{{loading || examBlocked}}" aria-pressed="{{spread === 'three'}}">三张</button></view>
        <text wx:else class="fortune-tools-caption">抽一卦，也能接着聊</text>
        <button id="fortune-draw" class="fortune-draw" bindtap="drawFortune" loading="{{drawLoading}}" disabled="{{loading || examBlocked || authRequired}}" aria-label="明确发起一次新的娱乐抽取">{{retryKind === 'draw' && error ? '重试抽取' : draw ? '再抽' : selected.divinationKind === 'tarot' ? '抽牌' : '抽签'}}</button>
      </view>
      <textarea id="tavern-input" class="tavern-input" style="height:{{composerHeight}}px" value="{{message}}" maxlength="1200" disabled="{{loading || examBlocked}}" placeholder="发消息…" cursor-spacing="0" adjust-position="{{false}}" hold-keyboard="{{true}}" show-confirm-bar="{{false}}" confirm-type="send" bindfocus="onComposerFocus" bindblur="onComposerBlur" bindkeyboardheightchange="onComposerKeyboard" bindlinechange="onComposerLineChange" bindinput="onMessage" bindconfirm="onComposerConfirm" aria-label="休闲聊天输入" />
      <button id="tavern-send" class="primary tavern-submit" bindtap="submit" loading="{{loading}}" disabled="{{loading || !message || examBlocked || authRequired}}">{{loading ? '回复中' : canRetry && retryKind === 'chat' ? '重试' : '发送'}}</button>
    </view>
  </view>
  <view wx:if="{{!presetChosen && error}}" class="error">{{error}}</view>
</view>
