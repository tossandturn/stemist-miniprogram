<view class="page {{deviceClass}} {{orientation}} tavern-page">
  <stemist-header eyebrow="AI 休闲酒馆" title="星光酒馆" />
  <app-nav active="coach" is-tablet="{{isTablet}}" show-ai="{{false}}" />
  <view class="tavern-note">角色均为 AI 虚构互动，不读取学术内容。</view>
  <view wx:if="{{selectorOpen || !presetChosen}}" class="preset-discovery">
    <view class="preset-head"><view><text class="preset-title">休闲精选</text><text class="preset-subtitle">按气氛筛选，选择后直接进入。</text></view></view>
    <view class="category-filter" role="group" aria-label="筛选休闲预设"><button wx:for="{{categories}}" wx:key="id" class="{{category === item.id ? 'active' : ''}}" data-category="{{item.id}}" bindtap="chooseCategory" disabled="{{loading || examBlocked}}">{{item.label}}</button></view>
    <view class="persona-list" role="group" aria-label="选择休闲聊天预设">
      <button wx:for="{{visiblePersonas}}" wx:key="id" class="persona {{persona === item.id && presetChosen ? 'active' : ''}}" data-persona="{{item.id}}" bindtap="choosePersona" disabled="{{loading || examBlocked}}" aria-label="{{item.name}}，{{item.tag}}：{{item.detail}}">
        <view class="persona-avatar tone-{{item.category}}" aria-hidden="true"><image class="persona-icon" src="/bundles/coach/icons/{{item.icon}}" mode="aspectFit" /></view>
        <text class="persona-tag">{{item.tag}}</text><text class="persona-name">{{item.name}}</text><text class="persona-detail">{{item.detail}}</text>
      </button>
    </view>
  </view>
  <view wx:else class="selected-workspace">
    <view class="selected-preset">
      <view class="persona-avatar tone-{{selected.category}}" aria-hidden="true"><image class="persona-icon" src="/bundles/coach/icons/{{selected.icon}}" mode="aspectFit" /></view>
      <view class="selected-copy"><text class="persona-tag">{{selected.tag}}</text><text class="selected-name">{{selected.name}}</text><text class="selected-detail">{{selected.detail}}</text></view>
      <button class="preset-change" bindtap="openSelector" disabled="{{loading || examBlocked}}">更换预设</button>
    </view>
    <view wx:if="{{selected.divinationKind && draw}}" class="fortune-result-priority">
      <view class="draw-grid {{draw.spread === 'three' ? 'three' : 'single'}}" aria-label="本次娱乐抽取结果"><view wx:for="{{draw.cards}}" wx:key="id" class="draw-card"><text class="draw-position">{{item.position}}</text><text class="draw-name">{{item.name}}</text><text wx:if="{{item.orientation}}" class="draw-orientation">{{item.orientation === 'upright' ? '正位' : '逆位'}}</text></view></view>
      <button wx:if="{{drawNeedsRedraw}}" class="primary fortune-primary" bindtap="redrawFortune" loading="{{drawLoading}}" disabled="{{loading || examBlocked}}">{{drawLoading ? '正在重新抽取…' : '重新抽取'}}</button>
      <button wx:else class="primary fortune-primary" bindtap="retryInterpretation" loading="{{interpretLoading || drawLoading}}" disabled="{{loading || examBlocked}}">{{drawLoading ? '正在重新抽取…' : interpretLoading ? '正在解读…' : canRetry ? '重试解读' : selected.divinationKind === 'hexagram' ? '解读当前卦签' : '解读当前牌面'}}</button>
      <view wx:if="{{status}}" class="status-line" role="status">{{status}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
    </view>
    <view wx:if="{{turns.length}}" class="chat-history-label">历史对话</view><scroll-view wx:if="{{turns.length}}" class="chat-list" scroll-y="true" scroll-into-view="{{historyAnchor}}" enhanced="true" show-scrollbar="false" aria-label="当前预设聊天记录"><view wx:for="{{turns}}" wx:key="index" class="chat-turn {{item.role}}"><text wx:if="{{item.role === 'user'}}">{{item.content}}</text><answer-content wx:else text="{{item.content}}" /></view><view wx:if="{{historyAnchor}}" id="{{historyAnchor}}" aria-hidden="true"></view></scroll-view>
    <view wx:elif="{{!selected.divinationKind || draw}}" class="preset-opening"><text class="preset-opening-label">{{selected.name}} · 预设开场</text><text class="preset-opening-text">{{greeting}}</text></view>
    <view wx:if="{{!selected.divinationKind || draw}}" class="starter-list" aria-label="当前预设开场话题"><button wx:for="{{starters}}" wx:key="*this" class="starter-chip" data-text="{{item}}" bindtap="useStarter" disabled="{{loading || examBlocked}}">{{item}}</button></view>
    <block wx:if="{{selected.divinationKind}}">
      <view class="fortune-panel">
        <view class="fortune-note">随机娱乐提示，不是科学预测，也不替你做决定。</view>
        <textarea class="tavern-input fortune-question" value="{{question}}" maxlength="600" disabled="{{loading || examBlocked}}" placeholder="{{placeholder}}" cursor-spacing="24" adjust-position="true" bindinput="onFortuneQuestion" aria-label="可选的娱乐问题" />
        <view wx:if="{{selected.divinationKind === 'tarot'}}" class="spread-options" role="group" aria-label="选择塔罗抽取方式"><button class="spread-option {{spread === 'single' ? 'active' : ''}}" data-spread="single" bindtap="chooseSpread" disabled="{{loading || examBlocked}}">单张提示</button><button class="spread-option {{spread === 'three' ? 'active' : ''}}" data-spread="three" bindtap="chooseSpread" disabled="{{loading || examBlocked}}">三张主题</button></view>
        <button wx:if="{{!draw && !drawNeedsRedraw}}" class="primary fortune-primary" bindtap="drawFortune" loading="{{drawLoading}}" disabled="{{loading || examBlocked}}">{{drawLoading ? '正在随机抽取…' : '抽取并解读'}}</button>
        <button wx:elif="{{!draw && drawNeedsRedraw}}" class="primary fortune-primary" bindtap="redrawFortune" loading="{{drawLoading}}" disabled="{{loading || examBlocked}}">重新抽取</button>
        <button wx:if="{{draw && !drawNeedsRedraw && !loading}}" class="secondary fortune-redraw" bindtap="redrawFortune" disabled="{{examBlocked}}">重新抽取</button>
      </view>
    </block>
    <block wx:else>
      <textarea class="tavern-input" value="{{message}}" maxlength="1200" disabled="{{loading || examBlocked}}" placeholder="{{placeholder}}" cursor-spacing="24" adjust-position="true" bindinput="onMessage" aria-label="休闲聊天输入" />
      <button class="primary tavern-submit" bindtap="submit" loading="{{loading}}" disabled="{{loading || !message || examBlocked}}">{{loading ? 'AI 正在回应…' : '发送给' + selected.name}}</button>
    </block>
    <view wx:if="{{status && (!selected.divinationKind || !draw)}}" class="status-line" role="status">{{status}}</view><view wx:if="{{error && (!selected.divinationKind || !draw)}}" class="error">{{error}}</view><view wx:if="{{warning}}" class="warning">{{warning}}</view>
    <button wx:if="{{authRequired}}" class="secondary" bindtap="openAccount">登录 / 注册后重试</button><button wx:if="{{canRetry && !selected.divinationKind}}" class="secondary" bindtap="retry">重试 AI</button>
    <button class="text-button tavern-clear" bindtap="clear" disabled="{{loading}}">清空当前预设对话</button>
  </view>
  <view wx:if="{{!presetChosen && error}}" class="error">{{error}}</view>
</view>
