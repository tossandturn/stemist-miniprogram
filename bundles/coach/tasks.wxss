.task-page{max-width:1060px;margin:0 auto;color:#18213d}.task-intro,.task-muted{color:#66708a;font-size:13px;line-height:1.65;overflow-wrap:anywhere}.task-intro{margin:8px 0 18px}.task-toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:14px 0;color:#66708a;font-size:13px}.task-toolbar button{min-height:44px;margin:0;min-width:100px;font-size:14px}.task-card{box-sizing:border-box;width:100%;min-width:0;padding:18px;margin:0 0 14px;border:1px solid #e4e7f0;border-radius:18px;background:#fff;text-align:left;white-space:normal}.task-title{font-size:18px;font-weight:700;line-height:1.5;color:#18213d}.task-status{display:inline-block;padding:6px 10px;margin:14px 0;border-radius:8px;background:#f0ebff;color:#5638b8;font-size:14px}.task-status.succeeded{background:#eaf5f0;color:#27664d}.task-status.failed,.task-status.interrupted{background:#fff0f2;color:#a22e48}.task-steps,.task-metrics{display:flex;justify-content:space-between;gap:8px;color:#66708a;font-size:12px;line-height:1.65}.task-steps{padding:10px 0;border-bottom:1px solid #e4e7f0;margin-bottom:10px}.task-steps text{flex:1;min-width:0}.task-steps .active,.task-steps .done{color:#5638b8;font-weight:700}.task-metrics{flex-wrap:wrap;margin:10px 0}.task-retention{margin-top:14px;padding-top:10px;border-top:1px solid #e4e7f0;color:#66708a;font-size:12px}.task-answer{margin-top:18px;padding-top:16px;border-top:1px solid #e4e7f0;font-size:16px;line-height:1.75;overflow-wrap:anywhere}.task-error{padding:12px;border-radius:10px;background:#fff5e5;color:#80531a;font-size:13px;line-height:1.6;margin:10px 0}.task-empty{padding:30px 18px;border:1px dashed #d8d0ee;border-radius:18px;color:#66708a;text-align:center;font-size:14px;line-height:1.8;background:#fbfaff}.task-empty button{margin-top:18px;min-height:44px}.task-row{min-height:116px}.task-row:active{background:#faf8ff}.task-row-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.task-badge{font-size:12px;color:#5638b8;flex-shrink:0}.task-row-foot{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:#66708a;font-size:12px;margin-top:14px}.task-row-foot text:last-child{color:#5638b8}.task-page.device-tablet .task-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.task-page.device-tablet .task-card{padding:22px}@media(max-width:375px){.task-card{padding:14px}.task-title{font-size:16px}.task-row-head{gap:6px}}
