<view class="admissions-page ielts-teacher-page {{deviceClass}} {{orientation}} {{keyboardOpen ? 'keyboard-open' : ''}} {{keyboardOpen && chatViewportHeight < 260 ? 'compact-chat' : ''}}" style="height:{{chatViewportHeight}}px">
  <view class="advisor-header">
    <image class="advisor-avatar" src="/bundles/coach/mode-icons/ielts-teacher.svg" mode="aspectFit" aria-hidden="true" />
    <view class="advisor-heading"><text class="advisor-title">雅思老师</text><text class="advisor-subtitle">AI</text></view>
    <button class="quiet-button" bindtap="requestClear" disabled="{{loading || historyLoading || authRequired}}">{{clearPending ? '重试清空' : '清空'}}</button>
  </view>
  <coach-effort id="effort-picker" scope="ielts-teacher" message="{{message}}" effort="{{pendingEffort}}" locked="{{effortLocked}}" disabled="{{loading || historyLoading || clearPending}}" compact="{{true}}" />
  <scroll-view class="chat-list" scroll-y="true" scroll-top="{{chatScrollTop}}" enhanced="true" show-scrollbar="false" bindtap="dismissComposerKeyboard" aria-label="雅思老师对话">
    <view class="chat-inner">
      <view class="history-actions"><button wx:if="{{historyBrowsing || error}}" class="quiet-button" bindtap="returnLatestHistory" disabled="{{loading || historyLoading || authRequired || clearPending}}">刷新最新</button><button wx:if="{{hasOlderHistory}}" class="quiet-button" bindtap="loadOlderHistory" disabled="{{loading || historyLoading || clearPending}}">更早记录</button></view>
      <view wx:if="{{!turns.length && !loading && !historyLoading && !clearPending}}" class="advisor-welcome">
        <text class="welcome-title">选择练习</text>
        <view class="starter-grid"><button wx:for="{{starters}}" wx:key="title" class="starter-button" data-index="{{index}}" bindtap="useStarter" disabled="{{authRequired}}">{{item.title}}</button></view>
        <view class="teacher-links" aria-label="IELTS 原生学习入口"><button class="teacher-link" bindtap="openIeltsWorkspace">IELTS 学习</button><button class="teacher-link" bindtap="openRealtimeSpeaking">实时口语</button></view>
        <text class="advisor-note">文字练习不评发音；练习估分不代表官方成绩。</text>
      </view>
      <view wx:if="{{historyLoading}}" class="status-line" role="status">正在恢复对话…</view>
      <view wx:for="{{turns}}" wx:key="id" class="chat-row {{item.role}}">
        <text class="message-label">{{item.role === 'user' ? '你' : '雅思老师 · AI'}}</text>
        <view class="chat-bubble {{item.role}}"><text wx:if="{{item.role === 'user'}}" selectable="{{true}}">{{item.content}}</text><answer-content wx:else text="{{item.content}}" compact="{{true}}" academic="{{true}}" /></view>
        <button wx:if="{{item.role === 'assistant'}}" class="copy-button" data-id="{{item.id}}" bindtap="copyReply" aria-label="复制这条雅思辅导回复">复制</button>
      </view>
      <view wx:if="{{loading && message}}" class="chat-row user"><text class="message-label">你</text><view class="chat-bubble user"><text>{{message}}</text></view></view>
      <view wx:if="{{partialAnswer}}" class="chat-row assistant"><text class="message-label">雅思老师 · AI</text><view class="chat-bubble assistant"><answer-content text="{{partialAnswer}}" compact="{{true}}" academic="{{true}}" /><text wx:if="{{!loading}}" class="partial-note">回复未完成，仅显示已收到的部分内容。</text></view></view>
      <view wx:if="{{loading}}" class="status-line" role="status">{{status}}</view>
      <view wx:if="{{clearPending}}" class="notice" role="status">云端清空尚未确认，请点击右上角“重试清空”。</view>
      <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      <view wx:if="{{warning}}" class="notice">{{warning}}</view>
      <button wx:if="{{authRequired}}" class="login-button" bindtap="openAccount">登录后开始辅导</button>
    </view>
  </scroll-view>
  <view class="advisor-composer">
    <text class="input-label">{{canRetry ? '输入已保留，可继续重试' : '你的 IELTS 问题或练习材料'}}</text>
    <textarea id="ielts-teacher-input" class="advisor-input" style="height:{{composerHeight}}px" value="{{message}}" maxlength="12000" disabled="{{loading || authRequired || clearPending}}" placeholder="输入问题，或粘贴题目与文字材料…" cursor-spacing="0" adjust-position="{{false}}" hold-keyboard="{{true}}" show-confirm-bar="{{false}}" confirm-type="send" bindfocus="onComposerFocus" bindblur="onComposerBlur" bindkeyboardheightchange="onComposerKeyboard" bindlinechange="onComposerLineChange" bindinput="onMessage" bindconfirm="onComposerConfirm" aria-label="雅思问题或练习材料，最多12000字符" />
    <button class="send-button" bindtap="submit" loading="{{loading}}" disabled="{{loading || historyLoading || (!message && receiptState !== 'commit-deferred') || authRequired || clearPending || sendBlocked}}">{{loading ? '回复中' : receiptState === 'indeterminate' ? '等待确认' : receiptState === 'commit-deferred' ? '重试保存' : canRetry ? '重试' : '发送'}}</button>
  </view>
</view>
