.coach-hub-page{background:linear-gradient(180deg,#f5f2ff 0,#f5f6fa 280px)}.hub-intro{max-width:760px;margin:18px auto 4px;color:#66708a;font-size:14px;line-height:1.6}.mode-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;max-width:760px;margin:18px auto}.mode-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;width:100%;min-width:0;min-height:178px;margin:0;padding:18px;border:1px solid #e4e0f4;border-radius:18px;color:#18213d;background:#fff;text-align:left;box-shadow:0 12px 30px rgba(42,31,89,.07)}.mode-card:active{border-color:#7357e8;background:#f8f6ff}.mode-glyph{position:relative;width:44px;height:44px;margin-bottom:14px;border-radius:14px;color:#6848d7;background:#eeebfc}.mode-glyph-core,.mode-glyph-mark{position:absolute;border:2px solid currentColor}.mode-steps .mode-glyph-core{left:10px;top:9px;width:21px;height:25px;border-radius:5px}.mode-steps .mode-glyph-mark{left:15px;top:15px;width:12px;height:2px;border-width:2px 0}.mode-answers .mode-glyph-core{left:8px;top:12px;width:27px;height:19px;border-radius:7px}.mode-answers .mode-glyph-mark{right:8px;bottom:7px;width:9px;height:9px;border-width:0 2px 2px 0;transform:rotate(45deg)}.mode-pdf .mode-glyph-core{left:11px;top:7px;width:20px;height:28px;border-radius:3px}.mode-pdf .mode-glyph-mark{left:16px;top:17px;width:10px;height:5px;border-width:2px 0}.mode-tavern .mode-glyph-core{left:9px;top:11px;width:26px;height:19px;border-radius:6px 6px 12px 12px}.mode-tavern .mode-glyph-mark{right:5px;top:15px;width:8px;height:10px;border-left:0;border-radius:0 6px 6px 0}.mode-title{font-size:18px;font-weight:800}.mode-detail{display:block;flex:1;margin-top:7px;color:#66708a;font-size:13px;line-height:1.55}.mode-action{margin-top:12px;color:#5638c3;font-size:13px;font-weight:750}.hub-privacy{max-width:760px;margin:4px auto 0;padding:14px 16px;border-radius:14px;color:#5d6680;background:#eef0f8;font-size:12px;line-height:1.55}.coach-hub-page.device-tablet .mode-grid{max-width:900px;gap:20px}.coach-hub-page.device-tablet .mode-card{min-height:196px;padding:22px}.coach-hub-page.device-tablet .hub-intro,.coach-hub-page.device-tablet .hub-privacy{max-width:900px}@media(max-width:375px){.mode-grid{gap:10px}.mode-card{min-height:170px;padding:15px}.mode-detail{font-size:12px}}@media(max-width:330px){.mode-grid{grid-template-columns:1fr}.mode-card{min-height:148px}}
