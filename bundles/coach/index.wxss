.coach-hub-page{background:linear-gradient(180deg,#f1edff 0,#f5f6fa 260px)}
.coach-hub-page .workspace-header-compact{padding-right:0;margin-bottom:10px}
.mode-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;max-width:760px;margin:14px auto}
.coach-hub-page button.mode-card{box-sizing:border-box;width:100%;min-width:0;max-width:100%}
.mode-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;min-height:188px;margin:0;padding:18px;border:1px solid #e2ddeb;border-radius:20px;color:#18213d;background:#fff;text-align:left;box-shadow:0 6px 18px rgba(42,31,89,.04)}
.mode-card:active{border-color:#aa99dd;background:#faf8ff}
.mode-glyph{display:flex;align-items:center;justify-content:center;width:52px;height:52px;margin-bottom:16px;border-radius:16px;background:#f0eaff}
.mode-illustration{display:block;width:44px;height:44px}
.mode-answers .mode-glyph{background:#edf4ff}
.mode-pdf .mode-glyph{background:#eaf5f0}
.mode-tavern .mode-glyph{background:#fff3e2}
.mode-admissions .mode-glyph{background:#eaf5f0}
.mode-ielts-teacher .mode-glyph{background:#eef0ff}
.mode-arrow{position:absolute;right:18px;top:24px;width:7px;height:7px;border-top:2px solid #a8a1b7;border-right:2px solid #a8a1b7;transform:rotate(45deg)}
.mode-title{font-size:18px;font-weight:750;line-height:1.35;overflow-wrap:anywhere}
.mode-detail{display:block;flex:1;margin-top:8px;color:#66708a;font-size:14px;font-weight:400;line-height:1.55;overflow-wrap:anywhere}
.mode-admissions .mode-detail{flex:1}
.mode-ielts-teacher .mode-detail{flex:1}
.coach-hub-page.device-tablet .mode-grid{max-width:1040px;gap:20px}
.coach-hub-page.device-tablet .mode-card{min-height:204px;padding:22px}
.coach-hub-page.device-tablet .mode-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
@media(max-width:375px){.mode-grid{gap:12px}.mode-card{min-height:180px;padding:16px}.mode-glyph{margin-bottom:12px}.mode-detail{font-size:13px}}
