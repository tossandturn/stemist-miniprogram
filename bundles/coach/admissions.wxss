.admissions-page{box-sizing:border-box;display:flex;flex-direction:column;overflow:hidden;width:100%;max-width:100%;margin:0;background:#f5f6fb;color:#18213d}
.advisor-header{box-sizing:border-box;display:flex;align-items:center;gap:12px;flex:0 0 auto;width:100%;max-width:900px;margin:0 auto;padding:12px 16px;background:#fff;border-bottom:1px solid #e4e7f0}
.advisor-avatar{flex:0 0 44px;width:44px;height:44px;border-radius:14px;background:#eaf5f0}
.advisor-heading{flex:1;min-width:0}.advisor-title,.advisor-subtitle{display:block;overflow-wrap:anywhere}.advisor-title{font-size:17px;font-weight:700;line-height:1.4}.advisor-subtitle{margin-top:3px;font-size:12px;color:#66708a;line-height:1.5}
.admissions-page button{box-sizing:border-box;min-height:44px;min-width:0;margin:0;line-height:1.5;font-size:14px;border-radius:10px}.admissions-page button::after{border:0}.admissions-page button:active{opacity:.78}
.admissions-page .quiet-button{width:auto;padding:10px 12px;background:transparent;color:#5638c3}.chat-list{flex:1;min-height:0;height:0;width:100%}.chat-inner{box-sizing:border-box;width:100%;max-width:900px;margin:0 auto;padding:0 16px 20px}.history-actions{display:flex;justify-content:flex-end;gap:8px;min-height:12px}
.advisor-welcome{margin:12px 0 24px;padding:22px 18px;background:#fff;border:1px solid #e4e7f0;border-radius:20px}.welcome-title{display:block;font-size:23px;font-weight:700;line-height:1.45}.welcome-copy{display:block;margin-top:12px;font-size:15px;line-height:1.7;color:#66708a}.starter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:20px}.admissions-page .starter-button{width:100%;padding:12px 8px;background:#f0ecfb;color:#5638c3;border:1px solid #e4def6}.advisor-note{display:block;margin-top:18px;color:#66708a;font-size:12px;line-height:1.65}
.chat-row{display:flex;flex-direction:column;align-items:flex-start;margin:14px 0;min-width:0}.chat-row.user{align-items:flex-end}.message-label{margin:0 4px 5px;color:#66708a;font-size:12px;line-height:1.5}.chat-bubble{box-sizing:border-box;max-width:100%;min-width:0;padding:14px;border:1px solid #e4e7f0;border-radius:5px 16px 16px 16px;background:#fff;font-size:16px;line-height:1.7;overflow-wrap:anywhere;word-break:break-word}.chat-bubble.user{max-width:90%;border-radius:16px 5px 16px 16px;background:#eee8ff;border-color:#e1d7fa;white-space:pre-wrap}.admissions-page .copy-button{width:auto;margin-top:2px;padding:10px 12px;color:#5638c3;background:transparent;font-size:12px}.partial-note{display:block;margin-top:10px;color:#865d25;font-size:12px;line-height:1.5}
.status-line,.notice,.error{padding:10px 12px;margin:10px 0;border-radius:10px;font-size:13px;line-height:1.6;overflow-wrap:anywhere}.status-line{color:#66708a}.notice{color:#79571e;background:#fff6e8}.error{color:#9f3650;background:#fff0f3}.admissions-page .login-button{width:100%;padding:12px;color:#fff;background:#6848d7}
.advisor-composer{box-sizing:border-box;display:grid;grid-template-columns:minmax(0,1fr) 68px;align-items:end;gap:8px;flex:0 0 auto;width:100%;max-width:900px;margin:0 auto;padding:8px 16px calc(10px + env(safe-area-inset-bottom));border-top:1px solid #e4e7f0;background:#fff}.input-label{grid-column:1/-1;font-size:12px;color:#66708a;line-height:1.5}.advisor-input{box-sizing:border-box;width:100%;min-width:0;min-height:44px;max-height:116px;margin:0;padding:10px 12px;border:1px solid #d7dce8;border-radius:10px;background:#f9faff;font-size:16px;line-height:24px;color:#18213d}.admissions-page .send-button{width:68px;padding:10px 4px;background:#6848d7;color:#fff;line-height:24px}.admissions-page button[disabled]{opacity:1;background:#ece8f3;color:#827592}.keyboard-open .advisor-composer{padding-bottom:8px}.compact-chat .advisor-header,.compact-chat .input-label{display:none}.compact-chat .advisor-input{max-height:44px}
.device-tablet .chat-inner{padding-left:28px;padding-right:28px}.device-tablet .chat-bubble{max-width:88%}.device-tablet .chat-bubble.user{max-width:76%}
@media(max-width:375px){.advisor-header{padding:10px 12px;gap:8px}.chat-inner{padding-left:12px;padding-right:12px}.advisor-composer{padding-left:12px;padding-right:12px}.welcome-title{font-size:21px}}
@media(prefers-reduced-motion:reduce){.admissions-page button,.advisor-input{transition:none;animation:none}}
.directory-context-card{margin:12px 0 18px;padding:16px;border:1px solid #ddd4f5;border-radius:16px;background:linear-gradient(145deg,#faf8ff,#f0ebfb)}.directory-context-heading{display:flex;align-items:center;justify-content:space-between;gap:8px}.directory-context-label{color:#6249a0;font-size:12px;font-weight:700}.directory-context-heading .quiet-button{font-size:12px;padding:8px}.directory-context-title{display:block;margin-top:4px;color:#28203f;font-size:20px;font-weight:750;line-height:1.5;overflow-wrap:anywhere}.directory-context-subtitle,.directory-context-note{display:block;margin-top:6px;color:#615875;font-size:13px;line-height:1.65;overflow-wrap:anywhere}.directory-context-note{margin-top:10px}.directory-context-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.admissions-page .directory-context-actions button{width:auto;min-height:44px;padding:10px 12px;font-size:13px}.context-official,.context-restore{background:#fff;color:#5638c3;border:1px solid #ded4f5}.context-use{background:#6848d7;color:#fff}
