<view class="page {{deviceClass}} {{orientation}} coach-hub-page">
  <stemist-header compact="{{true}}" eyebrow="AI COACH" title="今天需要哪种帮助？" />
  <app-nav id="coach-hub-nav" active="coach" is-tablet="{{isTablet}}" show-ai="{{false}}" category="{{category}}" family="{{family}}" route-id="{{routeId}}" stage="{{stage}}" subject-code="{{subjectCode}}" />
  <view class="mode-grid" role="list" aria-label="AI Coach 四种功能">
    <button wx:for="{{modes}}" wx:key="id" class="mode-card mode-{{item.id}}" data-mode="{{item.id}}" bindtap="openMode" role="listitem" aria-label="{{item.title}}：{{item.detail}}">
      <view class="mode-glyph" aria-hidden="true"><image class="mode-illustration" src="/bundles/coach/mode-icons/{{item.id}}.svg" mode="aspectFit" /></view>
      <view class="mode-arrow" aria-hidden="true"></view>
      <text class="mode-title">{{item.title}}</text>
      <text class="mode-detail">{{item.detail}}</text>
    </button>
  </view>
</view>
