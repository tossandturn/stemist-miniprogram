.sources{box-sizing:border-box;max-width:100%;margin-top:12px;color:#26334b}.heading{display:block;margin:0 0 8px;font-size:13px;font-weight:600;color:#42536b}.source-card{box-sizing:border-box;width:100%;max-width:100%;margin:8px 0;padding:14px;border:1px solid #dbe7e3;border-radius:12px;background:#f7fbf9;overflow:hidden}.source-title{display:block;font-size:14px;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.meta{display:block;margin-top:6px;font-size:12px;line-height:1.6;color:#5b6a72;overflow-wrap:anywhere}.excerpt{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-top:10px;padding-left:10px;border-left:2px solid #b5d4c7;white-space:pre-wrap;font-size:13px;line-height:1.65;overflow-wrap:anywhere}.excerpt.expanded{display:block}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.actions button{box-sizing:border-box;min-width:0;min-height:44px;margin:0;padding:10px 12px;border:1px solid #d3e2db;border-radius:8px;background:#fff;color:#226651;font-size:13px;line-height:22px}.actions button::after{border:0}.actions button[disabled]{background:#edf3f0;color:#66746e}.preview{display:block;width:100%;height:auto;margin-top:8px;border:1px solid #dbe7e3;border-radius:6px;background:#fff}.preview-label{font-weight:600;color:#42536b}
