.tavern-page{max-width:920px;background:linear-gradient(180deg,#f2efff 0,#f5f6fa 300px)}
.tavern-note{margin-top:8px;padding:9px 12px;border:1px solid #e4e0f4;border-radius:12px;color:#5d6680;background:rgba(255,255,255,.86);font-size:12px;line-height:1.4;white-space:normal}
.preset-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:12px}.preset-title,.preset-subtitle{display:block}.preset-title{color:#18213d;font-size:18px;font-weight:800}.preset-subtitle{margin-top:1px;color:#66708a;font-size:12px;line-height:1.4}
.category-filter{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:10px}.category-filter button{width:100%;min-width:0;min-height:44px;margin:0;padding:8px 5px;border:1px solid #ded7f8;color:#5638b8;background:#fff;font-size:13px}.category-filter button.active{border-color:#6848d7;color:#fff;background:#6848d7}.category-filter button:active{background:#5536c3}
.persona-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}.persona{display:flex;flex-direction:column;align-items:flex-start;width:100%;min-width:0;min-height:138px;margin:0;padding:11px;border:1px solid #e1e5ed;border-radius:14px;color:#18213d;background:#fff;text-align:left}.persona:active{border-color:#9b88e8;background:#f8f6ff}.persona.active{border-color:#6848d7;background:#f0ecfb}.persona[disabled]{opacity:.48}
.persona-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 auto;width:38px;height:38px;margin-bottom:7px;border-radius:12px;background:#e9e4fc}.tone-companion{background:#f0ecfb}.tone-story{background:#e8f2fb}.tone-fortune{background:#fff1dc}.persona-icon{display:block;width:23px;height:23px}
.persona-tag{display:inline-block;padding:2px 6px;border-radius:999px;color:#5638b8;background:#f0ecfb;font-size:12px;font-weight:700;line-height:1.3}.persona-name{display:block;margin-top:6px;font-size:16px;font-weight:800}.persona-detail{display:block;margin-top:3px;color:#66708a;font-size:12px;line-height:1.42;white-space:normal;overflow-wrap:anywhere}
.selected-workspace{min-width:0}.selected-preset{display:flex;align-items:center;gap:10px;margin-top:9px;padding:9px 11px;border:1px solid #ded7f8;border-radius:14px;background:#fff}.selected-preset .persona-avatar{margin:0}.selected-copy{flex:1;min-width:0}.selected-name,.selected-detail{display:block}.selected-name{margin-top:3px;color:#18213d;font-size:16px;font-weight:800}.selected-detail{margin-top:2px;overflow:hidden;color:#66708a;font-size:12px;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.preset-change{flex:0 0 84px;width:84px;min-width:84px;max-width:84px;min-height:44px;margin:0;padding:8px 6px;border:1px solid #ded7f8;color:#5638b8;background:#f4f1ff;font-size:12px}.preset-change:active{background:#e8e1ff}
.chat-history-head{display:flex;align-items:center;justify-content:space-between;min-height:44px;margin-top:3px;gap:8px}.chat-history-label{color:#66708a;font-size:12px;font-weight:700}.chat-history-actions{display:flex;align-items:center;gap:8px}.history-action{min-width:72px;min-height:44px;margin:0;padding:6px 10px;border:1px solid #ded7f8;color:#5638b8;background:#f4f1ff;font-size:12px}.history-action:active{background:#e8e1ff}.chat-list{height:136px;margin-top:2px;padding:10px;border:1px solid #e4e7f0;border-radius:14px;background:#fff}.chat-turn{max-width:88%;margin:6px 0;padding:9px 11px;border-radius:12px;color:#18213d;font-size:16px;line-height:1.55;overflow-wrap:anywhere}.chat-turn.user{margin-left:auto;background:#ece7ff}.chat-turn.assistant{margin-right:auto;background:#f1f3f8}
.preset-opening{margin-top:9px;padding:11px 12px;border:1px solid #ded7f8;border-radius:14px;background:#fff}.preset-opening-label,.preset-opening-text{display:block}.preset-opening-label{color:#5638b8;font-size:12px;font-weight:800}.preset-opening-text{margin-top:5px;color:#18213d;font-size:15px;line-height:1.5}
.starter-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:8px}.starter-list button.starter-chip{width:100%;min-width:0;min-height:44px;margin:0;padding:6px 7px;border:1px solid #ded7f8;color:#5638b8;background:#f4f1ff;font-size:12px;line-height:1.3;white-space:normal}.starter-list button:active{background:#e8e1ff}
.tavern-page textarea.tavern-input{display:block;width:100%;height:84px;min-height:84px;max-height:84px;margin-top:9px;padding:10px 12px;font-size:16px;line-height:1.5}.tavern-submit,.fortune-primary{min-height:48px;margin-top:8px}.tavern-clear{margin:6px auto calc(env(safe-area-inset-bottom) + 2px)}
.fortune-panel{margin-top:8px}.fortune-note{padding:8px 10px;border-radius:10px;color:#80531a;background:#fff6e8;font-size:12px;line-height:1.4}.spread-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:8px}.spread-option{width:100%;min-width:0;min-height:44px;margin:0;border:1px solid #ded7f8;color:#5638b8;background:#fff}.spread-option.active{border-color:#6848d7;color:#fff;background:#6848d7}.draw-grid{display:grid;grid-template-columns:1fr;gap:8px;margin-top:9px}.draw-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.draw-card{min-width:0;padding:10px 8px;border:1px solid #ded7f8;border-radius:12px;background:#fff;text-align:center}.draw-position,.draw-name,.draw-orientation{display:block;overflow-wrap:anywhere}.draw-position{color:#66708a;font-size:11px}.draw-name{margin-top:5px;color:#18213d;font-size:14px;font-weight:800;line-height:1.35}.draw-orientation{margin-top:4px;color:#5638b8;font-size:12px}.fortune-redraw{min-height:44px;margin-top:8px}
.selected-workspace .status-line{margin-top:7px}.selected-workspace .error,.selected-workspace .warning{margin-top:7px;padding:10px 12px}
.tavern-page.device-tablet .persona-list{grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.tavern-page.device-tablet .persona{min-height:148px;padding:14px}.tavern-page.device-tablet .chat-list{height:250px}.tavern-page.device-tablet textarea.tavern-input{height:88px;min-height:88px;max-height:88px}
@media(max-width:330px){.category-filter{grid-template-columns:repeat(2,minmax(0,1fr))}.persona-list{grid-template-columns:1fr}.persona{min-height:120px}.selected-detail{display:none}.starter-list{grid-template-columns:1fr}.starter-list button.starter-chip{min-height:44px}.draw-grid.three{grid-template-columns:1fr}}
