.tavern-page{max-width:920px;background:linear-gradient(180deg,#f2efff 0,#f5f6fa 300px)}
.tavern-note{margin-top:16px;padding:14px 16px;border:1px solid #e4e0f4;border-radius:14px;color:#5d6680;background:rgba(255,255,255,.86);font-size:13px;line-height:1.6}
.preset-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;margin-top:20px}.preset-title,.preset-subtitle{display:block}.preset-title{color:#18213d;font-size:18px;font-weight:800}.preset-subtitle{margin-top:3px;color:#66708a;font-size:13px;line-height:1.5}.preset-change{flex:0 0 auto;min-height:44px;margin:0;padding:9px 13px;border:1px solid #ded7f8;color:#5638b8;background:#f4f1ff;font-size:13px}.preset-change:active{background:#e8e1ff}
.persona-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}.persona{display:flex;flex-direction:column;align-items:flex-start;width:100%;min-width:0;min-height:158px;margin:0;padding:14px;border:1px solid #e1e5ed;border-radius:15px;color:#18213d;background:#fff;text-align:left}.persona:active{border-color:#9b88e8;background:#f8f6ff}.persona.active{border-color:#6848d7;background:#f0ecfb}.persona[disabled]{opacity:.48}
.persona-avatar{position:relative;flex:0 0 auto;width:42px;height:42px;margin-bottom:10px;border-radius:14px;color:#6848d7;background:#e9e4fc}.avatar-core,.avatar-mark{position:absolute;border:2px solid currentColor}.avatar-keeper .avatar-core{left:9px;top:9px;width:20px;height:18px;border-radius:50%}.avatar-keeper .avatar-mark{right:8px;bottom:7px;width:8px;height:8px;border-width:0 2px 2px 0;transform:rotate(35deg)}.avatar-study-buddy{color:#9b4f70;background:#fae8f0}.avatar-study-buddy .avatar-core{left:7px;top:10px;width:18px;height:16px;border-radius:8px}.avatar-study-buddy .avatar-mark{right:6px;bottom:8px;width:16px;height:13px;border-radius:7px}.avatar-cat-companion{color:#9a6328;background:#fff1dc}.avatar-cat-companion .avatar-core{left:9px;top:12px;width:20px;height:18px;border-radius:8px 8px 11px 11px}.avatar-cat-companion .avatar-mark{left:11px;top:7px;width:16px;height:16px;border-width:2px 2px 0 0;transform:rotate(-45deg)}.avatar-story-traveler{color:#356f9d;background:#e5f3ff}.avatar-story-traveler .avatar-core{left:11px;top:8px;width:18px;height:25px;border-radius:9px 9px 3px 3px}.avatar-story-traveler .avatar-mark{left:17px;top:15px;width:6px;height:6px;border-radius:50%}.avatar-xianxia-guide{color:#34775f;background:#e5f5ed}.avatar-xianxia-guide .avatar-core{left:9px;bottom:9px;width:23px;height:16px;border-width:2px 0 0 2px;transform:skew(-20deg)}.avatar-xianxia-guide .avatar-mark{left:18px;top:7px;width:2px;height:25px;border-width:0 0 0 2px;transform:rotate(40deg)}.avatar-mystery-guide{color:#5d5a73;background:#edeef4}.avatar-mystery-guide .avatar-core{left:8px;top:7px;width:19px;height:19px;border-radius:50%}.avatar-mystery-guide .avatar-mark{right:8px;bottom:8px;width:12px;height:2px;border-width:2px 0 0;transform:rotate(45deg)}
.persona-tag{display:inline-block;padding:3px 7px;border-radius:999px;color:#5638b8;background:#f0ecfb;font-size:12px;font-weight:700;line-height:1.3}.persona-name{display:block;margin-top:8px;font-size:16px;font-weight:800}.persona-detail{display:block;margin-top:5px;color:#66708a;font-size:13px;line-height:1.5;white-space:normal;overflow-wrap:anywhere}
.selected-preset{display:flex;align-items:center;gap:13px;margin-top:14px;padding:14px 16px;border:1px solid #ded7f8;border-radius:15px;background:#fff}.selected-preset .persona-avatar{margin:0}.selected-copy{min-width:0}.selected-name,.selected-detail{display:block}.selected-name{margin-top:5px;color:#18213d;font-size:17px;font-weight:800}.selected-detail{margin-top:4px;color:#66708a;font-size:13px;line-height:1.5;overflow-wrap:anywhere}
.chat-list{height:300px;margin-top:16px;padding:14px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}.chat-turn{max-width:88%;margin:8px 0;padding:11px 13px;border-radius:14px;color:#18213d;font-size:16px;line-height:1.6;overflow-wrap:anywhere}.chat-turn.user{margin-left:auto;background:#ece7ff}.chat-turn.assistant{margin-right:auto;background:#f1f3f8}
.preset-opening{margin-top:16px;padding:18px;border:1px solid #ded7f8;border-radius:16px;background:#fff}.preset-opening-label,.preset-opening-text{display:block}.preset-opening-label{color:#5638b8;font-size:12px;font-weight:800}.preset-opening-text{margin-top:9px;color:#18213d;font-size:16px;line-height:1.65}.choose-preset{margin-top:14px;padding:20px 16px;border:1px dashed #cbc3eb;border-radius:15px;color:#66708a;background:rgba(255,255,255,.72);font-size:14px;text-align:center}
.starter-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.starter-list button{min-height:44px;margin:0;padding:9px 12px;border:1px solid #ded7f8;color:#5638b8;background:#f4f1ff;font-size:13px;white-space:normal}.starter-list button:active{background:#e8e1ff}.tavern-page textarea{min-height:132px;margin-top:14px;font-size:16px}.tavern-submit{min-height:48px}.tavern-clear{margin:10px auto calc(env(safe-area-inset-bottom) + 4px)}
.tavern-page.device-tablet .persona-list{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.tavern-page.device-tablet .persona{min-height:168px;padding:16px}.tavern-page.device-tablet .chat-list{height:360px}
@media(max-width:330px){.preset-head{align-items:flex-start}.preset-change{padding-left:10px;padding-right:10px}.persona-list{grid-template-columns:1fr}.persona{min-height:126px}}
