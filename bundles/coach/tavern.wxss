.tavern-page{max-width:920px;background:linear-gradient(180deg,#f2efff 0,#f5f6fa 300px)}
.page.tavern-page.device-phone{padding-bottom:calc(96px + env(safe-area-inset-bottom));}
.tavern-page .workspace-header-compact{padding-right:0;margin-bottom:8px;}
.tavern-page button.persona{box-sizing:border-box;width:100%;min-width:0;max-width:100%;}
.tavern-note{margin-top:8px;padding:9px 12px;border:1px solid #e4e0f4;border-radius:12px;color:#5d6680;background:rgba(255,255,255,.86);font-size:12px;line-height:1.4;white-space:normal}
.preset-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:12px}.preset-title,.preset-subtitle{display:block}.preset-title{color:#18213d;font-size:18px;font-weight:800}.preset-subtitle{margin-top:1px;color:#66708a;font-size:12px;line-height:1.4}
.category-filter{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:10px}.category-filter button{width:100%;min-width:0;min-height:44px;margin:0;padding:8px 5px;border:1px solid #ded7f8;border-radius:12px;color:#5638b8;background:#fff;font-size:13px;font-weight:700}.category-filter button.active{border-color:#6848d7;color:#fff;background:#6848d7;box-shadow:0 4px 12px rgba(104,72,215,.2)}.category-filter button:active{background:#5536c3}
.persona-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:10px}.persona{display:flex;flex-direction:column;align-items:flex-start;width:100%;min-width:0;min-height:148px;margin:0;padding:11px;border:1px solid #e1e5ed;border-radius:16px;color:#18213d;background:#fff;text-align:left;box-shadow:0 4px 14px rgba(41,38,77,.05);transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}.persona:active{transform:scale(.985);border-color:#9b88e8;box-shadow:0 2px 8px rgba(74,55,145,.12)}.persona.active{border-color:#6848d7;background:#f5f2ff;box-shadow:0 0 0 1px #6848d7,0 6px 16px rgba(104,72,215,.14)}.persona[disabled]{opacity:.48}.persona-top{display:flex;align-items:flex-start;justify-content:space-between;width:100%;gap:7px}
.persona-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 auto;width:52px;height:52px;border:1px solid rgba(104,72,215,.12);border-radius:16px;background:#f0ecfb;overflow:hidden}.persona-icon{display:block;width:48px;height:48px}.role-keeper .persona-avatar{background:#f1eafa}.role-study-buddy .persona-avatar{background:#fae9ef}.role-cat-companion .persona-avatar{background:#fff0dc}.role-story-traveler .persona-avatar{background:#e7f2fb}.role-xianxia-guide .persona-avatar{background:#e7f4ec}.role-mystery-guide .persona-avatar{background:#edf0f5}.role-eastern-oracle .persona-avatar{background:#fff1dc}.role-tarot-reader .persona-avatar{background:#eceafd}
.persona-tag{display:inline-block;max-width:82px;padding:3px 7px;border-radius:999px;color:#5638b8;background:rgba(240,236,251,.92);font-size:12px;font-weight:700;line-height:1.3;white-space:normal}.persona-name{display:block;margin-top:7px;font-size:16px;font-weight:800}.persona-detail{display:block;margin-top:4px;color:#66708a;font-size:13px;font-weight:400;line-height:1.5;white-space:normal;overflow-wrap:anywhere}

.tavern-illustration{display:block;width:100%;height:156px;margin:6px auto 12px;border-radius:18px;background:#eee7fa}
.page.tavern-page.chat-active{position:fixed;top:0;left:0;right:0;box-sizing:border-box;width:100%;max-width:none;min-height:0;margin:0;padding:0;overflow:hidden;background:#ededf0}
.selected-workspace{display:flex;flex-direction:column;box-sizing:border-box;width:100%;height:100%;min-height:0}
.selected-preset{display:flex;flex:0 0 auto;box-sizing:border-box;align-items:center;gap:10px;width:100%;max-width:900px;min-height:68px;margin:0 auto;padding:10px 16px;border-bottom:1px solid #dddde5;background:#f8f8fa}
.selected-preset .persona-avatar{width:36px;height:36px;border-radius:10px}
.selected-preset .persona-icon{width:34px;height:34px}
.selected-copy{flex:1;min-width:0}
.selected-name,.selected-detail{display:block}
.selected-name{color:#18213d;font-size:16px;font-weight:700;line-height:1.4;overflow-wrap:anywhere}
.selected-detail{margin-top:2px;color:#66708a;font-size:12px;line-height:1.4;overflow-wrap:anywhere}
.tavern-page button.preset-change{flex:0 0 68px;box-sizing:border-box;width:68px;max-width:68px;min-width:0;min-height:44px;margin:0;padding:8px 4px;border:1px solid #e1dbea;border-radius:10px;color:#5638b8;background:#f1ecfc;font-size:13px}
.chat-list{display:block;box-sizing:border-box;flex:1;width:100%;min-width:0;max-width:100%;height:0;min-height:0;margin:0;background:#ededf0}
.chat-inner{box-sizing:border-box;width:100%;max-width:900px;margin:0 auto;padding:8px 16px 18px}
.chat-history-head{display:flex;align-items:center;justify-content:space-between;min-height:44px;gap:8px;margin-bottom:8px}
.chat-history-label{color:#66708a;font-size:12px}
.chat-history-actions{display:flex;align-items:center;gap:8px}
.tavern-page .chat-history-actions button.history-action{box-sizing:border-box;width:auto;min-width:44px;max-width:76px;min-height:44px;margin:0;padding:8px 6px;color:#596279;background:transparent;border:0;font-size:12px;line-height:1.4}
.chat-illustration{display:block;width:240px;max-width:100%;height:120px;margin:0 auto 20px;border-radius:16px}
.chat-row{display:flex;align-items:flex-start;gap:10px;margin:0 0 18px}
.chat-row.user{flex-direction:row-reverse}
.message-content{display:flex;flex-direction:column;align-items:flex-start;gap:10px;min-width:0;max-width:calc(100% - 44px)}
.chat-row.user .message-content{align-items:flex-end}
.message-content .chat-turn{max-width:100%}
.message-content.has-draw{width:calc(100% - 44px);max-width:620px}
.tavern-message-art{display:block;width:100%;min-width:0}
.pending-draw-row .message-name{margin:0;color:#66708a}
.reply-media{max-width:100%;border-radius:12px;background:#fff;overflow:hidden}
.reply-media-frame{position:relative;max-width:100%;overflow:hidden;background:#fff}
.sticker-sheet{position:absolute;display:block;max-width:none}
.tavern-page button.reply-picture{display:block;box-sizing:border-box;width:100%;height:100%;min-width:0;max-width:100%;min-height:44px;margin:0;padding:0;border:0;border-radius:12px;background:#fff}
.reply-image{display:block;width:100%;height:100%}
.reply-media-loading,.reply-media-error{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:8px;color:#66708a;background:#f4f2f8;font-size:12px;text-align:center}
.reply-media-loading{pointer-events:none}
.tavern-page button.media-retry{width:auto;min-width:88px;min-height:44px;margin:0;padding:8px 12px;border:1px solid #ded7f8;color:#5638b8;background:#fff;font-size:13px}
.reply-media-caption{display:block;padding:6px 10px 9px;color:#5638b8;font-size:13px;line-height:1.4;text-align:center;overflow-wrap:anywhere}
.reply-media.sticker .reply-media-caption{font-size:15px;font-weight:600}
.message-avatar{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:0 0 34px;width:34px;height:34px;border:1px solid #dfdbea;border-radius:9px;background:#fff}
.user-avatar{color:#fff;background:#7562b8;border-color:#7562b8;font-size:14px;font-weight:600}
.chat-turn{position:relative;box-sizing:border-box;max-width:calc(100% - 44px);min-width:0;padding:10px 12px;border:1px solid #dedee6;border-radius:4px 12px 12px 12px;background:#fff;color:#18213d;font-size:16px;line-height:1.6;overflow-wrap:anywhere;word-break:break-word}
.chat-turn.user{border-color:#c1dcaf;border-radius:12px 4px 12px 12px;background:#d6edc6;white-space:pre-wrap}
.message-name{display:block;margin-bottom:5px;color:#66708a;font-size:12px}
.preset-opening-text{display:block;font-size:15px;line-height:1.6;white-space:pre-wrap}
.typing-status{color:#66708a;font-size:14px}
.chat-tail{height:1px}
.starter-list{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 20px 44px}
.tavern-page .starter-list button.starter-chip{box-sizing:border-box;width:auto;max-width:100%;min-width:0;min-height:44px;margin:0;padding:9px 12px;border:1px solid #ddd6ed;border-radius:12px;color:#5638b8;background:#faf8ff;font-size:13px;font-weight:500;line-height:1.45;white-space:normal}
.chat-composer{box-sizing:border-box;flex:0 0 auto;display:grid;grid-template-columns:minmax(0,1fr) 72px;align-items:end;gap:8px;width:100%;max-width:900px;margin:0 auto;padding:8px 12px calc(8px + env(safe-area-inset-bottom));border-top:1px solid #dcdce4;background:#f8f8fa}
.keyboard-open .chat-composer{padding-bottom:8px}
.fortune-tools{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0}.fortune-spreads{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;flex:1;max-width:240px;min-width:0}.fortune-tools-caption{flex:1;min-width:0;color:#66708a;font-size:12px;line-height:1.5;overflow-wrap:anywhere}.tavern-page button.fortune-draw{box-sizing:border-box;flex:0 0 96px;width:96px;min-width:0;max-width:96px;min-height:44px;margin:0;padding:8px 6px;border:1px solid #ded7f8;border-radius:10px;color:#5638b8;background:#f0ecfb;font-size:13px;line-height:1.5}.tavern-page .fortune-tools button:active{opacity:.8}.compact-chat .fortune-tools{display:none}
.compact-chat .selected-preset{display:none}
.tavern-page.compact-chat textarea.tavern-input{max-height:44px}
.tavern-page textarea.tavern-input{display:block;box-sizing:border-box;width:100%;min-width:0;max-width:100%;height:44px;min-height:44px;max-height:116px;margin:0;padding:10px 12px;border:1px solid #dfdfe7;border-radius:10px;color:#18213d;background:#fff;font-size:16px;line-height:24px}
.tavern-page button.tavern-submit{box-sizing:border-box;width:72px;min-width:0;max-width:72px;min-height:44px;margin:0;padding:10px 5px;border-radius:10px;background:#6848d7;color:#fff;font-size:14px;line-height:24px}
.tavern-page button.tavern-submit[disabled]{color:#75668f;background:#e4ddf2;opacity:1}
.tavern-page button.tavern-submit:active,.preset-change:active{opacity:.8}
.fortune-panel,.fortune-result-priority{margin:12px 0 18px}
.fortune-note{padding:9px 12px;border-radius:10px;color:#80531a;background:#fff6e8;font-size:12px;line-height:1.5}
.spread-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
.tavern-page button.spread-option{box-sizing:border-box;width:100%;min-width:0;max-width:100%;min-height:44px;margin:0;border:1px solid #ded7f8;color:#5638b8;background:#fff;font-size:14px}
.tavern-page button.spread-option.active{border-color:#6848d7;color:#fff;background:#6848d7}
.draw-grid{display:grid;grid-template-columns:1fr;gap:8px;margin-top:10px}
.draw-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.draw-card{min-width:0;padding:12px 8px;border:1px solid #ded7f8;border-radius:12px;background:#fff;text-align:center}
.draw-position,.draw-name,.draw-orientation{display:block;overflow-wrap:anywhere}
.draw-position{color:#66708a;font-size:12px}.draw-name{margin-top:5px;color:#18213d;font-size:14px;font-weight:700;line-height:1.4}.draw-orientation{margin-top:4px;color:#5638b8;font-size:12px}
.fortune-redraw,.fortune-primary{min-height:44px;margin-top:8px}
.selected-workspace .status-line{margin-top:7px}.selected-workspace .error,.selected-workspace .warning{margin-top:8px;padding:10px 12px;font-size:13px;line-height:1.5;overflow-wrap:anywhere}
.page.tavern-page.device-tablet:not(.chat-active){max-width:1040px}
.tavern-page.device-tablet .persona-list{grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.tavern-page.device-tablet.landscape .persona-list{grid-template-columns:repeat(4,minmax(0,1fr))}
.tavern-page.device-tablet .persona{min-height:154px;padding:14px}
@media(min-width:768px){.chat-inner{padding-left:28px;padding-right:28px}.chat-turn{max-width:75%}.chat-composer{padding-left:24px;padding-right:24px}}
@media(max-width:375px){.chat-inner{padding-left:12px;padding-right:12px}.selected-preset{padding-left:12px;padding-right:12px}.chat-row{gap:8px}.chat-turn{max-width:calc(100% - 42px)}}
@media(max-width:330px){.category-filter{grid-template-columns:repeat(2,minmax(0,1fr))}.persona-list{grid-template-columns:1fr}.persona{min-height:126px}.persona-top{align-items:center}.selected-detail{font-size:12px}.starter-list{margin-left:0}.draw-grid.three{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.persona{transition:none}.persona:active{transform:none}}
