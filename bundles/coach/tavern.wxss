.tavern-page{max-width:920px;background:linear-gradient(180deg,#f2efff 0,#f5f6fa 300px)}.tavern-note{margin-top:16px;padding:14px 16px;border:1px solid #e4e0f4;border-radius:14px;color:#5d6680;background:rgba(255,255,255,.86);font-size:13px;line-height:1.6}.persona-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:16px}.persona{display:flex;flex-direction:column;align-items:flex-start;width:100%;min-width:0;min-height:132px;margin:0;padding:14px;border:1px solid #e1e5ed;border-radius:15px;color:#18213d;background:#fff;text-align:left}.persona.active{border-color:#6848d7;background:#f0ecfb}.persona-avatar{position:relative;width:38px;height:38px;margin-bottom:10px;border-radius:50%;background:#e9e4fc}.persona-avatar::before{position:absolute;left:12px;top:8px;width:12px;height:12px;border:2px solid #6848d7;border-radius:50%;content:''}.persona-avatar view{position:absolute;left:8px;bottom:5px;width:22px;height:10px;border:2px solid #6848d7;border-bottom:0;border-radius:12px 12px 0 0}.persona-name{font-size:15px;font-weight:800}.persona-detail{display:block;margin-top:5px;color:#66708a;font-size:12px;line-height:1.45}.chat-list{height:300px;margin-top:16px;padding:14px;border:1px solid #e4e7f0;border-radius:16px;background:#fff}.chat-turn{max-width:88%;margin:8px 0;padding:11px 13px;border-radius:14px;color:#18213d;font-size:14px;line-height:1.6;overflow-wrap:anywhere}.chat-turn.user{margin-left:auto;background:#ece7ff}.chat-turn.assistant{margin-right:auto;background:#f1f3f8}.tavern-empty{margin-top:16px;padding:28px 16px;border:1px dashed #d8dcef;border-radius:16px;color:#66708a;background:rgba(255,255,255,.72);text-align:center}.starter-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.starter-list button{min-height:44px;margin:0;padding:9px 12px;border:1px solid #ded7f8;color:#5638b8;background:#f4f1ff;font-size:13px}.tavern-page textarea{min-height:132px;margin-top:14px}.tavern-submit{min-height:48px}.tavern-clear{margin:10px auto calc(env(safe-area-inset-bottom) + 4px)}.tavern-page.device-tablet .chat-list{height:360px}.tavern-page.device-tablet .persona{min-height:142px}@media(max-width:375px){.persona-list{grid-template-columns:1fr}.persona{min-height:100px}.chat-list{height:260px}}
.chat-turn{font-size:16px}
