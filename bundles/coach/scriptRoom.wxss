page{overflow:hidden;}.script-room{display:flex;flex-direction:column;max-width:1100px;margin:0 auto;color:#18213d;background:#f5f6fb;box-sizing:border-box;--room-border:#e4e7f0;--room-muted:#66708a;--room-purple:#5638b8;}
.room-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;background:#fff;border-bottom:1px solid var(--room-border);flex:none;}.room-title{display:block;font-size:19px;font-weight:700;}.room-status{display:block;font-size:12px;color:var(--room-muted);margin-top:4px;}.room-heading .text-button{margin:0;flex:none;font-size:13px;}
.room-scroll{flex:1;min-height:0;height:0;width:100%;}.lobby-content,.panel-content{padding:16px 16px 32px;max-width:780px;margin:0 auto;}.room-error{margin:8px 12px;padding:10px;font-size:13px;max-height:140px;overflow:auto;flex:none;}.room-invite{padding:18px;background:#ece8fa;border-radius:16px;line-height:1.7;font-size:14px;}.invite-code{font-size:19px;font-weight:700;letter-spacing:1px;margin:12px 0;word-break:break-all;}.button-pair{display:flex;gap:12px;}.button-pair button{flex:1;margin-top:8px;}
.role-grid{display:grid;grid-template-columns:1fr;gap:12px;margin:16px 0;}.role-card{padding:18px;border:1px solid var(--room-border);border-radius:16px;background:#fff;}.role-card.selected{border-color:#7357e8;background:#f2edff;}.role-name{display:block;font-size:19px;font-weight:700;}.role-tagline{display:block;font-size:15px;margin-top:5px;}.role-state{display:block;color:var(--room-muted);font-size:12px;margin-top:8px;}
.seat-strip{display:flex;gap:6px;padding:10px 12px;flex:none;}.seat{flex:1;min-width:0;padding:8px 3px;border-radius:10px;text-align:center;background:#fff;border:1px solid var(--room-border);font-size:13px;}.seat.mine{border-color:#7357e8;}.seat-detail{display:block;font-size:11px;color:var(--room-muted);margin-top:4px;}
.room-tabs{display:flex;gap:4px;padding:0 10px 8px;flex:none;}.room-tabs button{width:auto;flex:1;min-width:0;min-height:44px;padding:8px 3px;margin:0;border:1px solid var(--room-border);background:#fff;font-size:13px;line-height:1.5;}.room-tabs button.active{background:#eae3fd;border-color:#a794e8;color:var(--room-purple);}.phase-banner{padding:10px 16px;font-size:14px;color:var(--room-purple);background:#ece8fa;min-height:44px;box-sizing:border-box;}
.channel-picker{margin:0 12px 8px;padding:12px 14px;border:1px solid var(--room-border);border-radius:12px;background:#fff;font-size:14px;flex:none;}.channel-picker text{float:right;color:var(--room-purple);}.chat-inner{max-width:760px;margin:0 auto;padding:4px 14px 24px;}.script-message{margin:12px 0;padding:14px;border:1px solid var(--room-border);border-radius:14px;background:#fff;}.script-message.mine{margin-left:24px;background:#ede8fc;}.script-message.kind-narration{background:#eef0f7;border:none;border-left:3px solid #9d95bc;}.script-message.kind-evidence{border-left:3px solid #3a9d85;}.script-message.kind-system{background:transparent;border:none;padding:8px;font-size:13px;}.speaker{display:block;font-size:12px;font-weight:600;color:var(--room-muted);margin-bottom:8px;}.message-body,.prose{display:block;font-size:16px;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;}.scene-image{display:block;width:100%;margin-top:14px;border-radius:10px;}.job-state{padding:12px;font-size:13px;color:var(--room-muted);background:#f0edf9;border-radius:12px;margin:10px 0;}
.room-composer{flex:none;padding:8px 12px calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--room-border);background:#fff;}.composer-label{display:block;font-size:12px;color:var(--room-muted);margin-bottom:6px;}.composer-row{display:flex;gap:10px;align-items:flex-end;}.composer-row textarea{flex:1;min-width:0;min-height:58px;height:72px;max-height:100px;padding:10px;box-sizing:border-box;font-size:16px;line-height:1.5;background:#f8f9fd;}.composer-row button.primary{width:68px;min-height:48px;flex:none;margin:0;padding:10px 6px;}
.section-title{display:block;font-size:19px;font-weight:700;margin:8px 0 14px;line-height:1.5;}.private-badge{display:inline-block;background:#e9f4f0;color:#276a59;font-size:12px;padding:8px 12px;border-radius:8px;margin-bottom:16px;}.identity-panel .section-title{margin-top:24px;}.room-help{display:block;font-size:13px;line-height:1.7;color:var(--room-muted);margin:12px 0;}.objective-card,.clue-card{padding:18px;margin-bottom:16px;border:1px solid var(--room-border);border-radius:16px;background:#fff;}.objective-card{background:#f1edfc;border-color:#d8d0ee;}.progress-label{display:block;font-size:13px;font-weight:600;color:var(--room-purple);margin-top:14px;}.clue-title{display:block;font-size:17px;font-weight:700;margin-bottom:8px;}.solved{color:#276a59;font-size:16px;}.device-tablet.landscape .role-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.device-tablet .lobby-content,.device-tablet .panel-content{padding:24px 32px 40px;}.device-tablet .room-composer{padding-left:24px;padding-right:24px;}.device-tablet .seat-strip{max-width:760px;width:100%;margin:0 auto;box-sizing:border-box;}
