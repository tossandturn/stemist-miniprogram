.review-page{max-width:760px;margin:0 auto;box-sizing:border-box;padding-bottom:24px}.review-card{padding:20px;background:#fff;border:1px solid #e4e7f0;border-radius:16px;margin-top:12px}.review-kicker{color:#5638c3;font-size:14px;font-weight:600}.review-title{font-size:23px;font-weight:700;color:#18213d;margin:12px 0;overflow-wrap:anywhere}.review-status{font-size:16px;margin:24px 0 12px;color:#343b50}.review-card button{margin-top:12px;min-height:48px;width:100%;box-sizing:border-box;white-space:normal}.review-note{font-size:14px;line-height:1.6;color:#66708a;margin-top:16px}.review-canvas{position:fixed;left:-3000px;top:0;width:1200px;height:2048px;pointer-events:none}
