.script-catalog{max-width:1100px;margin:0 auto;padding-bottom:40px;--script-brand:#6848d7;--script-muted:#66708a;}
.script-intro{margin:16px 0 24px;padding:24px 20px;border-radius:20px;background:linear-gradient(130deg,#ebe6fc,#e9f5f2);}
.script-eyebrow{display:block;font-size:13px;font-weight:600;color:#5638b8;letter-spacing:.5px;}
.script-hero-title{display:block;font-size:27px;font-weight:700;margin:12px 0;line-height:1.45;}
.script-subtitle,.script-summary{display:block;font-size:15px;line-height:1.7;color:var(--script-muted);}
.script-join .field-label{margin:0 0 10px;}.join-row{display:flex;gap:10px;align-items:center;}.join-row .input{flex:1;min-width:0;}.join-row button.secondary{width:76px;flex:none;margin:0;}
.script-grid{display:grid;grid-template-columns:1fr;gap:20px;margin-top:20px;}.script-card{overflow:hidden;border:1px solid #e4e7f0;border-radius:20px;background:#fff;}
.script-cover{display:block;width:100%;height:190px;background:#e8e6ee;}.script-card-body{padding:20px;}.script-title{display:block;font-size:23px;font-weight:700;margin:9px 0;}.script-summary{color:#18213d;min-height:72px;}.script-warning{display:block;font-size:12px;color:#6b5865;line-height:1.6;margin-top:12px;}
.section-title{display:block;margin:24px 0 12px;font-size:18px;font-weight:700;}.resume-card{display:flex;justify-content:space-between;gap:12px;width:100%;margin:8px 0;padding:12px 14px;min-height:48px;border:1px solid #e4e7f0;background:#fff;font-size:15px;text-align:left;}.muted{font-size:13px;color:#66708a;}.script-footnote{display:block;margin-top:24px;text-align:center;font-size:12px;color:#66708a;}
.device-tablet.landscape .script-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.device-tablet .script-cover{height:220px;}
.script-catalog .script-intro{background:linear-gradient(130deg,#1c2031,#323044);color:#f6eee3;}.script-intro .script-eyebrow{color:#d8c1ed;}.script-intro .script-subtitle{color:#c4c7d4;}
.script-card{--poster-surface:#26304b;--poster-text:#f3effb;--poster-muted:#c3bfd2;--poster-accent:#bca7ef;--poster-button:#251d39;--poster-line:#515a77;}
.script-card.script-theme-rain{--poster-surface:#302720;--poster-text:#fff2db;--poster-muted:#c8bba4;--poster-accent:#e7b475;--poster-button:#2b1c0c;--poster-line:#68523b;}
.script-card.script-theme-velvet{--poster-surface:#2b2029;--poster-text:#f8edf0;--poster-muted:#cab6c0;--poster-accent:#dfa4ac;--poster-button:#271216;--poster-line:#694554;}
.script-card.script-theme-fog{--poster-surface:#192b33;--poster-text:#e8f3ef;--poster-muted:#a6c0c4;--poster-accent:#8cc9be;--poster-button:#102c2d;--poster-line:#38585f;}
.script-card.script-theme-stars{--poster-surface:#1d2b43;--poster-text:#f2f0dc;--poster-muted:#b9c8dc;--poster-accent:#e3c88a;--poster-button:#2d250e;--poster-line:#485672;}
.script-catalog .script-card{background:var(--poster-surface);border-color:var(--poster-line);color:var(--poster-text);}
.script-poster{position:relative;height:240px;overflow:hidden;}.script-catalog .script-cover{height:100%;width:100%;}
.script-poster-shade{position:absolute;inset:0;background:linear-gradient(180deg,transparent 20%,rgba(0,0,0,.18) 42%,rgba(0,0,0,.9));}
.script-poster-copy{position:absolute;left:20px;right:20px;bottom:20px;}.script-card .script-eyebrow{color:var(--poster-accent);font-size:12px;letter-spacing:2px;}
.script-card .script-title{font-family:'Songti SC','STSong',serif;font-size:29px;line-height:1.4;letter-spacing:2px;color:#fff5e9;}
.script-poster-line{display:block;color:#e3d9cc;font-size:12px;line-height:1.7;}
.script-card .script-summary{color:var(--poster-text);margin:10px 0;min-height:0;}.script-card .script-subtitle,.script-card .script-warning{color:var(--poster-muted);}
.script-meta{display:block;font-size:12px;color:var(--poster-accent);letter-spacing:.5px;}.script-card .primary{background:var(--poster-accent);color:var(--poster-button);border:1px solid var(--poster-accent);box-shadow:none;}
.device-tablet.landscape .script-poster{height:270px;}
.catalog-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:4px 0 24px;}.catalog-heading>view{flex:1;min-width:0;}.catalog-title{display:block;font-size:24px;line-height:1.4;font-weight:700;color:#18213d;}.catalog-subtitle{display:block;color:#66708a;font-size:12px;line-height:1.7;margin-top:6px;}.script-catalog button.join-entry{width:82px;min-height:44px;flex:0 0 82px;padding:8px 0;margin:0;background:transparent;color:#5638b8;font-size:13px;line-height:1.5;}
.script-catalog button.script-card{width:100%;padding:0;margin:0;text-align:left;line-height:1.5;font-weight:400;}.script-catalog .script-poster{height:220px;}.script-catalog .script-title{margin:7px 0;}.poster-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 18px;font-size:12px;line-height:1.5;color:var(--poster-muted);}.poster-footer text:last-child{color:var(--poster-accent);flex:none;}
.resume-row{display:flex;align-items:center;gap:12px;border-bottom:1px solid #e4e7f0;padding-bottom:14px;margin-bottom:20px;}.script-catalog button.resume-latest{display:flex;justify-content:space-between;align-items:center;gap:12px;width:0;min-width:0;flex:1;min-height:48px;margin:0;padding:0;background:transparent;text-align:left;font-size:14px;color:#18213d;}.script-catalog button.history-entry{width:48px;flex:0 0 48px;min-height:44px;margin:0;padding:8px 0;font-size:13px;background:transparent;color:#5638b8;}
.catalog-overlay{position:fixed;inset:0;z-index:90;background:rgba(15,20,40,.58);display:flex;align-items:flex-end;justify-content:center;}.catalog-sheet{background:#f9f9fc;color:#18213d;width:100%;max-width:560px;max-height:88%;box-sizing:border-box;padding:18px 22px calc(22px + env(safe-area-inset-bottom));border-radius:22px 22px 0 0;display:flex;flex-direction:column;}.catalog-sheet-header{display:flex;justify-content:space-between;align-items:center;gap:16px;flex:none;margin-bottom:12px;}.catalog-sheet-header>text{font-size:22px;font-family:'Songti SC','STSong',serif;font-weight:700;}.catalog-sheet-header button{width:60px;min-height:44px;flex:0 0 60px;margin:0;padding:8px 0;font-size:14px;line-height:1.5;color:#5638b8;background:transparent;}.catalog-detail-scroll{height:330px;min-height:0;flex:1;}.detail-meta{display:block;color:#66708a;font-size:13px;line-height:1.7;margin:6px 0 18px;}.detail-summary{display:block;font-size:16px;line-height:1.9;margin:16px 0;color:#18213d;}.detail-warning{display:block;color:#79536b;font-size:13px;line-height:1.7;margin:18px 0;}.detail-help{display:block;font-size:13px;line-height:1.7;color:#66708a;margin:14px 0;}.invite-error{display:block;color:#a83a54;font-size:13px;line-height:1.7;margin-top:12px;}
.device-tablet .script-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.device-tablet .script-poster{height:260px;}@media(max-height:500px){.catalog-sheet{padding-top:8px;padding-bottom:12px;}.catalog-detail-scroll{height:220px;}}
.script-catalog .script-grid{margin-top:0;gap:18px;}
