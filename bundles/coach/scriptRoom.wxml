<block wx:if="{{!__entryGateBlocked}}">
<view class="script-room {{deviceClass}} {{orientation}}" style="height:{{windowHeight}}px">
 <view class="room-heading"><view><text class="room-title">{{room.title || '剧本房间'}}</text><text class="room-status">{{room.phaseLabel || ''}} · {{syncLabel}}</text></view><button wx:if="{{room}}" class="text-button" bindtap="exit" disabled="{{busy || pending}}">退出本局</button></view>
 <view wx:if="{{loading}}" class="notice">正在连接房间…</view>
 <view wx:if="{{error}}" class="error room-error">{{error}}<button wx:if="{{!room}}" class="text-button" bindtap="open">重试连接</button><button wx:if="{{pending}}" class="text-button" bindtap="retryAction" disabled="{{busy}}">重试操作</button></view>
 <scroll-view wx:if="{{room.phase === 'lobby'}}" class="room-scroll" scroll-y="{{true}}">
  <view class="lobby-content"><view class="room-invite"><text class="section-title">等朋友，也可以独自开场</text><text>空位将在开始时由 AI 补齐。每人先选角色，再准备。</text><view class="invite-code">{{room.inviteCode}}</view><view class="button-pair"><button class="secondary" bindtap="copyInvite">复制房间码</button><button class="primary" open-type="share">邀请朋友</button></view></view>
  <view class="role-grid"><view wx:for="{{room.seats}}" wx:key="id" class="role-card {{item.isMe ? 'selected' : ''}}"><text class="role-name">{{item.name}}</text><text class="role-tagline">{{item.tagline}}</text><text class="role-state">{{item.isMe ? '我的角色' : item.control === 'human' ? '好友已选择' : '空位 · 开始后由 AI 扮演'}}{{item.ready ? ' · 已准备' : ''}}</text><button wx:if="{{item.control === 'open'}}" class="secondary" data-type="claim" data-role="{{item.id}}" bindtap="action" disabled="{{busy || pending}}">选择此角色</button></view></view>
  <view class="warning">{{room.warning}}</view><button class="secondary" data-type="ready" bindtap="action" disabled="{{busy || pending}}">准备 / 取消准备</button><button wx:if="{{room.isHost}}" class="primary" data-type="start" bindtap="action" loading="{{busy}}" disabled="{{busy || pending}}">开始故事 · AI 补齐空位</button><text wx:else class="room-help">准备后等待房主开始。</text></view>
 </scroll-view>
 <block wx:elif="{{room}}">
  <view class="seat-strip"><view wx:for="{{room.seats}}" wx:key="id" class="seat {{item.isMe ? 'mine' : ''}}"><text>{{item.name}}</text><text class="seat-detail">{{item.isMe ? '我' : item.control === 'ai' ? 'AI' : item.online ? '在线' : '暂离'}}{{item.advanced ? ' · 已确认' : ''}}</text></view></view>
  <view class="room-tabs" role="tablist"><button class="{{panel === 'chat' ? 'active' : ''}}" data-panel="chat" bindtap="panel">对话</button><button class="{{panel === 'identity' ? 'active' : ''}}" data-panel="identity" bindtap="panel">我的身份</button><button class="{{panel === 'evidence' ? 'active' : ''}}" data-panel="evidence" bindtap="panel">线索与任务</button><button wx:if="{{room.phase === 'vote' || room.phase === 'ended'}}" class="{{panel === 'ending' ? 'active' : ''}}" data-panel="ending" bindtap="panel">{{room.phase === 'ended' ? '复盘' : '投票'}}</button></view>
  <view wx:if="{{room.phase === 'vote' && panel !== 'ending'}}" class="phase-banner" data-panel="ending" bindtap="panel">线索已齐，进入最终投票 ›</view>
  <view wx:if="{{room.phase === 'ended' && panel !== 'ending'}}" class="phase-banner" data-panel="ending" bindtap="panel">故事已结束，查看真相与复盘 ›</view>
  <button wx:if="{{nextStep && panel === 'chat'}}" class="next-step" data-panel="evidence" bindtap="panel">{{nextStep}}<text>查看任务 ›</text></button>
  <block wx:if="{{panel === 'chat'}}">
   <picker class="channel-picker" range="{{channels}}" range-key="name" value="{{channelIndex}}" bindchange="channel"><view>{{channels[channelIndex].name}}<text> 切换 ›</text></view></picker>
   <scroll-view class="room-scroll chat-scroll" scroll-y="{{true}}" scroll-into-view="{{anchor}}" enhanced="{{true}}">
    <view class="chat-inner"><view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="script-message {{item.mine ? 'mine' : ''}} {{item.parts.length ? 'has-parts' : ''}} kind-{{item.kind}}">
     <block wx:if="{{item.parts.length}}"><view wx:for="{{item.parts}}" wx:for-item="part" wx:key="id" class="message-part part-{{part.kind}}"><text class="speaker">{{part.label}} · AI{{item.target !== 'public' ? ' · 私聊' : ''}}</text><text class="message-body" selectable="{{true}}">{{part.text}}</text></view></block>
     <block wx:else><text class="speaker">{{item.label}}{{item.ai ? ' · AI' : ''}}{{item.target !== 'public' ? ' · 私聊' : ''}}</text><text class="message-body" selectable="{{true}}">{{item.text}}</text></block>
     <image wx:if="{{item.image}}" class="scene-image" src="{{item.image}}" mode="widthFix" lazy-load="{{true}}" data-src="{{item.image}}" bindtap="preview" aria-label="本幕氛围插图，点击放大" />
     <view wx:if="{{item.imageJobId}}" class="inline-image-job">
      <image wx:if="{{item.generated.path}}" class="scene-image" src="{{item.generated.path}}" mode="widthFix" data-src="{{item.generated.path}}" data-id="{{item.imageId}}" bindtap="preview" binderror="imageFailed" aria-label="AI 生成的剧情氛围图，点击放大" />
      <button wx:elif="{{item.generated.error}}" class="text-button" data-id="{{item.imageId}}" bindtap="retryImageFetch">{{item.generated.error}}</button>
      <block wx:elif="{{item.imageStatus === 'failed'}}"><text>{{item.imageError}}</text><button wx:if="{{item.canRetry}}" class="text-button" data-id="{{item.imageJobId}}" bindtap="retryAi" disabled="{{busy || pending}}">重试配图</button></block>
      <text wx:else>{{item.imageStatus === 'done' ? '配图已生成，正在加载…' : '正在画这幅场景 · 可以继续聊天'}}</text>
      <text class="image-caption">AI 氛围配图 · 不作为线索或机关答案</text>
     </view>
    </view>
    <view wx:for="{{jobs}}" wx:key="id" class="job-state"><text>{{item.status === 'failed' ? 'AI 回复未完成，游戏进度已保存。' : 'AI 正在组织回复… 可以继续查看线索。'}}</text><button wx:if="{{item.status === 'failed'}}" class="text-button" data-id="{{item.id}}" bindtap="retryAi" disabled="{{busy || pending}}">重试回复</button></view>
    <text wx:if="{{!messages.length}}" class="room-help">这里的消息只发给当前选择的对象。</text></view>
   </scroll-view>
   <view wx:if="{{canChat}}" class="room-composer"><view class="composer-tools"><label class="composer-label">{{imageMode ? '配图发送至' : '发送至'}}：{{channels[channelIndex].name}}</label><button wx:if="{{room.scriptVersion >= 2}}" class="image-mode {{imageMode ? 'selected' : ''}}" bindtap="toggleImage" disabled="{{busy || pending}}">{{imageMode ? '取消配图' : '画个场景'}}</button></view><view class="composer-row"><textarea value="{{draft}}" bindinput="typeDraft" maxlength="{{imageMode ? 500 : 2400}}" placeholder="{{imageMode ? '描述当前想看的画面…' : '以你的角色发言，也可以说“画一下…”'}}" adjust-position="{{true}}" cursor-spacing="16" show-confirm-bar="{{false}}" /><button class="primary" bindtap="send" disabled="{{busy || pending || !draft}}" loading="{{busy}}">{{imageMode ? '生成' : '发送'}}</button></view></view>
  </block>
  <scroll-view wx:elif="{{panel === 'identity'}}" class="room-scroll" scroll-y="{{true}}"><view class="panel-content identity-panel"><text class="private-badge">仅你可见 · 请按自己的意愿分享</text>
   <view wx:if="{{currentMission}}" class="mission-card"><text class="mission-kicker">第 {{room.stage + 1}} 幕 · 我的决定</text><text class="section-title">{{currentMission.title}}</text><text class="prose">{{currentMission.prompt}}</text><block wx:if="{{!currentMission.choiceId}}"><button wx:for="{{currentMission.options}}" wx:key="id" class="secondary mission-option" data-id="{{currentMission.id}}" data-option="{{item.id}}" bindtap="chooseMission" disabled="{{busy || pending}}">{{item.label}}</button><text class="room-help">先查看本幕自己的线索。选择会私密保存，不会替你公开发言。</text></block><block wx:else><text class="mission-saved">决定已保存</text><text class="prose">{{currentMission.consequence}}</text></block></view>
   <text class="section-title">{{room.myRole.name}} · {{room.myRole.tagline}}</text><text class="prose">{{room.myRole.biography}}</text><text class="section-title">你的秘密</text><text class="prose">{{room.myRole.secret}}</text><text class="section-title">个人目标</text><text class="prose">{{room.myRole.goal}}</text>
   <block wx:if="{{room.myRole.card}}"><text class="section-title">这一刻的你</text><text class="prose">{{room.myRole.card.desire}}</text><text class="room-help">{{room.myRole.card.contradiction}}</text></block>
   <view wx:for="{{room.myMissions}}" wx:key="id" wx:if="{{item.choiceId && item.stage < room.stage}}" class="journey-entry"><text class="clue-title">{{item.title}}</text><text class="prose">{{item.consequence}}</text></view>
   <text wx:if="{{!currentMission}}" class="room-help">个人目标用于角色体验，由你在复盘中回顾。</text></view></scroll-view>
  <scroll-view wx:elif="{{panel === 'evidence'}}" class="room-scroll" scroll-y="{{true}}"><view class="panel-content">
   <view wx:if="{{nextStep}}" class="next-task"><text>{{nextStep}}</text><button wx:if="{{currentMission && !currentMission.choiceId}}" class="text-button" data-panel="identity" bindtap="panel">我的个人决定 ›</button></view>
   <view wx:if="{{room.act}}" class="objective-card"><text class="section-title">{{room.act.title}}</text><text class="prose">{{room.act.objective}}</text><text class="progress-label">本幕公开线索 {{room.act.shared}} / {{room.act.total}}</text></view>
   <text class="section-title">我的搜证位置</text><button wx:for="{{room.searchOptions}}" wx:key="id" class="secondary" data-type="inspect" data-id="{{item.id}}" bindtap="clue" disabled="{{busy || pending || item.found}}">{{item.title}} · {{item.found ? '已查看' : '查看线索'}}</button>
   <text class="section-title">我的线索</text><view wx:for="{{room.myClues}}" wx:key="id" class="clue-card"><text class="clue-title">{{item.title}}</text><text class="prose">{{item.text}}</text><button wx:if="{{!item.shared}}" class="secondary" data-type="share" data-id="{{item.id}}" bindtap="clue" disabled="{{busy || pending}}">公开给所有人</button><text wx:else class="room-help">已公开</text></view>
   <block wx:if="{{room.evidenceRequests.length}}"><text class="section-title">问问同伴的发现</text><button wx:for="{{room.evidenceRequests}}" wx:key="roleId" class="secondary" data-role="{{item.roleId}}" bindtap="requestEvidence" disabled="{{busy || pending}}">请 {{item.name}} 分享本幕线索</button><text class="room-help">关键物证由剧本固定，不会因 AI 回答失败而丢失。</text></block>
   <view wx:if="{{room.act}}" class="objective-card conclusion-card"><text class="section-title">共同结论</text><view wx:if="{{room.act.puzzle}}"><text class="field-label">{{room.act.puzzle.question}}</text><text wx:if="{{room.act.puzzle.solved}}" class="solved">已解开</text><block wx:else><input class="input" value="{{answer}}" bindinput="typeAnswer" maxlength="200" placeholder="输入团队结论" /><button class="secondary" bindtap="solve" disabled="{{busy || pending || room.act.shared < room.act.total}}">核验答案</button><text wx:if="{{room.act.puzzle.hint}}" class="room-help">提示：{{room.act.puzzle.hint}}</text></block></view><button class="primary" data-type="advance" bindtap="action" disabled="{{busy || pending || !canAdvance}}">我已完成本幕，确认继续</button><text class="room-help">{{canAdvance ? '所有真人确认后推进，不跳过好友的选择。' : nextStep}}</text></view>
   <text class="section-title">公共线索墙</text><view wx:for="{{room.publicClues}}" wx:key="id" class="clue-card"><text class="clue-title">{{item.title}}</text><text class="prose">{{item.text}}</text></view>
  </view></scroll-view>
  <scroll-view wx:elif="{{panel === 'ending'}}" class="room-scroll" scroll-y="{{true}}"><view class="panel-content"><block wx:if="{{room.phase === 'vote'}}"><text class="section-title">{{room.ballot.question}}</text><text class="room-help">结局由真人投票决定，AI 只提供建议；全员提交后一起揭晓，平票不替任何人改票。</text><button wx:for="{{room.ballot.options}}" wx:key="id" class="secondary" data-id="{{item.id}}" bindtap="vote" disabled="{{busy || pending || room.ballot.myVote}}">{{item.label}}</button><text wx:if="{{room.ballot.myVote}}" class="room-help">你的投票已提交，等待其他人。</text></block><block wx:if="{{room.ending}}"><text class="section-title">你们的结局</text><text class="prose">{{room.ending.text}}</text><block wx:if="{{room.ending.myJourney.length}}"><text class="section-title">我的三次决定</text><text class="private-badge">这部分仍仅自己可见</text><view wx:for="{{room.ending.myJourney}}" wx:key="title" class="journey-entry"><text class="clue-title">{{item.title}}</text><text class="mission-saved">{{item.choice}}</text><text class="prose">{{item.text}}</text></view></block><text class="section-title">完整真相</text><text class="prose">{{room.ending.truth}}</text><view wx:for="{{room.ending.roles}}" wx:key="id" class="clue-card"><text class="clue-title">{{item.name}}的另一面</text><text class="prose">{{item.secret}}</text><text class="room-help">个人目标：{{item.goal}}</text></view></block></view></scroll-view>
 </block>
</view>
</block>
<view wx:else class="entry-blocked"><text>加入房间需要登录，角色资料仅本人可见。</text><navigator url="/bundles/account/auth?required=1" open-type="reLaunch">进入登录</navigator></view>
