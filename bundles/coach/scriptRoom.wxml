<block wx:if="{{!__entryGateBlocked}}">
<view class="script-room themed-room theme-{{scene.theme || 'neutral'}} {{motionPlaying ? 'motion-on' : 'motion-off'}} {{windowHeight < 560 ? 'compact-scene' : ''}} {{windowHeight < 440 ? 'tiny-scene' : ''}} {{deviceClass}} {{orientation}} {{scene.solved ? 'scene-solved' : ''}}" style="height:{{windowHeight}}px">
 <view class="scene-backdrop" aria-hidden="true"><image wx:if="{{scene.image && !sceneImageFailed}}" class="scene-backdrop-art" src="{{scene.image}}" mode="aspectFill" binderror="sceneImageFailed" /><view class="scene-scrim" /><view class="scene-effect effect-a" /><view class="scene-effect effect-b" /></view>
 <view class="room-surface" aria-hidden="{{introOpen || settingsOpen || menuOpen}}">
  <view wx:if="{{room && panel === 'chat'}}" class="story-toolbar">
   <button class="story-scene-action" bindtap="replayScene" disabled="{{room.phase === 'lobby' || room.phase === 'closed' || !scene.supported}}" aria-label="查看当前场景">
    <text class="toolbar-chapter">{{room.phase === 'lobby' ? '选角准备' : scene.chapter || room.phaseLabel}}</text><text class="toolbar-place">{{room.phase === 'lobby' ? '空位由 AI 补齐' : scene.place}}</text><text wx:if="{{room.phase !== 'lobby' && scene.supported}}" class="toolbar-chevron">›</text>
   </button>
   <button class="room-menu-trigger" bindtap="openRoomMenu" aria-label="打开本局菜单">本局<text class="menu-dots">···</text></button>
  </view>
  <view wx:elif="{{room}}" class="panel-toolbar"><button class="panel-back" bindtap="backFromPanel">‹ 返回</button><text class="panel-heading">{{panelTitle}}</text></view>
  <view wx:if="{{loading}}" class="notice">正在连接房间…</view>
  <view wx:if="{{error}}" class="error room-error">{{error}}<button wx:if="{{!room && !accessEnded}}" class="text-button" bindtap="open">重试连接</button><button wx:if="{{accessEnded}}" class="text-button" bindtap="returnToScripts">返回剧本列表</button><button wx:if="{{pending}}" class="text-button" bindtap="retryAction" disabled="{{busy}}">重试操作</button></view>
  <scroll-view wx:if="{{room.phase === 'lobby'}}" class="room-scroll" scroll-y="{{true}}">
   <view class="lobby-content">
    <view class="lobby-poster"><image wx:if="{{scene.image && !sceneImageFailed}}" src="{{scene.image}}" mode="aspectFill" class="lobby-poster-image" binderror="sceneImageFailed" /><view class="lobby-poster-shade" /><view class="lobby-poster-copy"><text class="scene-eyebrow">{{scene.genre}}</text><text class="lobby-poster-title">{{room.title}}</text><text class="lobby-poster-line">{{scene.eyebrow}}</text></view></view>
    <view class="lobby-section-heading"><text class="section-title">选择你的角色</text><button class="invite-friend" open-type="share">邀请朋友</button></view>
    <view class="role-grid"><view wx:for="{{room.seats}}" wx:key="id" class="role-card {{item.isMe ? 'selected' : ''}}"><text class="role-name">{{item.name}}</text><text class="role-tagline">{{item.tagline}}</text><text class="role-state">{{item.isMe ? '我的角色' : item.control === 'human' ? '好友已选择' : '可选择'}}{{item.ready ? ' · 已准备' : ''}}</text><button wx:if="{{item.control === 'open'}}" class="secondary" data-type="claim" data-role="{{item.id}}" bindtap="action" disabled="{{busy || pending}}">选择此角色</button></view></view>
    <text wx:if="{{room.warning}}" class="content-advisory">{{room.warning}}</text>
    <button wx:if="{{room.myRoleId}}" class="{{myReady ? 'secondary' : 'primary'}}" data-type="ready" bindtap="action" disabled="{{busy || pending}}">{{myReady ? '已准备 · 点击取消' : '准备好了'}}</button>
    <button wx:if="{{room.isHost && allReady}}" class="primary" data-type="start" bindtap="action" loading="{{busy}}" disabled="{{busy || pending}}">开始故事</button><text wx:elif="{{myReady}}" class="room-help">等待其他玩家准备。</text>
   </view>
  </scroll-view>
  <block wx:elif="{{room}}">
   <block wx:if="{{panel === 'chat'}}">
    <scroll-view class="room-scroll chat-scroll" scroll-y="{{true}}" scroll-into-view="{{anchor}}" enhanced="{{true}}">
     <view class="chat-inner">
      <text wx:if="{{channel !== 'public'}}" class="private-conversation">与{{recipientLabel}}的私聊 · 其他玩家不可见</text>
      <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="script-message {{item.mine ? 'mine' : ''}} {{item.parts.length ? 'has-parts' : ''}} kind-{{item.kind}}">
       <block wx:if="{{item.parts.length}}"><view wx:for="{{item.parts}}" wx:for-item="part" wx:key="id" class="message-part part-{{part.kind}}"><text class="speaker">{{part.label}}{{part.kind !== 'narration' ? ' · AI' : ''}}</text><text class="message-body" selectable="{{true}}">{{part.text}}</text></view></block>
       <block wx:else><text class="speaker">{{item.label}}{{item.ai ? ' · AI' : ''}}</text><text class="message-body" selectable="{{true}}">{{item.text}}</text></block>
       <image wx:if="{{item.image}}" class="scene-image" src="{{item.image}}" mode="widthFix" lazy-load="{{true}}" data-src="{{item.image}}" bindtap="preview" aria-label="本幕氛围插图，点击放大" />
       <view wx:if="{{item.imageJobId}}" class="inline-image-job">
        <image wx:if="{{item.generated.path}}" class="scene-image" src="{{item.generated.path}}" mode="widthFix" data-src="{{item.generated.path}}" data-id="{{item.imageId}}" bindtap="preview" binderror="imageFailed" aria-label="AI 生成的剧情氛围图，点击放大" />
        <button wx:elif="{{item.generated.error}}" class="text-button" data-id="{{item.imageId}}" bindtap="retryImageFetch">{{item.generated.error}}</button>
        <block wx:elif="{{item.imageStatus === 'failed'}}"><text>{{item.imageError}}</text><button wx:if="{{item.canRetry}}" class="text-button" data-id="{{item.imageJobId}}" bindtap="retryAi" disabled="{{busy || pending}}">重试配图</button></block>
        <text wx:else>{{item.imageStatus === 'done' ? '配图已生成，正在加载…' : '正在画这幅场景 · 可以继续聊天'}}</text>
        <text class="image-caption">AI 氛围配图 · 不作为线索或机关答案</text>
       </view>
      </view>
      <view wx:for="{{jobs}}" wx:key="id" class="job-state"><text>{{item.status === 'failed' ? 'AI 回复未完成，游戏进度已保存。' : 'AI 正在回复…'}}</text><button wx:if="{{item.status === 'failed'}}" class="text-button" data-id="{{item.id}}" bindtap="retryAi" disabled="{{busy || pending}}">重试回复</button></view>
      <text wx:if="{{!messages.length}}" class="room-help">开始你们的对话。</text>
      <button wx:if="{{room.phase === 'vote' || room.phase === 'ended'}}" class="story-continuation" data-panel="ending" bindtap="panel">{{room.phase === 'vote' ? '进入最终投票' : '查看结局与复盘'}} ›</button>
     </view>
    </scroll-view>
    <view wx:if="{{canChat && !introOpen && !settingsOpen && !menuOpen}}" class="room-composer">
     <view wx:if="{{imageMode}}" class="image-mode-context"><text>描述想看的画面</text><button class="image-mode" bindtap="toggleImage">取消配图</button></view>
     <view class="composer-row"><button class="recipient-trigger" bindtap="selectRecipient" aria-label="选择消息接收人">{{recipientLabel}}<text>⌄</text></button><textarea value="{{draft}}" bindinput="typeDraft" maxlength="{{imageMode ? 500 : 2400}}" placeholder="{{imageMode ? '描述当前想看的画面…' : '以你的角色发言…'}}" placeholder-class="composer-placeholder" adjust-position="{{true}}" cursor-spacing="16" show-confirm-bar="{{false}}" /><button class="primary" bindtap="send" disabled="{{busy || pending || !draft}}" loading="{{busy}}">{{imageMode ? '生成' : '发送'}}</button></view>
    </view>
   </block>
   <scroll-view wx:elif="{{panel === 'identity'}}" class="room-scroll secondary-scroll" scroll-y="{{true}}">
    <view class="panel-content identity-panel"><text class="private-note">仅你可见</text><text class="identity-name">{{room.myRole.name}}</text><text class="identity-tagline">{{room.myRole.tagline}}</text>
     <view class="disclosure"><button class="disclosure-trigger" data-section="profile" bindtap="toggleIdentity" aria-expanded="{{identitySection === 'profile'}}">人物与目标<text>{{identitySection === 'profile' ? '−' : '+'}}</text></button><view wx:if="{{identitySection === 'profile'}}" class="disclosure-content"><text class="prose">{{room.myRole.biography}}</text><text class="field-label">个人目标</text><text class="prose">{{room.myRole.goal}}</text></view></view>
     <view class="disclosure"><button class="disclosure-trigger" data-section="secret" bindtap="toggleIdentity" aria-expanded="{{identitySection === 'secret'}}">我的秘密<text>{{identitySection === 'secret' ? '−' : '+'}}</text></button><view wx:if="{{identitySection === 'secret'}}" class="disclosure-content"><text class="prose">{{room.myRole.secret}}</text></view></view>
     <view wx:if="{{currentMission}}" class="disclosure"><button class="disclosure-trigger" data-section="mission" bindtap="toggleIdentity" aria-expanded="{{identitySection === 'mission'}}">本幕决定<text>{{currentMission.choiceId ? '已保存' : identitySection === 'mission' ? '−' : '+'}}</text></button><view wx:if="{{identitySection === 'mission'}}" class="disclosure-content"><text class="section-title">{{currentMission.title}}</text><text class="prose">{{currentMission.prompt}}</text><block wx:if="{{!currentMission.choiceId}}"><button wx:for="{{currentMission.options}}" wx:key="id" class="secondary mission-option" data-id="{{currentMission.id}}" data-option="{{item.id}}" bindtap="chooseMission" disabled="{{busy || pending || room.phase !== 'play'}}">{{item.label}}</button><text class="room-help">先查看本幕自己的线索。决定仅自己可见。</text></block><text wx:else class="prose">{{currentMission.consequence}}</text></view></view>
     <view wx:if="{{pastMissions.length}}" class="disclosure"><button class="disclosure-trigger" data-section="journey" bindtap="toggleIdentity" aria-expanded="{{identitySection === 'journey'}}">此前的决定<text>{{identitySection === 'journey' ? '−' : '+'}}</text></button><view wx:if="{{identitySection === 'journey'}}" class="disclosure-content"><view wx:for="{{pastMissions}}" wx:key="id" class="journey-entry"><text class="clue-title">{{item.title}}</text><text class="prose">{{item.consequence}}</text></view></view></view>
    </view>
   </scroll-view>
   <scroll-view wx:elif="{{panel === 'evidence'}}" class="room-scroll secondary-scroll" scroll-y="{{true}}">
    <view class="panel-content">
     <view wx:if="{{room.act}}" class="task-summary"><text class="section-title">{{room.act.title}}</text><text class="prose">{{room.act.objective}}</text><text class="progress-label">已公开 {{room.act.shared}} / {{room.act.total}} 条线索</text></view>
     <text wx:if="{{room.searchOptions.length}}" class="section-title">我的搜证位置</text><button wx:for="{{room.searchOptions}}" wx:key="id" class="secondary search-choice" data-type="inspect" data-id="{{item.id}}" bindtap="clue" disabled="{{busy || pending || item.found || room.phase !== 'play'}}">{{item.title}}<text>{{item.found ? '已查看' : '查看 ›'}}</text></button>
     <view wx:for="{{currentMyClues}}" wx:key="id" class="clue-card"><text class="clue-title">{{item.title}}</text><text class="prose">{{item.text}}</text><button wx:if="{{!item.shared}}" class="secondary" data-type="share" data-id="{{item.id}}" bindtap="clue" disabled="{{busy || pending || room.phase !== 'play'}}">公开给所有人</button><text wx:else class="room-help">已公开</text></view>
     <view wx:if="{{room.evidenceRequests.length}}" class="disclosure"><button class="disclosure-trigger" bindtap="toggleCompanions" aria-expanded="{{companionsOpen}}">同伴的发现<text>{{room.evidenceRequests.length}} 条待询问 · {{companionsOpen ? '收起' : '展开'}}</text></button><view wx:if="{{companionsOpen}}" class="disclosure-content"><button wx:for="{{room.evidenceRequests}}" wx:key="roleId" class="secondary search-choice" data-role="{{item.roleId}}" bindtap="requestEvidence" disabled="{{busy || pending || room.phase !== 'play'}}">{{item.name}}<text>请 TA 分享 ›</text></button></view></view>
     <view class="disclosure"><button class="disclosure-trigger" bindtap="togglePublicClues" aria-expanded="{{publicCluesOpen}}">公共线索<text>{{currentPublicClues.length}} 条 · {{publicCluesOpen ? '收起' : '展开'}}</text></button><view wx:if="{{publicCluesOpen}}" class="disclosure-content"><view wx:for="{{currentPublicClues}}" wx:key="id" class="clue-card"><text class="clue-title">{{item.title}}</text><text class="prose">{{item.text}}</text></view><text wx:if="{{!currentPublicClues.length}}" class="room-help">还没有公开的本幕线索。</text></view></view>
     <view wx:if="{{previousMyClues.length || previousPublicClues.length}}" class="disclosure"><button class="disclosure-trigger" bindtap="togglePastClues" aria-expanded="{{pastCluesOpen}}">此前的线索<text>{{pastCluesOpen ? '−' : '+'}}</text></button><view wx:if="{{pastCluesOpen}}" class="disclosure-content"><text class="field-label">我的记录 · 仅自己可见</text><view wx:for="{{previousMyClues}}" wx:key="id" class="clue-card"><text class="clue-title">{{item.title}}</text><text class="prose">{{item.text}}</text></view><text class="field-label">公共记录</text><view wx:for="{{previousPublicClues}}" wx:key="id" class="clue-card"><text class="clue-title">{{item.title}}</text><text class="prose">{{item.text}}</text></view></view></view>
     <view wx:if="{{room.act && room.act.shared === room.act.total}}" class="conclusion-card">
      <view wx:if="{{room.act.puzzle}}"><text class="section-title">共同结论</text><text class="field-label">{{room.act.puzzle.question}}</text><text wx:if="{{room.act.puzzle.solved}}" class="solved">已解开</text><block wx:else><input wx:if="{{!introOpen && !settingsOpen && !menuOpen}}" class="input" value="{{answer}}" bindinput="typeAnswer" maxlength="200" placeholder="输入团队结论" /><button class="secondary" bindtap="solve" disabled="{{busy || pending || !answer || room.phase !== 'play'}}">核验答案</button><text wx:if="{{room.act.puzzle.hint}}" class="room-help">提示：{{room.act.puzzle.hint}}</text></block></view>
      <button wx:if="{{currentMission && !currentMission.choiceId}}" class="secondary" bindtap="showDecision">作出我的本幕决定 ›</button>
      <button wx:if="{{canAdvance && !myAdvanced}}" class="primary" data-type="advance" bindtap="action" disabled="{{busy || pending}}">完成本幕，确认继续</button><text wx:elif="{{myAdvanced}}" class="room-help">你已确认，等待其他玩家。</text>
     </view><text wx:elif="{{nextStep}}" class="room-help">{{nextStep}}</text>
    </view>
   </scroll-view>
   <scroll-view wx:elif="{{panel === 'players'}}" class="room-scroll secondary-scroll" scroll-y="{{true}}"><view class="panel-content"><text class="room-help">{{humanCount}} 位真人 · {{aiCount}} 位 AI</text><view wx:for="{{room.seats}}" wx:key="id" class="player-row"><view class="player-copy"><text class="role-name">{{item.name}}<text class="player-state">{{item.isMe ? '我' : item.control === 'ai' ? 'AI' : item.online ? '在线' : '暂离'}}</text></text><text class="role-tagline">{{item.tagline}}</text></view><button wx:if="{{!item.isMe && canChat}}" class="player-chat" data-role="{{item.id}}" bindtap="chatWithRole">私聊</button><button wx:elif="{{item.isMe}}" class="player-chat" data-panel="identity" bindtap="panel">身份</button></view></view></scroll-view>
   <scroll-view wx:elif="{{panel === 'ending'}}" class="room-scroll secondary-scroll" scroll-y="{{true}}"><view class="panel-content">
    <block wx:if="{{room.phase === 'vote'}}"><text class="section-title">{{room.ballot.question}}</text><text class="room-help">提交后不能修改，所有人完成后一起揭晓。</text><button wx:for="{{room.ballot.options}}" wx:key="id" class="secondary" data-id="{{item.id}}" bindtap="vote" disabled="{{busy || pending || room.ballot.myVote}}">{{item.label}}</button><text wx:if="{{room.ballot.myVote}}" class="room-help">你的投票已提交，等待其他人。</text></block>
    <block wx:if="{{room.ending}}"><text class="scene-eyebrow">故事落幕</text><text class="section-title">你们的结局</text><text class="prose ending-prose">{{room.ending.text}}</text>
     <view class="disclosure"><button class="disclosure-trigger" data-section="truth" bindtap="toggleDebrief" aria-expanded="{{debriefSection === 'truth'}}">完整真相<text>{{debriefSection === 'truth' ? '−' : '+'}}</text></button><view wx:if="{{debriefSection === 'truth'}}" class="disclosure-content"><text class="prose">{{room.ending.truth}}</text></view></view>
     <view wx:if="{{room.ending.myJourney.length}}" class="disclosure"><button class="disclosure-trigger" data-section="choices" bindtap="toggleDebrief" aria-expanded="{{debriefSection === 'choices'}}">我的三次决定<text>{{debriefSection === 'choices' ? '−' : '+'}}</text></button><view wx:if="{{debriefSection === 'choices'}}" class="disclosure-content"><text class="private-note">仅自己可见</text><view wx:for="{{room.ending.myJourney}}" wx:key="title" class="journey-entry"><text class="clue-title">{{item.title}}</text><text class="mission-saved">{{item.choice}}</text><text class="prose">{{item.text}}</text></view></view></view>
     <view class="disclosure"><button class="disclosure-trigger" data-section="roles" bindtap="toggleDebrief" aria-expanded="{{debriefSection === 'roles'}}">角色的另一面<text>{{debriefSection === 'roles' ? '−' : '+'}}</text></button><view wx:if="{{debriefSection === 'roles'}}" class="disclosure-content"><view wx:for="{{room.ending.roles}}" wx:key="id" class="journey-entry"><text class="clue-title">{{item.name}}</text><text class="prose">{{item.secret}}</text><text class="room-help">个人目标：{{item.goal}}</text></view></view></view>
    </block>
   </view></scroll-view>
  </block>
 </view>
 <view wx:if="{{introOpen && scene}}" class="scene-intro" role="dialog" aria-modal="true" aria-label="{{scene.chapter}}场景开场">
  <image wx:if="{{scene.image && !sceneImageFailed}}" class="intro-art" src="{{scene.image}}" mode="aspectFill" binderror="sceneImageFailed" /><view class="intro-shade" /><view class="scene-effect effect-a" aria-hidden="true" /><view class="scene-effect effect-b" aria-hidden="true" />
  <view class="intro-top"><text class="scene-eyebrow">{{scene.genre}}</text><button class="intro-skip" bindtap="dismissScene">跳过开场</button></view>
  <view class="intro-content"><text class="intro-chapter">{{scene.chapter}}</text><text class="intro-title">{{scene.place}}</text><text class="intro-moment">{{scene.moment}}</text><scroll-view class="intro-copy-scroll" scroll-y="{{true}}"><text class="intro-copy">{{scene.intro}}</text></scroll-view><text wx:if="{{sceneImageFailed}}" class="intro-fallback">场景图暂未载入，剧情仍可继续。</text><button class="primary intro-enter" bindtap="dismissScene">进入场景</button></view>
 </view>
 <view wx:if="{{menuOpen}}" class="atmosphere-mask" bindtap="closeRoomMenu"><view class="atmosphere-sheet room-menu-sheet" catchtap="swallowTouch" role="dialog" aria-modal="true" aria-label="本局菜单"><view class="atmosphere-sheet-header"><text class="section-title">本局</text><button class="text-button" bindtap="closeRoomMenu">关闭</button></view><scroll-view class="room-menu-scroll" scroll-y="{{true}}">
  <text class="menu-summary">{{room.title}}{{room.myRole.name ? ' · ' + room.myRole.name : ''}}</text>
  <block wx:if="{{room.phase !== 'lobby'}}"><button class="menu-item" data-panel="identity" bindtap="panel">我的身份<text>仅自己可见 ›</text></button><button class="menu-item" data-panel="evidence" bindtap="panel">{{room.act ? '本幕任务' : '线索记录'}}<text wx:if="{{room.act}}">{{room.act.shared}} / {{room.act.total}} 条线索 ›</text><text wx:else>查看 ›</text></button><button class="menu-item" data-panel="players" bindtap="panel">同场玩家<text>{{humanCount}} 真人 · {{aiCount}} AI ›</text></button><button wx:if="{{room.phase === 'vote' || room.phase === 'ended'}}" class="menu-item" data-panel="ending" bindtap="panel">{{room.phase === 'vote' ? '最终投票' : '结局与复盘'}}<text>查看 ›</text></button></block>
  <block wx:else><button class="menu-item" open-type="share">邀请朋友<text>分享 ›</text></button><button class="menu-item" bindtap="copyInvite">复制房间码<text>复制 ›</text></button></block>
  <view class="menu-group"><button wx:if="{{canChat && room.scriptVersion >= 2}}" class="menu-item" bindtap="beginImage">画个场景<text>描述画面 ›</text></button><button class="menu-item" bindtap="openAtmosphere">视觉氛围<text>{{motionEnabled ? '动态' : '静态'}} ›</text></button></view>
  <view class="menu-footer"><text>{{syncLabel}}</text><button class="menu-exit" bindtap="exit" disabled="{{busy || pending}}">退出本局</button></view>
 </scroll-view></view></view>
 <view wx:if="{{settingsOpen}}" class="atmosphere-mask" bindtap="closeAtmosphere"><view class="atmosphere-sheet" catchtap="swallowTouch" role="dialog" aria-modal="true" aria-label="视觉氛围设置"><view class="atmosphere-sheet-header"><text class="section-title">视觉氛围</text><button class="text-button" bindtap="closeAtmosphere">关闭</button></view><text class="room-help">{{scene.genre}} · {{scene.place}}</text><view class="atmosphere-setting-row"><view><text class="field-label">动态氛围</text><text class="room-help">关闭后保留场景图与主题配色</text></view><switch checked="{{motionEnabled}}" color="{{scene.accent}}" bindchange="setMotion" aria-label="动态氛围开关" /></view><button wx:if="{{room.phase !== 'lobby' && room.phase !== 'closed'}}" class="secondary" bindtap="replayScene">重看本幕场景</button><button wx:if="{{sceneImageFailed}}" class="secondary" bindtap="retrySceneImage">重新加载场景图</button><text class="atmosphere-note">插图和光影仅营造氛围，解谜以文字线索为准。</text></view></view>
</view>
</block>
<view wx:else class="entry-blocked"><text>加入房间需要登录，角色资料仅本人可见。</text><navigator url="/bundles/account/auth?required=1" open-type="reLaunch">进入登录</navigator></view>
