.membership-page{max-width:1120px;margin:0 auto;padding-bottom:calc(24px + env(safe-area-inset-bottom))}
.member-layout{display:flex;flex-direction:column;gap:20px}.member-main{min-width:0;display:flex;flex-direction:column;gap:16px}
.membership-card{border:1px solid #dcd5f6;background:linear-gradient(150deg,#fff 35%,#f2edff);padding:24px}.member-eyebrow{font-size:13px;font-weight:600;color:#5638c3;letter-spacing:.5px}.member-heading{margin-top:12px;font-size:23px;line-height:1.4;font-weight:700;color:#18213d}
.member-price{display:flex;align-items:baseline;gap:4px;margin-top:24px;color:#5638c3;font-size:48px;line-height:1.2;font-weight:700}.member-price .currency{font-size:24px}.member-price .period{margin-left:8px;font-size:16px;font-weight:400;color:#66708a}.member-price-loading{min-height:58px;margin-top:24px;color:#66708a}
.member-terms,.member-footnote,.member-empty,.test-account-help{display:block;font-size:13px;line-height:1.7;color:#66708a}.member-terms{margin-top:8px}.member-active,.member-status{margin-top:20px;padding:12px 14px;border-radius:12px;background:#fff;color:#5638c3;font-weight:600;font-size:15px}.member-active{color:#226446;background:#eaf6ef}.member-expiry{display:block;margin-top:4px;font-size:13px;font-weight:400}
.member-checkout,.member-benefits,.member-orders{padding:20px}.test-account-card{padding:16px 20px}.trial-warning{margin-bottom:16px;padding:12px;border:1px solid #e6c57c;border-radius:10px;background:#fff7e6;color:#79571e;font-size:14px;line-height:1.7}.setup-note{margin-bottom:16px;font-size:15px;line-height:1.7;color:#66708a}
.test-account-help{margin-top:6px}.test-account-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:8px;color:#18213d;font-size:14px;overflow-wrap:anywhere}.copy-account{min-width:72px;min-height:44px;margin:0}
.consent-label{min-height:48px;display:flex;align-items:center;gap:8px;margin-bottom:16px;font-size:13px;line-height:1.7;color:#18213d}.member-cta{width:100%;min-height:48px;margin:0;font-size:16px}.member-cta[disabled]{color:#66708a;background:#e7e9f1;opacity:1}.member-progress{margin-top:16px;display:flex;align-items:center;gap:9px;color:#5638c3;font-size:14px}.member-dot{width:8px;height:8px;flex-shrink:0;border-radius:50%;background:#7357e8}.member-notice{margin-top:12px;padding:12px;border-radius:10px;background:#f1ecfd;color:#5638c3;line-height:1.7;font-size:14px}.member-success{background:#eaf6ef;color:#226446}.member-refresh{width:100%;min-height:44px;margin-top:12px;font-size:14px}
.benefits{margin:24px 0 16px;display:flex;flex-direction:column;gap:20px}.benefit{display:flex;align-items:flex-start;gap:12px}.benefit-mark{flex-shrink:0;width:18px;height:18px;border:2px solid #7357e8;border-radius:6px;margin-top:3px;box-sizing:border-box}.benefit-title{font-size:16px;line-height:1.5;font-weight:600;color:#18213d}.benefit-detail{margin-top:3px;font-size:13px;line-height:1.7;color:#66708a}
.member-orders{min-width:0}.member-empty{margin-top:16px}.member-order{padding:18px 0;border-bottom:1px solid #e4e7f0}.member-order:last-child{border-bottom:0;padding-bottom:0}.order-row{display:flex;justify-content:space-between;align-items:center;gap:12px;min-width:0}.order-name,.order-price{font-weight:600;font-size:15px;color:#18213d}.order-meta{margin-top:8px;font-size:12px;line-height:1.6;color:#66708a;flex-wrap:wrap}.order-id{font-size:12px;color:#66708a;overflow-wrap:anywhere}.order-check{min-width:72px;min-height:44px;flex-shrink:0;margin:0;padding:0 6px;font-size:13px}
@media(min-width:900px){.device-tablet .member-layout{flex-direction:row;align-items:flex-start;gap:24px}.device-tablet .member-main{flex:1.2}.device-tablet .member-orders{flex:1}}
@media(max-width:374px){.membership-card,.member-orders{padding:18px}.member-price{font-size:40px}.member-heading{font-size:21px}.test-account-row{align-items:flex-start;flex-direction:column}.copy-account{width:100%}}
@media(prefers-reduced-motion:reduce){.member-dot{animation:none}}
