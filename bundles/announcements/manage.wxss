.announcement-manager-page{padding-bottom:calc(132rpx + env(safe-area-inset-bottom));}.announcement-manager-intro{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:16px;padding:18px;border:1px solid #e4e7f0;border-radius:18px;background:#fff}.announcement-manager-title{display:block;color:#18213d;font-size:22px;font-weight:750}.announcement-manager-copy{display:block;margin-top:6px;color:#66708a;font-size:14px;line-height:1.6}.announcement-manager-intro button{flex:0 0 auto;width:auto;min-width:88px;min-height:44px;margin:0}.announcement-manager-state,.announcement-manager-status{margin:16px 0;padding:13px 14px;border-radius:12px;background:#f0ecff;color:#5638c3;font-size:14px}.announcement-form,.announcement-manager-list{padding:18px;border:1px solid #e4e7f0;border-radius:18px;background:#fff}.field-label{display:block;margin-top:16px;color:#18213d;font-size:15px;font-weight:700}.field-label:first-child{margin-top:0}.field-help{display:block;margin-top:7px;color:#66708a;font-size:13px;line-height:1.55}.announcement-input,.announcement-select,.announcement-textarea{box-sizing:border-box;width:100%;margin-top:8px;border:1px solid #d8deeb;border-radius:12px;background:#fff;color:#18213d;font-size:15px}.announcement-input{height:48px;padding:0 13px}.announcement-input-spaced{margin-top:10px}.announcement-select{display:flex;align-items:center;justify-content:space-between;min-height:48px;padding:12px 13px}.announcement-select text:last-child{color:#66708a;font-size:13px}.announcement-textarea{min-height:168px;padding:13px;line-height:1.65}.announcement-switch{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:16px}.announcement-switch .field-label{margin-top:0}.announcement-form-actions{display:flex;gap:10px;margin-top:18px}.announcement-form-actions button{flex:1;min-height:48px;margin:0}.announcement-manager-list{margin-top:16px}.announcement-manager-list-head,.announcement-manager-card{display:flex;align-items:center;justify-content:space-between;gap:14px}.announcement-manager-list-head{padding-bottom:12px;color:#66708a;font-size:13px}.announcement-manager-list-head text:first-child{color:#18213d;font-size:17px;font-weight:750}.announcement-manager-card{padding:14px 0;border-top:1px solid #edf0f5}.announcement-manager-card-title,.announcement-manager-card-meta{display:block}.announcement-manager-card-title{color:#18213d;font-size:15px;font-weight:700;line-height:1.45}.announcement-manager-card-meta{margin-top:5px;color:#66708a;font-size:12px}.announcement-manager-card-actions{display:flex;flex:0 0 auto;gap:8px}.announcement-manager-card-actions button{width:auto;min-height:44px;margin:0;padding:10px}.announcement-archive{color:#b33b55}@media(max-width:480px){.announcement-manager-intro{display:block}.announcement-manager-intro button{margin-top:12px}.announcement-manager-card{align-items:flex-start}.announcement-manager-card-actions{flex-direction:column}.announcement-form-actions{display:block}.announcement-form-actions button+button{margin-top:10px}}
