.announcement-page{padding-bottom:calc(132rpx + env(safe-area-inset-bottom));}.announcement-intro{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:18px;padding:18px;border:1px solid #e4e7f0;border-radius:18px;background:#fff;box-shadow:0 12rpx 30rpx rgba(42,31,89,.04)}.announcement-title{display:block;color:#18213d;font-size:22px;font-weight:750}.announcement-copy{display:block;margin-top:6px;color:#66708a;font-size:14px;line-height:1.65}.announcement-manage{flex:0 0 auto;width:auto;min-width:104px;min-height:44px;margin:0}.announcement-filters{display:flex;gap:8px;overflow-x:auto;padding:2px 0 12px}.announcement-filters button{flex:0 0 auto;width:auto;min-width:64px;min-height:44px;margin:0;padding:9px 14px;border:1px solid #e4e7f0;border-radius:999px;background:#fff;color:#536079;font-size:13px}.announcement-filters button.active{border-color:#7357e8;background:#f0ecff;color:#5638c3;font-weight:700}.announcement-state,.announcement-unread{margin:16px 0;padding:12px 14px;border-radius:12px;background:#f0ecff;color:#5638c3;font-size:14px}.announcement-list{display:grid;gap:12px}.announcement-card{padding:17px 18px;border:1px solid #e4e7f0;border-radius:18px;background:#fff;box-shadow:0 3px 14px rgba(28,36,70,.03)}.announcement-card.unread{border-color:#cfc3ff}.announcement-card-pressed{background:#f8f6ff}.announcement-meta,.announcement-tags{display:flex;align-items:center;gap:7px}.announcement-meta{justify-content:space-between}.announcement-category,.announcement-pinned,.announcement-new{padding:4px 8px;border-radius:999px;font-size:11px;font-weight:700}.announcement-category{background:#eef0f8;color:#536079}.announcement-category-feature{background:#f0ecff;color:#5638c3}.announcement-category-learning{background:#e7f8f0;color:#0f8668}.announcement-category-service{background:#fff6e8;color:#865f1e}.announcement-pinned{background:#f0ecff;color:#5638c3}.announcement-new{background:#fff0f2;color:#b33b55}.announcement-date{color:#6d758b;font-size:12px}.announcement-card-title{display:block;margin-top:12px;color:#18213d;font-size:18px;font-weight:750;line-height:1.45}.announcement-summary,.announcement-body,.announcement-expand{display:block}.announcement-summary{margin-top:7px;color:#66708a;font-size:14px;line-height:1.6}.announcement-detail{margin-top:16px;padding-top:14px;border-top:1px solid #edf0f5}.announcement-body{white-space:pre-wrap;color:#33405e;font-size:15px;line-height:1.72}.announcement-action{width:auto;min-width:112px;min-height:44px;margin:14px 0 0;padding:9px 13px}.announcement-expand{margin-top:14px;color:#5638c3;font-size:13px;font-weight:700}.announcement-load-more{display:flex;justify-content:center;margin:18px 0}.announcement-load-more button{width:auto;min-width:148px;min-height:44px;margin:0}@media(max-width:480px){.announcement-intro{display:block}.announcement-manage{margin-top:12px}}
