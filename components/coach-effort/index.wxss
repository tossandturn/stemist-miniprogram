:host{display:block;flex:none;min-width:0}
.effort{margin:8px 0;min-width:0;font-size:13px;line-height:1.5;color:#18213d}
.effort-row{box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;min-width:0;min-height:44px;padding:9px 12px;border:1px solid #e0dbea;border-radius:10px;background:#f8f6ff}
.effort-value{color:#5638c3;font-weight:600;text-align:right;overflow-wrap:anywhere}
.effort-row.disabled{opacity:.6}
.effort-note,.effort-error{display:block;margin-top:4px;font-size:12px;color:#66708a}
.effort-error{color:#a22e48}
.compact{margin:0 16px 6px}
