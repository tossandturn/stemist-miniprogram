.text-practice { margin-top: 18rpx; }
.text-practice .context-card { margin-top: 0; padding: 22rpx; border-left: 6rpx solid #7357e8; border-radius: 14rpx; background: #fff; }
.context-card-title { color: #18213d; font-size: 27rpx; font-weight: 800; }
.context-card-text { margin-top: 8rpx; color: #66708a; font-size: 23rpx; line-height: 1.5; }
.text-practice .field-label { display: block; margin: 22rpx 0 10rpx; color: #4e5a76; font-size: 24rpx; font-weight: 750; }
.text-practice textarea { width: 100%; min-height: 340rpx; box-sizing: border-box; padding: 22rpx; border: 1rpx solid #dfe4ef; border-radius: 14rpx; color: #18213d; background: #fff; font-size: 28rpx; line-height: 1.55; }
.text-practice-meta { display: flex; justify-content: space-between; margin-top: 8rpx; color: #6d758b; font-size: 20rpx; }
.text-practice .primary, .text-practice .secondary { width: 100%; min-height: 84rpx; margin-top: 18rpx; }
.text-practice .error { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; color: #b33b55; background: #fff0f2; font-size: 23rpx; }
.text-practice .retry-button { margin-top: 12rpx; }
.text-practice .account-recovery { margin-top: 12rpx; }
.text-practice .result { margin-top: 18rpx; padding: 22rpx; border: 1rpx solid #dceee7; border-radius: 14rpx; color: #18213d; background: #fff; white-space: pre-wrap; font-size: 26rpx; line-height: 1.6; }
.text-practice .warning { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; color: #8a5b18; background: #fff6e8; font-size: 23rpx; line-height: 1.45; }
@media (min-width: 768px) { .text-practice textarea { min-height: 420rpx; } }
@media (min-width: 768px) {
  .text-practice .context-card { padding: 18px; border-radius: 12px; }
  .text-practice .context-card-title { font-size: 20px; }
  .text-practice .context-card-text { font-size: 14px; }
  .text-practice .field-label { font-size: 14px; }
  .text-practice textarea { min-height: 320px; padding: 16px; font-size: 16px; }
  .text-practice-meta { font-size: 12px; }
  .text-practice .primary, .text-practice .secondary { min-height: 48px; font-size: 16px; }
}
