:host { display:block;width:100%; }
.pdf-progress { width:100%;margin-top:12px;padding:12px;border:1px solid #dcd5f7;border-radius:12px;background:#faf9ff;color:#18213d;box-sizing:border-box; }
.pdf-progress.has-error { border-color:#ead7b2;background:#fffaf0; }
.pdf-progress-head { display:flex;align-items:center;justify-content:space-between;gap:10px; }
.pdf-progress-copy { flex:1;min-width:0; }
.pdf-progress-title,.pdf-progress-message,.pdf-progress-bytes { display:block; }
.pdf-progress-title { font-size:14px;font-weight:700; }
.pdf-progress-message { margin-top:3px;color:#66708a;font-size:13px;line-height:1.45;overflow-wrap:anywhere; }
.has-error .pdf-progress-message { color:#865f1e; }
.pdf-progress-track { width:100%;height:6px;margin-top:12px;overflow:hidden;border-radius:999px;background:#e9e5f8; }
.pdf-progress-fill { height:100%;border-radius:999px;background:#7357e8; }
.pdf-progress-bytes { margin-top:7px;color:#66708a;font-size:12px;line-height:1.4; }
.pdf-progress-actions { display:flex;flex-wrap:wrap;gap:8px;margin-top:10px; }
.pdf-progress-action { width:auto;min-width:64px;min-height:44px;margin:0;padding:8px 12px;border-radius:10px;font-size:13px;line-height:1.3; }
.pdf-progress-action::after { border:0; }
.pdf-progress-toggle { flex:0 0 auto;color:#5638c3;background:transparent; }
.pdf-progress-cancel { color:#72522a;background:#f4eee5; }
.pdf-progress-retry { color:#fff;background:#7357e8; }
.is-collapsed { padding-top:8px;padding-bottom:8px; }
@media (prefers-reduced-motion: reduce) { .pdf-progress-fill { transition:none; } }
