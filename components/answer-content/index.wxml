<view class="native-answer {{academic ? 'academic-answer' : ''}} {{compact ? 'compact-answer' : ''}}">
<block wx:if="{{academic}}">
<view wx:for="{{sections}}" wx:for-item="section" wx:key="id" class="answer-section section-{{section.kind}}">
<view wx:if="{{section.title}}" class="answer-section-title" role="heading">{{section.title}}</view>
<view wx:for="{{section.blocks}}" wx:for-item="block" wx:key="id" class="answer-block block-{{block.kind}}">
<scroll-view wx:if="{{block.kind === 'formula' || block.kind === 'table'}}" class="answer-formula-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{true}}" aria-label="公式或表格，内容较宽时可左右滑动">
<view class="answer-formula-content">
<rich-text nodes="{{block.nodes}}" user-select="{{true}}" />
</view>
</scroll-view>
<view wx:elif="{{block.kind === 'step'}}" class="answer-step">
<text class="answer-step-marker">{{block.marker}}</text>
<rich-text class="answer-step-content" nodes="{{block.nodes}}" user-select="{{true}}" />
</view>
<rich-text wx:else nodes="{{block.nodes}}" user-select="{{true}}" />
</view>
</view>
<text wx:if="{{truncated}}" class="answer-truncated">回答较长，当前页面仅显示前面的主要内容。</text>
</block>
<rich-text wx:else nodes="{{nodes}}" user-select="{{true}}"/>
<view wx:if="{{!academic && !compact || links.length}}" class="answer-links">
<button wx:for="{{links}}" wx:key="id" class="secondary" data-index="{{index}}" bindtap="openLink">{{item.label}}</button>
</view>
<text wx:if="{{error}}" class="error">{{error}}</text>
</view>
