<view wx:if="{{compact}}" class="workspace-header-compact">
  <button wx:if="{{actionText}}" class="workspace-header-back" aria-label="{{actionText}}" bindtap="onAction">‹</button><text class="workspace-header-compact-title">{{title}}</text>
</view>
<view wx:else class="workspace-header">
  <view class="header-top">
    <button wx:if="{{actionText}}" class="workspace-header-action" bindtap="onAction">{{actionText}}</button>
    <text wx:else class="header-brand">STEMist</text>
  </view>
  <view class="workspace-header-copy">
    <view wx:if="{{title}}" class="workspace-header-title">{{title}}</view>
    <view wx:if="{{subtitle}}" class="workspace-header-subtitle">{{subtitle}}</view>
  </view>
</view>
