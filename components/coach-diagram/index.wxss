:host{display:block;min-width:0}.figure{margin:12px 0;border:1px solid #e4e7f0;border-radius:12px;padding:12px;background:#fff;overflow:hidden}.title{font-size:15px;color:#18213d;font-weight:600;margin-bottom:8px}.canvas{display:block;width:100%}.caption,.error{display:block;margin-top:8px;color:#66708a;font-size:13px;line-height:1.6;overflow-wrap:anywhere}.error{color:#9b2944}.zoom{min-height:44px;margin:8px 0 0;padding:8px 12px;background:#f5f2ff;color:#5638c3;border:0;font-size:13px;line-height:1.6}.zoom::after{border:0}
