:host{display:block;width:100%}.consent-panel{box-sizing:border-box;width:100%;padding:16px;border:1px solid #e4e7f0;border-radius:16px;background:#fff;color:#18213d}.consent-title{display:block;font-size:18px;font-weight:700}.consent-purpose{display:block;margin-top:8px;font-size:14px;line-height:1.6;color:#66708a}.consent-check{display:flex;align-items:center;gap:8px;min-height:48px;margin-top:12px;font-size:15px;line-height:1.5}.consent-check checkbox{flex-shrink:0}.consent-link,.consent-submit{box-sizing:border-box;width:100%;min-height:48px;margin:8px 0 0;padding:12px;font-size:15px;line-height:1.5;border-radius:12px;white-space:normal}.consent-link{color:#5638c3;background:#f5f3ff}.consent-submit{color:#fff;background:#5638c3}.consent-submit[disabled]{color:#66708a;background:#e9eaf1}.consent-link::after,.consent-submit::after{border:0}.consent-error{display:block;margin-top:12px;color:#963334;font-size:14px;line-height:1.5}
.consent-panel .consent-link,.consent-panel .consent-submit{width:100%;min-width:0;margin-left:0;margin-right:0}.consent-panel .consent-submit[disabled]{opacity:1;color:#66708a;background:#e9eaf1}
