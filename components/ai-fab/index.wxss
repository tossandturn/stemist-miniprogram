.ai-fab { position: fixed; z-index: 60; top: calc(18rpx + env(safe-area-inset-top)); right: 24rpx; display: flex; align-items: center; min-width: 178rpx; min-height: 82rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid rgba(255, 255, 255, .7); border-radius: 42rpx; color: #fff; background: linear-gradient(135deg, #8065ec, #6747d8); box-shadow: 0 14rpx 30rpx rgba(74, 48, 174, .28); font-size: 22rpx; font-weight: 800; }
.ai-fab::after { border: 0; }
.ai-fab-icon { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; margin-right: 10rpx; border: 2rpx solid rgba(255, 255, 255, .9); border-radius: 50%; }
.ai-fab-cross { position: relative; width: 20rpx; height: 20rpx; }
.ai-fab-cross::before, .ai-fab-cross::after { position: absolute; left: 9rpx; top: 0; width: 2rpx; height: 20rpx; border-radius: 2rpx; background: currentColor; content: ''; }
.ai-fab-cross::after { transform: rotate(90deg); }
.ai-fab:active { opacity: .82; }
.ai-fab-inline { position: static; min-width: 148rpx; min-height: 64rpx; padding: 0 14rpx; border-radius: 32rpx; font-size: 21rpx; box-shadow: 0 8rpx 18rpx rgba(74, 48, 174, .2); }
.ai-fab-inline .ai-fab-icon { width: 30rpx; height: 30rpx; margin-right: 7rpx; }
.ai-fab-inline .ai-fab-cross { width: 16rpx; height: 16rpx; }
.ai-fab-inline .ai-fab-cross::before, .ai-fab-inline .ai-fab-cross::after { left: 7rpx; width: 2rpx; height: 16rpx; }
@media (max-width: 374px) {
  .ai-fab { right: 16rpx; min-width: 142rpx; padding: 0 12rpx; font-size: 20rpx; }
  .ai-fab-icon { width: 32rpx; height: 32rpx; margin-right: 7rpx; }
}
@media (min-width: 768px) {
  .ai-fab { top: 16px; right: 34px; min-width: 132px; min-height: 48px; padding: 0 16px; border-radius: 24px; font-size: 14px; }
  .ai-fab-icon { width: 26px; height: 26px; margin-right: 8px; }
  .ai-fab-cross { width: 14px; height: 14px; }
  .ai-fab-cross::before, .ai-fab-cross::after { left: 6px; width: 2px; height: 14px; }
  .ai-fab-inline { min-width: 112px; min-height: 44px; padding: 0 14px; border-radius: 22px; font-size: 13px; }
  .ai-fab-inline .ai-fab-icon { width: 24px; height: 24px; }
  .ai-fab-inline .ai-fab-cross { width: 12px; height: 12px; }
  .ai-fab-inline .ai-fab-cross::before, .ai-fab-inline .ai-fab-cross::after { left: 5px; width: 2px; height: 12px; }
}
