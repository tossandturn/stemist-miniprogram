<view wx:if="{{isTablet}}" class="app-nav app-nav-tablet" aria-label="Primary navigation">
  <navigator class="app-nav-item {{active === 'today' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="/pages/index/index" aria-label="Today"><view class="nav-glyph nav-glyph-today" aria-hidden="true"></view><text>首页</text></navigator>
  <navigator class="app-nav-item {{active === 'practice' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="{{category === 'competition' ? '/pages/papers/index?category=competition' : '/pages/practice/index?category=' + (category || 'alevel')}}" aria-label="Practice"><view class="nav-glyph nav-glyph-practice" aria-hidden="true"></view><text>学习</text></navigator>
  <navigator class="app-nav-item {{active === 'coach' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="/pages/coach/index?source={{source || category || 'home'}}&amp;category={{category}}&amp;routeId={{routeId}}&amp;stage={{stage}}&amp;subjectCode={{subjectCode}}&amp;family={{family}}" aria-label="AI Coach"><view class="nav-glyph nav-glyph-coach" aria-hidden="true"></view><text>AI Coach</text></navigator>
  <navigator class="app-nav-item {{active === 'progress' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="/pages/progress/index" aria-label="Progress"><view class="nav-glyph nav-glyph-progress" aria-hidden="true"></view><text>记录</text></navigator>
  <navigator class="app-nav-item {{active === 'account' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="/pages/account/auth" aria-label="Account"><view class="nav-glyph nav-glyph-account" aria-hidden="true"></view><text>我的</text></navigator>
</view>

<view wx:else class="app-nav app-nav-phone" aria-label="Primary navigation">
  <navigator class="app-nav-item {{active === 'today' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="/pages/index/index" aria-label="Today"><view class="nav-glyph nav-glyph-today" aria-hidden="true"></view><text>首页</text></navigator>
  <navigator class="app-nav-item {{active === 'practice' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="{{category === 'competition' ? '/pages/papers/index?category=competition' : '/pages/practice/index?category=' + (category || 'alevel')}}" aria-label="Practice"><view class="nav-glyph nav-glyph-practice" aria-hidden="true"></view><text>学习</text></navigator>
  <navigator class="app-nav-item {{active === 'coach' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="/pages/coach/index?source={{source || category || 'home'}}&amp;category={{category}}&amp;routeId={{routeId}}&amp;stage={{stage}}&amp;subjectCode={{subjectCode}}&amp;family={{family}}" aria-label="AI Coach"><view class="nav-glyph nav-glyph-coach" aria-hidden="true"></view><text>AI Coach</text></navigator>
  <navigator class="app-nav-item {{active === 'progress' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="/pages/progress/index" aria-label="Progress"><view class="nav-glyph nav-glyph-progress" aria-hidden="true"></view><text>记录</text></navigator>
  <navigator class="app-nav-item {{active === 'account' ? 'active' : ''}}" hover-class="nav-hover" hover-stay-time="100" open-type="redirect" url="/pages/account/auth" aria-label="Account"><view class="nav-glyph nav-glyph-account" aria-hidden="true"></view><text>我的</text></navigator>
</view>
<ai-fab wx:if="{{showAi}}" source="{{source || active}}" route-id="{{routeId}}" stage="{{stage}}" subject-code="{{subjectCode}}" category="{{category}}" family="{{family}}" />
