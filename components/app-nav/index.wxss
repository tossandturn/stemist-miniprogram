:host { display: block; }
.app-nav { display: flex; color: #66708a; background: #fff; }
.app-nav-item { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; min-height: 48px; color: inherit; font-size: 13px; font-weight: 600; text-decoration: none; }
.app-nav-item.active { color: #6142c3; background: #f2effc; border-radius: 10px; }
.nav-hover { opacity: .7; }
.nav-glyph { display: none; }
.app-nav-phone { position: fixed; z-index: 50; left: 0; right: 0; bottom: 0; min-height: 64px; padding: 8px 10px calc(8px + env(safe-area-inset-bottom)); border-top: 1px solid #e7eaf2; }
.app-nav-tablet { padding: 6px; margin: 0 0 24px; border: 1px solid #e4e7f0; border-radius: 14px; }
.app-nav-tablet .app-nav-item { min-height: 48px; font-size: 14px; }
