.coach-panel { margin-top: 18rpx; padding: 24rpx; border: 1rpx solid #e4e7f0; border-radius: 18rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(42, 31, 89, .07); }
.coach-panel-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.ai-orb { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin-right: 14rpx; border-radius: 20rpx; color: #fff; background: #7357e8; font-size: 34rpx; }
.coach-title { color: #18213d; font-size: 30rpx; font-weight: 800; }
.coach-status { margin-top: 4rpx; color: #66708a; font-size: 21rpx; }
.coach-panel textarea { width: 100%; min-height: 210rpx; padding: 20rpx; border: 1rpx solid #dfe4ef; border-radius: 14rpx; color: #18213d; background: #fff; font-size: 27rpx; line-height: 1.55; }
.coach-panel .primary { margin-top: 16rpx; }
.coach-helper { margin-top: 14rpx; color: #66708a; font-size: 21rpx; line-height: 1.45; }
.coach-panel .warning { margin-top: 14rpx; padding: 14rpx 16rpx; border-radius: 12rpx; color: #8a5b18; background: #fff6e8; font-size: 21rpx; line-height: 1.45; }
.coach-panel .error { margin-top: 14rpx; padding: 14rpx 16rpx; border-radius: 12rpx; color: #b33b55; background: #fff0f2; font-size: 21rpx; line-height: 1.45; }
.coach-panel .retry-button { margin-top: 12rpx; }
.coach-panel .account-recovery { margin-top: 12rpx; }
.coach-panel .result { margin-top: 18rpx; padding: 22rpx; border: 1rpx solid #dceee7; border-radius: 14rpx; color: #18213d; background: #fff; white-space: pre-wrap; font-size: 26rpx; line-height: 1.6; }
.coach-progress{margin:12px 0;padding:12px;border-radius:12px;background:#f5f2ff}.coach-progress-steps,.coach-progress-meta{display:flex;justify-content:space-between;gap:8px;font-size:12px;color:#66708a}.coach-progress-steps .active,.coach-progress-steps .done{color:#5638c3;font-weight:700}.coach-progress-track{height:6px;margin:10px 0;border-radius:6px;background:#e4ddf7;overflow:hidden}.coach-progress-pulse{width:35%;height:100%;background:#7357e8;animation:coach-pulse 1.4s ease-in-out infinite}.coach-progress-meta{flex-wrap:wrap}@keyframes coach-pulse{from{transform:translateX(-100%)}to{transform:translateX(290%)}}@media(prefers-reduced-motion:reduce){.coach-progress-pulse{animation:none;width:100%;opacity:.5}}
@media (min-width: 768px) {
  .coach-panel { padding: 20px; border-radius: 12px; }
  .coach-panel-head { margin-bottom: 12px; }
  .coach-title { font-size: 20px; }
  .coach-status { font-size: 13px; }
  .coach-panel textarea { min-height: 240px; padding: 16px; font-size: 16px; }
  .coach-panel .primary { min-height: 48px; margin-top: 14px; font-size: 16px; }
  .coach-helper { font-size: 13px; }
}
