:host{display:block;min-width:0}
.coach-panel{box-sizing:border-box;min-width:0;margin-top:16px;padding:16px;border:1px solid #e4e7f0;border-radius:18px;background:#fff;box-shadow:0 6px 20px rgba(42,31,89,.035)}
.coach-panel-head{display:flex;align-items:center;gap:10px;min-width:0;margin-bottom:12px}
.ai-orb{display:flex;align-items:center;justify-content:center;flex:0 0 40px;width:40px;height:40px;margin-right:0;border-radius:13px;background:#f0ebff}
.coach-avatar-art{display:block;width:34px;height:34px}
.coach-title{color:#18213d;font-size:18px;font-weight:750;line-height:1.35}
.coach-status{margin-top:3px;color:#66708a;font-size:12px;line-height:1.45;overflow-wrap:anywhere}
.coach-help-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;min-width:0;margin:12px 0}
.coach-panel .coach-help-actions button{box-sizing:border-box;width:100%;min-width:0;max-width:100%;min-height:44px;margin:0;padding:10px 5px;border:1px solid #e0dbea;border-radius:10px;color:#5c6277;background:#f8f8fc;font-size:13px;font-weight:600;line-height:1.35;white-space:normal;overflow-wrap:anywhere}
.coach-help-actions button.active{border-color:#8d73dd;color:#5638b8;background:#f0ebff}
.coach-help-actions button[disabled]{opacity:.5}
.coach-input-label{margin:12px 0 7px;color:#66708a;font-size:12px;line-height:1.5}
.coach-panel textarea{box-sizing:border-box;width:100%;max-width:100%;height:112px;min-height:112px;padding:12px;border:1px solid #dfe4ef;border-radius:12px;color:#18213d;background:#fafbfe;font-size:16px;line-height:1.55}
.coach-panel button.primary{box-sizing:border-box;width:100%;max-width:100%;min-width:0;min-height:48px;margin-top:12px;font-size:15px;border-radius:12px}
.coach-panel button.primary[disabled]{opacity:1;color:#75668f;background:#eae5f5}
.coach-solution-disabled{margin:0 0 12px;color:#80531a;font-size:12px;line-height:1.5}
.coach-helper{margin-top:12px;color:#66708a;font-size:12px;line-height:1.5}
.coach-source-offer{margin-top:18px;padding-top:16px;border-top:1px solid #e4e7f0;color:#18213d;font-size:15px;line-height:1.6;overflow-wrap:anywhere}
.coach-source-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.coach-source-actions button{box-sizing:border-box;flex:1 1 110px;min-width:0;min-height:44px;margin:0;padding:10px 12px;border:1px solid #e0dbea;border-radius:10px;color:#5638c3;background:#f0ebff;font-size:14px;line-height:1.6;white-space:normal}
.coach-source-actions button.source-decline{color:#66708a;background:#fff}
.coach-source-note{color:#66708a;font-size:13px}
.coach-panel .warning,.coach-panel .error{margin-top:12px;padding:12px;border-radius:10px;font-size:13px;line-height:1.55;overflow-wrap:anywhere}
.coach-panel .warning{color:#80531a;background:#fff6e8}
.coach-panel .error{color:#a22e48;background:#fff0f2}
.coach-panel .retry-button,.coach-panel .account-recovery{margin-top:10px}
.coach-panel .result{margin-top:18px;padding:16px 0 0;border:0;border-top:1px solid #e7eaf1;border-radius:0;color:#18213d;background:#fff;white-space:normal;font-size:16px;line-height:1.75;min-width:0;overflow-wrap:anywhere}
.coach-progress{margin:12px 0;padding:12px;border-radius:12px;background:#f5f2ff}
.coach-progress-steps,.coach-progress-meta{display:flex;justify-content:space-between;gap:8px;font-size:12px;color:#66708a}
.coach-progress-steps .active,.coach-progress-steps .done{color:#5638c3;font-weight:700}
.coach-progress-track{height:6px;margin:10px 0;border-radius:6px;background:#e4ddf7;overflow:hidden}
.coach-progress-pulse{width:35%;height:100%;background:#7357e8;animation:coach-pulse 1.4s ease-in-out infinite}
.coach-progress-fill{height:100%;background:#7357e8;min-width:0;max-width:100%}
.coach-upload-pause{min-height:44px;margin-top:10px;font-size:14px}
.coach-progress-meta{flex-wrap:wrap}
.coach-panel.compact-panel{margin-top:0;padding:16px;border-radius:16px;box-shadow:none}
.compact-panel .coach-help-actions{margin:0 0 8px;gap:8px}
.compact-panel .coach-help-actions button{border:0;background:#f5f6fa;border-radius:9px;padding:10px 4px;font-weight:500}
.compact-panel .coach-help-actions button.active{color:#5638c3;background:#eee8ff;font-weight:650}
.compact-panel .coach-input-label{margin:8px 0;color:#18213d;font-size:13px;font-weight:500}
.compact-panel textarea{height:96px;min-height:96px;padding:10px 12px;border-color:#e4e7f0;background:#fafbfe}
.compact-panel .coach-task-choice{padding:6px 0;align-items:center;font-size:13px}
.compact-panel button.primary{margin-top:12px;min-height:48px;font-size:15px}
.compact-panel .coach-progress{margin:10px 0;padding:12px;background:#f8f6fd;border:1px solid #eee9f7}
.coach-progress-heading{margin-bottom:10px;font-size:14px;font-weight:600;color:#5638c3}
.compact-panel .result{margin-top:20px;padding-top:20px;border-top:1px solid #e4e7f0}
.coach-task-choice{display:flex;align-items:flex-start;gap:8px;min-height:44px;padding:10px 0;color:#18213d;font-size:14px;line-height:1.55}
.coach-task-choice checkbox{flex-shrink:0;margin-top:1px}.coach-task-choice text,.coach-task-note{display:block;margin-top:5px;color:#66708a;font-size:12px;line-height:1.6;overflow-wrap:anywhere}
.coach-task-link{min-height:44px;margin:12px 0;font-size:14px;white-space:normal}
.coach-progress-steps text{flex:1;min-width:0;line-height:1.5}.coach-progress-steps .error{color:#a22e48}
@keyframes coach-pulse{from{transform:translateX(-100%)}to{transform:translateX(290%)}}
@media(prefers-reduced-motion:reduce){.coach-progress-pulse{animation:none;width:100%;opacity:.5}}
@media(min-width:900px){.coach-panel{padding:20px}.coach-panel textarea{height:150px;min-height:150px}}
@media(max-width:375px){.coach-panel{padding:14px}.coach-help-actions{gap:6px}}
