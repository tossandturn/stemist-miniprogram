<view class="coach-panel panel"><view class="coach-panel-head"><view class="ai-orb" aria-hidden="true"><image class="coach-avatar-art" src="/components/coach-panel/coach-spark.svg" mode="aspectFit" /></view><view><view class="coach-title">AI Coach</view><view wx:if="{{loading || status}}" class="coach-status">{{loading ? (progress.label || '正在分析…') : status}}</view></view></view><view wx:if="{{showHelpActions}}" class="coach-help-actions" role="group" aria-label="选择 AI Coach 帮助方式"><button class="coach-help-choice {{helpIntent === 'hint' ? 'active' : ''}}" data-intent="hint" bindtap="onIntent" disabled="{{loading || readOnly}}" aria-label="只给提示">给我提示</button><button class="coach-help-choice {{helpIntent === 'worked-solution' ? 'active' : ''}}" data-intent="worked-solution" bindtap="onIntent" disabled="{{loading || readOnly || solutionDisabled}}" aria-label="给出完整解答">完整解答</button><button class="coach-help-choice {{helpIntent === 'check-work' ? 'active' : ''}}" data-intent="check-work" bindtap="onIntent" disabled="{{loading || readOnly}}" aria-label="检查我的作答">检查作答</button></view><coach-effort wx:if="{{academic && !readOnly}}" effort="{{reasoningEffort}}" locked="{{canRetry}}" disabled="{{loading || readOnly}}" bind:change="onEffort" /><view wx:if="{{showHelpActions && solutionDisabled}}" class="coach-solution-disabled" role="status">计时考试中不可查看完整解答。</view><view wx:if="{{loading && progress.active !== false}}" class="coach-progress" role="status" aria-label="{{progress.label || '等待 AI 返回'}}"><view class="coach-progress-steps"><text class="{{progress.phase === 'calling' || progress.phase === 'preparing' ? 'active' : 'done'}}">连接 AI</text><text class="{{progress.phase === 'analysis' ? 'active' : progress.phase === 'arranging' ? 'done' : ''}}">分析</text><text class="{{progress.phase === 'arranging' ? 'active' : ''}}">整理答案</text></view><view class="coach-progress-track"><view class="coach-progress-pulse"></view></view><view class="coach-progress-meta"><text>{{progress.elapsedLabel || '正在连接…'}}</text><text>{{progress.etaLabel || '预计时间估算中'}}</text></view></view><view wx:if="{{!hideInput && !readOnly}}" class="coach-input-label">补充说明</view><textarea class="coach-message-input" aria-label="{{placeholder}}" wx:if="{{!hideInput}}" value="{{message}}" disabled="{{readOnly || loading}}" maxlength="{{maxLength}}" cursor-spacing="24" adjust-position="true" show-confirm-bar="true" placeholder="{{placeholder}}" bindinput="onInput" /><button data-testid="coach-submit" class="primary" bindtap="onSubmit" loading="{{loading}}" disabled="{{disabled || loading}}">{{loading ? (progress.phase === 'complete' ? '正在保存记录…' : (progress.label || 'AI 正在分析…')) : submitLabel}}</button><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{authRequired}}" class="secondary account-recovery" bindtap="onAccount" disabled="{{loading}}">登录 / 注册后重试</button><button wx:if="{{canRetry}}" class="secondary retry-button" bindtap="onRetry" disabled="{{loading}}">重试 AI</button><view wx:if="{{warning && academic}}" class="warning">{{warning}}</view><view wx:if="{{answer}}" class="result"><answer-content text="{{answer}}" academic="{{academic}}" modular="{{academic}}"/></view><view wx:if="{{academic && sourceAction && answer && !loading}}" class="coach-source-offer"><view wx:if="{{sourceAction.status === 'offer'}}">是否识别这是哪一年的真题？</view><view wx:if="{{sourceAction.status === 'loading'}}" class="coach-source-note" role="status">正在识别题目出处，答案可继续阅读…</view><view wx:if="{{sourceAction.error}}" class="coach-source-note" role="status">{{sourceAction.error}}</view><answer-content wx:if="{{sourceAction.status === 'done'}}" text="{{sourceAction.text}}" academic="{{true}}" modular="{{true}}"/><view wx:if="{{sourceAction.status !== 'done'}}" class="coach-source-actions"><button bindtap="onSource" loading="{{sourceAction.status === 'loading'}}" disabled="{{sourceAction.status === 'loading'}}">{{sourceAction.status === 'error' ? '重试识别' : '识别出处'}}</button><button class="source-decline" bindtap="onSourceDismiss">暂不识别</button></view></view><view wx:if="{{warning && !academic}}" class="warning">{{warning}}</view><view wx:if="{{helper}}" class="coach-helper">{{helper}}</view></view>
