page { background: #f5f6fa; color: #18213d; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 15px; line-height: 1.5; }
view, text, button, input, textarea, picker, navigator { box-sizing: border-box; }
button { width: auto; min-width: 0; min-height: 44px; margin: 0; padding: 10px 16px; border-radius: 12px; font-size: 15px; line-height: 1.5; font-weight: 600; }
button::after { border: 0; }
button[disabled] { opacity: .5; }
.page { min-height: 100vh; padding: 20px 16px calc(96px + env(safe-area-inset-bottom)); }
.page.device-phone { max-width: none; margin: 0; padding: 20px 16px calc(96px + env(safe-area-inset-bottom)); }
.page.device-tablet { max-width: 1200px; margin: 0 auto; padding: 28px 40px calc(40px + env(safe-area-inset-bottom)); }
.page.device-tablet.portrait { padding-left: 24px; padding-right: 24px; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; margin-right: 10px; border-radius: 10px; background: #7254df; color: #fff; font-size: 21px; font-weight: 750; }
.brand-title { font-size: 20px; font-weight: 750; }
.eyebrow, .section-kicker { color: #66708a; font-size: 12px; font-weight: 600; }
.title { color: #18213d; font-size: 28px; font-weight: 750; line-height: 1.3; }
.title-line { display: block; }
.subtitle, .card-detail, .context-card-text { color: #66708a; font-size: 14px; line-height: 1.6; }
.subtitle { margin-top: 12px; }
.section-title { margin: 28px 0 14px; color: #18213d; font-size: 18px; font-weight: 700; }
.card, .panel { margin-top: 16px; padding: 20px; border: 1px solid #e4e7f0; border-radius: 16px; background: #fff; }
.card-title { color: #18213d; font-size: 18px; font-weight: 700; line-height: 1.4; }
.card-detail { margin-top: 8px; }
.primary, .secondary { display: flex; justify-content: center; align-items: center; width: 100%; min-height: 46px; margin-top: 16px; padding: 12px 16px; }
.primary { color: #fff; background: #6848d7; }
.primary:active { background: #5536c3; }
.secondary { color: #5638b8; border: 1px solid #e1d9fa; background: #f0ecfb; }
button.primary, button.secondary { width: 100%; min-width: 0; }
.page button.primary, .page button.secondary { width: 100%; min-width: 0; }
.page button.text-button { width: auto; min-width: 0; }
.text-button { display: flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 10px; padding: 8px 12px; color: #6142c3; background: transparent; font-size: 14px; }
.field-label, .route-label { display: block; margin: 20px 0 8px; color: #485370; font-size: 14px; font-weight: 600; }
textarea, .input { width: 100%; padding: 14px; border: 1px solid #dfe4ef; border-radius: 12px; background: #fff; color: #18213d; font-size: 16px; line-height: 1.6; }
textarea { min-height: 220px; }
.input { min-height: 46px; }
.error, .warning, .notice { margin-top: 14px; padding: 14px; border-radius: 12px; font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
.error { color: #a22e48; background: #fff0f2; }
.warning { color: #80531a; background: #fff6e8; }
.notice { color: #66708a; background: #eef0f8; }
.result { margin-top: 18px; padding: 18px; border: 1px solid #e3e8ef; border-radius: 14px; color: #18213d; background: #fff; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 15px; line-height: 1.8; }
.status-line, .char-count { display: block; margin-top: 10px; color: #66708a; font-size: 12px; }
.context-card { margin-top: 16px; padding: 18px; border: 1px solid #e4e7f0; border-radius: 14px; background: #fff; }
.context-card-title { color: #18213d; font-size: 16px; font-weight: 700; }
.context-card-text { margin-top: 8px; }
.workspace-grid { display: block; }
.page.device-phone .workspace-grid { display: block; }
.page.device-tablet .workspace-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 24px; align-items: start; }
.page.device-tablet.portrait .workspace-grid { display: block; }
.workspace-grid > view, .workspace-grid > text-practice, .workspace-grid > coach-panel { min-width: 0; }
.page.device-tablet .workspace-grid > .panel { margin-top: 16px; }
.metric-grid { display: flex; flex-wrap: wrap; margin: -6px; }
.metric { width: calc(50% - 12px); min-height: 94px; margin: 6px; padding: 16px; border: 1px solid #e4e7f0; border-radius: 14px; background: #fff; }
.metric-label, .metric-detail { display: block; color: #66708a; font-size: 12px; }
.metric-value { display: block; margin-top: 6px; font-size: 26px; font-weight: 700; }
.metric-detail { margin-top: 6px; }
.empty-state { padding: 32px 16px; color: #66708a; text-align: center; }
.empty-title { margin-bottom: 8px; color: #18213d; font-size: 17px; font-weight: 700; }
.empty-detail { font-size: 14px; }
.camera-card { text-align: center; }
.camera-icon { display: flex; align-items: center; justify-content: center; width: 80px; height: 80px; margin: 0 auto 24px; border-radius: 24px; background: #eeebfc; color: #6d51cf; }
.camera-lens { position: relative; width: 36px; height: 27px; border: 3px solid currentColor; border-radius: 8px; }
.camera-lens::before { position: absolute; left: 9px; top: 5px; width: 12px; height: 12px; border: 2px solid currentColor; border-radius: 50%; content: ''; }
.camera-lens::after { position: absolute; left: 5px; top: -8px; width: 12px; height: 5px; border: 3px solid currentColor; border-bottom: 0; border-radius: 4px 4px 0 0; content: ''; }
.photo-preview { display: block; width: 100%; height: 280px; margin-top: 16px; border-radius: 12px; background: #e9edf5; }
.crop-stage { position: relative; width: 100%; height: 440px; margin-top: 20px; overflow: hidden; border-radius: 16px; background: #161e30; }
.crop-content, .crop-image { width: 100%; height: 100%; }
.crop-box { position: absolute; left: 8%; top: 14%; width: 84%; height: 72%; border: 2px solid #fff; border-radius: 8px; box-shadow: 0 0 0 2000px rgba(0,0,0,.4); pointer-events: none; }
.hidden-canvas { position: fixed; left: -9999px; top: -9999px; opacity: 0; }
.ai-orb { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 38px; height: 38px; margin-right: 12px; border-radius: 12px; background: #eeebfc; color: #6848d7; }
.ai-orb-mark { width: 16px; height: 16px; border: 2px solid currentColor; border-radius: 50%; }
@media (min-width: 768px) { .page.device-tablet .metric { width: calc(25% - 12px); } }
@media (max-width: 767px) { .page.device-phone .workspace-grid { display: block; } }
